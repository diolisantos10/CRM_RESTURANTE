// ─────────────────────────────────────────────────────────────
//  CRM Restaurante – Prisma Schema
//  Phase 2: OrderDraft, OrderDraftItem, FulfillmentType, OrderDraftStatus.
//  Phase 3: EvolutionConfig, Conversation.lastMessageAt/unreadCount,
//           Message.externalMessageId/externalStatus.
//  Phase 4: RestaurantBrandConfig (AI brand voice),
//           AIInteractionLog.toolCalls/turnNumber/estimatedCostUsd.
// ─────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ═══════════════════════════════════════════
//  TENANT – RESTAURANT
// ═══════════════════════════════════════════

model Restaurant {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  phone           String?
  email           String?
  logoUrl         String?
  address         String?
  description     String?
  timezone        String  @default("America/Sao_Paulo")
  isActive        Boolean @default(true)
  // Restaurante de DEMONSTRAÇÃO — vitrine do site de vendas, sandbox de treino.
  // NÃO é cliente: não entra em cobrança, relatório comercial nem métrica de base.
  // É coluna e não convenção de slug de propósito (guardrail 4: código é a trava) —
  // uma regra escrita só no nome do slug some na primeira renomeação.
  // Filtro canônico e a trava de cobrança vivem em src/lib/demo-restaurant.ts.
  isDemo          Boolean @default(false)
  // Master switch do Agente de CRM. false = CRM roda 100% na mão (sem IA).
  crmAgentEnabled Boolean @default(true)
  plan            Plan    @default(STARTER)

  /// A CHAVE DE IDEMPOTÊNCIA do checkout self-service. Preenchida quando este
  /// restaurante nasceu do pagamento de uma PlanSubscription. É UNIQUE de
  /// propósito: o webhook do Mercado Pago reenvia o mesmo evento, e é este índice
  /// — no banco, não no código — que garante que dois webhooks concorrentes não
  /// criem dois restaurantes para a mesma assinatura. O segundo INSERT viola a
  /// restrição e a transação inteira volta atrás, sem deixar nada pela metade.
  /// Não é FK: a direção da posse é PlanSubscription.restaurantId.
  originSubscriptionId String?  @unique
  // Whether the AI Waiter is available on this restaurant's public store.
  // NULL = derive from plan (STARTER → no, GROWTH/PRO → yes). The migration
  // grandfathers every restaurant existing at rollout to TRUE: Sushi Cazza — the
  // live customer — is on STARTER *with* the Waiter running, and a naive
  // plan-only gate would have shut down its AI in production (guardrail 5).
  aiWaiterEnabled      Boolean?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Emergency store pause — overrides business hours
  isOrderingPaused     Boolean   @default(false)
  orderingPausedReason String?
  orderingPausedAt     DateTime?
  orderingPausedUntil  DateTime?
  orderingPausedBy     String?

  // Monotonic per-restaurant counter for human-friendly sequential order numbers.
  // Incremented atomically inside the order-creation transaction.
  lastOrderNumber Int @default(0)

  // Seleção de provedor de WhatsApp (whatsappProvider / fallbackProvider /
  // allowWhatsAppProviderFallback) foi REMOVIDA em 04/08/2026: a Meta Cloud API
  // é o canal único e não há segundo provedor para escolher nem para onde cair.

  users                   User[]
  customers               Customer[]
  menuCategories          MenuCategory[]
  orders                  Order[]
  orderDrafts             OrderDraft[]
  campaigns               Campaign[]
  conversations           Conversation[]
  helpThreads             HelpThread[]
  offers                  Offer[]
  customerSegments        CustomerSegment[]
  aiLogs                  AIInteractionLog[]
  metaWhatsAppConfig      MetaWhatsAppConfig?
  metaMessageTemplates    MetaMessageTemplate[]
  brandConfig             RestaurantBrandConfig?
  agentConfig             WhatsAppAgentConfig?
  deliveryConfig          DeliveryConfig?
  deliveryZones           DeliveryZone[]
  businessHours           BusinessHours[]
  paymentSettings         PaymentSettings?
  storePolicies           StorePolicies?
  storeProfile            StoreProfile?
  integrationConfigs      IntegrationConfig[]
  promotions              Promotion[]
  customerCoupons         CustomerCoupon[]
  crmAutomations          CRMAutomation[]
  crmCustomActions        CRMCustomAction[]
  crmActionLogs           CRMActionLog[]
  crmProfile              RestaurantCRMProfile?
  autoSimulatorConfig     AutoSimulatorConfig?
  simulationRuns          SimulationRun[]
  trackingLinks           TrackingLink[]
  importJobs              ImportJob[]
  importMappingTemplates  ImportMappingTemplate[]
  tierSettings            TierSettings?
  tierBenefits            TierBenefit[]
  onboardingStatus        RestaurantOnboardingStatus?
  productSalesAggregates  ProductSalesAggregate[]
  customerDataSignals     CustomerDataSignal[]
  knowledgeItems          RestaurantKnowledgeItem[]
  orderEditLogs           OrderEditLog[]
  agentProfileOverrides   RestaurantAgentProfileOverride[]
  agencyProjects          AgencyProject[]
  waOrderingSessions      WhatsAppOrderingSession[]
  waTextOrderingConfig    WhatsAppTextOrderingConfig?
  soundSettings           RestaurantSoundSettings?
  printStations           PrintStation[]
  printAgent              PrintAgent?
  printJobs               PrintJob[]
  googleIntegrationConfig GoogleIntegrationConfig?
  apiKeys                 ApiKey[]
  waMenuLinks             WaMenuLink[]
  pricingConfig           RestaurantPricingConfig?
  priceChangeLogs         PriceChangeLog[]
  ingredients             Ingredient[]
  fiscalConfig            FiscalConfig?
  fiscalDocuments         FiscalDocument[]
  planSubscriptions       PlanSubscription[]

  @@map("restaurants")
}

// ═══════════════════════════════════════════
//  EXTERNAL API ACCESS (Integrações → Conexões externas)
// ═══════════════════════════════════════════
//
// A read-only Bearer key the lojista generates so external systems (first
// consumer: Foocci Manager, the finance module) can pull this restaurant's
// sales from GET /api/v1/vendas. Security model:
//   • The plaintext token is shown to the user ONCE at creation; only its
//     SHA-256 hash is stored here — a DB leak never exposes a usable token.
//   • Scoped to a single restaurant (the token itself resolves the tenant, so
//     the external caller never sends a restaurant id).
//   • Revocable (revokedAt) — a revoked key stops authenticating immediately.
//   • tokenPrefix is a short, non-secret fragment ("fck_ab12…") shown in the
//     list so the user can tell keys apart without ever re-revealing the secret.
model ApiKey {
  id              String    @id @default(cuid())
  restaurantId    String
  name            String? // friendly label, e.g. "Foocci Manager"
  tokenHash       String    @unique // SHA-256 hex of the plaintext token
  tokenPrefix     String // non-secret display fragment, e.g. "fck_ab12cd34"
  scope           String    @default("sales:read") // read-only today; room to grow
  lastUsedAt      DateTime? // updated (throttled) on each authenticated call
  createdByUserId String?
  revokedAt       DateTime? // non-null → key no longer authenticates
  createdAt       DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([tokenHash])
  @@map("api_keys")
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

// ═══════════════════════════════════════════
//  USERS
// ═══════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  email        String
  password     String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([email, restaurantId])
  @@index([restaurantId])
  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

// ═══════════════════════════════════════════
//  CUSTOMERS
// ═══════════════════════════════════════════

model Customer {
  id                     String    @id @default(cuid())
  restaurantId           String
  name                   String
  phone                  String? // E.164 format – WhatsApp identifier, or GUEST-{uuid} for anon; null for no-phone imports
  email                  String?
  birthDate              DateTime?
  notes                  String?
  document               String? // CPF or CNPJ
  financialBalance       Decimal?  @db.Decimal(10, 2) // Saldo Financeiro Total
  financialBalancePeriod Decimal?  @db.Decimal(10, 2) // Saldo Financeiro do Período
  importedOrderCount     Int? // Qtd. Pedidos — from external import
  importedTotalSpent     Decimal?  @db.Decimal(10, 2) // Valor Total — from external import
  importedLastOrderAt    DateTime? // Última Compra — from external import
  averageTicket          Decimal?  @db.Decimal(10, 2) // Ticket Médio — from external import
  totalOrders            Int       @default(0)
  totalSpend             Decimal   @default(0) @db.Decimal(10, 2)
  lastOrderAt            DateTime?
  tier                   String    @default("BRONZE") // BRONZE | PRATA | OURO | DIAMANTE
  previousTier           String? // tier before the last level-up (drives "Subiu de nível")
  tierUpAt               DateTime? // when the customer last moved UP a tier
  segment                String    @default("SEM_PEDIDOS") // QUENTE | MORNO | FRIO | SEM_PEDIDOS
  isActive               Boolean   @default(true)
  isGuest                Boolean   @default(false) // true = anonymous session; excluded from CRM lists and metric sync
  hasOptedOut            Boolean   @default(false) // LGPD: customer requested opt-out from marketing messages
  optOutAt               DateTime?
  crmContactable         Boolean   @default(true) // false = no valid phone; excluded from WhatsApp campaigns
  contactStatus          String? // CONTACTABLE | SEM_TELEFONE | TELEFONE_INVALIDO | OPT_OUT | NEEDS_REVIEW
  importExternalId       String? // stable dedup key for re-imports
  sourceSystem           String? // SAIPOS | NEMO | SAIPOS+NEMO | MANUAL
  dataEnrichmentStatus   String? // COMPLETE | PARTIAL | NEEDS_ENRICHMENT | NEEDS_REVIEW
  dataCompletenessScore  Int? // 0–100 computed by CustomerIntelligenceService
  lastEnrichmentAt       DateTime? // last time enrichment data was updated
  enrichmentNotes        String? // free-form notes from CRM agent / human
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  restaurant     Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addresses      Address[]
  orders         Order[]
  orderDrafts    OrderDraft[]
  conversations  Conversation[]
  preferences    CustomerPreference?
  segmentMembers CustomerSegmentMembership[]
  dataSignals    CustomerDataSignal[]
  coupons        CustomerCoupon[]

  @@unique([phone, restaurantId])
  @@index([restaurantId])
  @@index([restaurantId, crmContactable])
  @@map("customers")
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderDrafts OrderDraft[] // drafts referencing this address
  orders      Order[] // orders referencing this address

  @@index([customerId])
  @@map("addresses")
}

model CustomerPreference {
  id           String   @id @default(cuid())
  customerId   String   @unique
  dietary      String[]
  allergies    String[]
  favoriteDish String?
  notes        String?
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_preferences")
}

// ═══════════════════════════════════════════
//  MENU
// ═══════════════════════════════════════════

model MenuCategory {
  id               String     @id @default(cuid())
  restaurantId     String
  name             String
  description      String?
  imageUrl         String?
  // Markup multiplier override for /precificacao (null = use the restaurant's
  // global markup from RestaurantPricingConfig). Sector practice: pratos
  // 2,5–3× · bebidas/sobremesas 4–5×.
  markupOverride   Decimal?   @db.Decimal(6, 3)
  sortOrder        Int        @default(0)
  isActive         Boolean    @default(true)
  isAvailable      Boolean    @default(true) // false = category temporarily unavailable (does not modify item flags)
  showInDelivery   Boolean    @default(true) // false = category hidden from delivery channel
  showInDineIn     Boolean    @default(true) // false = category hidden from QR dine-in menu
  source           MenuSource @default(MANUAL) // tracks whether created manually or via external integration
  printStationKeys String[]   @default([]) // routing: which print station(s) this category's items print at — can be several (same dish in two kitchens)
  // ── Fiscal (NFC-e) — defaults por categoria; item sobrepõe, config global é o fallback ──
  fiscalNcm        String? // NCM (8 díg). Ex.: refeições prontas 21069090
  fiscalCest       String? // CEST (ST), quando aplicável
  fiscalCfop       String? // CFOP da operação (ex.: 5102)
  fiscalCsosn      String? // Simples Nacional (ex.: 102, 500)
  fiscalCst        String? // Regime normal (ICMS)
  fiscalOrigem     String? // origem da mercadoria (0=nacional)
  fiscalUnidade    String? // unidade comercial (ex.: UN)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]
  placements MenuItemPlacement[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id                    String   @id @default(cuid())
  categoryId            String
  name                  String
  description           String?
  ingredients           String? // composition for AI suggestions
  price                 Decimal  @db.Decimal(10, 2) // base/fallback price (used when a channel price is null)
  // ── Channel-based pricing (null = fall back to base `price`) ──────────
  priceDelivery         Decimal? @db.Decimal(10, 2) // price shown/used on the /pedido delivery channel
  priceDineIn           Decimal? @db.Decimal(10, 2) // price shown/used on the /qr salão (dine-in) channel
  priceIfood            Decimal? @db.Decimal(10, 2) // price for iFood (export/admin; integration optional)
  // ── CMV / precificação ────────────────────────────────────────────────
  cost                  Decimal? @db.Decimal(10, 2) // unit cost (CMV por item) — edited on /precificacao; null = not informed yet
  imageUrl              String?
  // Carrossel de fotos (opt-in por item). imageUrl continua sendo a CAPA (thumbnails,
  // cards, WhatsApp/agente, OG, exports). `images` é o conjunto extra mostrado só na
  // ficha do produto quando carouselEnabled = true; ordem do array = ordem do carrossel.
  images                String[] @default([])
  carouselEnabled       Boolean  @default(false)
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  // Availability + channel control
  isAvailable           Boolean  @default(true) // false = temporarily sold out (shown as Indisponível)
  showInDelivery        Boolean  @default(true) // false = hidden from Foocci ordering channel
  showInDineIn          Boolean  @default(true) // false = hidden from QR dine-in menu
  hasVariants           Boolean  @default(false) // true = must select a variant before add-to-cart
  code                  String?
  servingSize           Int? // number of people (1, 2, 3, 4+)
  portionInfo           String? // free-text weight/volume e.g. "300g", "500ml"
  // ── AI enrichment fields ──────────────────────────────────────────
  tagFunil              String? // funnel stage: Entrada | Prato Principal | Bebida | Sobremesa
  perfilPaladar         String? // sensory profile for AI descriptions (umami, cítrico, cremoso…)
  harmonizacaoSugerida  String? // item ID or name to suggest at checkout if category missing from cart
  alergenosDetalhados   String? // comma-separated allergen list (glúten, lactose, frutos do mar…)
  storytellingIA        String? // curated narrative to use when customer asks "what makes it special"
  // ── Saipos POS integration ────────────────────────────────────────────
  saiposIntegrationCode String? // codigo_saipos — PDV code sent as integration_code in Saipos orders
  // ── Fiscal (NFC-e) — override por item; herda da categoria e depois do default global ──
  fiscalNcm             String? // NCM (8 díg)
  fiscalCest            String? // CEST (ST) quando aplicável
  fiscalCfop            String? // CFOP da operação
  fiscalCsosn           String? // Simples Nacional (CSOSN)
  fiscalCst             String? // Regime normal (CST ICMS)
  fiscalOrigem          String? // origem (0=nacional)
  fiscalUnidade         String? // unidade comercial
  fiscalIcmsAliquota    Decimal? @db.Decimal(6, 3) // alíquota ICMS % (regime normal)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category         MenuCategory              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
  orderDraftItems  OrderDraftItem[]
  variants         MenuItemVariant[]
  extras           MenuItemExtra[]
  optionGroups     OptionGroup[]
  placements       MenuItemPlacement[]
  imageEnhancement MenuItemImageEnhancement?
  recipeLines      RecipeLine[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemPlacement {
  id         String @id @default(cuid())
  itemId     String
  categoryId String
  sortOrder  Int    @default(0)

  item     MenuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([itemId, categoryId])
  @@index([categoryId])
  @@map("menu_item_placements")
}

model MenuItemVariant {
  id                    String   @id @default(cuid())
  menuItemId            String
  name                  String // e.g. "350ml", "600ml", "2L"
  // Optional. null = inherit the parent MenuItem's price for the channel/context
  // (priceDelivery/priceDineIn/priceIfood → base). A value here OVERRIDES the product.
  price                 Decimal? @db.Decimal(10, 2) // base/fallback variant price (null = inherit product)
  // ── Channel-based pricing for this variant (null = fall back to `price`) ──
  priceDelivery         Decimal? @db.Decimal(10, 2)
  priceDineIn           Decimal? @db.Decimal(10, 2)
  priceIfood            Decimal? @db.Decimal(10, 2)
  imageUrl              String? // optional per-variant photo; falls back to the product image when null
  portion               String? // e.g. "300g", "500ml"
  isAvailable           Boolean  @default(true)
  sortOrder             Int      @default(0)
  saiposIntegrationCode String? // PDV code for this variant
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_variants")
}

// ═══════════════════════════════════════════
//  CMV & PRECIFICAÇÃO  (página /precificacao)
// ═══════════════════════════════════════════
//
// The lojista registers each item's unit cost (MenuItem.cost) plus the
// restaurant's markup assumptions here. The engine derives the ideal price:
//   markup = 100 / (100 − (fixas% + impostos/taxas% + margem%))
//   ideal  = cost × markup  (then rounded per `rounding`)
// The reprice device reacts to cost/assumption changes according to
// `autoRepriceMode`. Every applied change is audited in PriceChangeLog.

enum AutoRepriceMode {
  OFF // page only shows ideal prices; nothing ever changes on its own
  SUGGEST // change → pending suggestion; lojista applies with 1 click (default)
  AUTO // change → price applied immediately, within maxAutoChangePct guardrail
}

enum PriceRounding {
  NONE // exact value, 2 decimal places
  ENDING_90 // round UP to the next price ending in ,90 (default)
  ENDING_99 // round UP to the next price ending in ,99
}

enum PriceChangeSource {
  MANUAL // price typed directly by the lojista
  APPLIED // lojista applied a suggested price (individual or bulk)
  AUTO // applied by AutoRepriceMode.AUTO after a cost/assumption change
  COST_EDIT // cost updated (price untouched) — kept for a complete audit trail
  RECIPE // cost recomputed from the ingredient ficha (recipe lines)
}

// Catálogo de insumos do restaurante (aba Insumos em /precificacao).
// Seeded automatically from MenuItem.ingredients free text on first visit.
model Ingredient {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  unit         String   @default("un") // un, g, kg, ml, L, fatia, porção…
  costPerUnit  Decimal? @db.Decimal(12, 4) // custo por unidade; null = não informado
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipeLines RecipeLine[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("ingredients")
}

// Ficha técnica: quanto de cada insumo entra em cada produto.
// quantity NULL = link importado do cardápio ainda sem quantidade — não entra
// na conta. Quando TODAS as linhas de um produto têm quantity + costPerUnit,
// o custo do produto passa a ser calculado (source RECIPE) e propaga para o
// dispositivo de reprecificação.
model RecipeLine {
  id           String   @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Decimal? @db.Decimal(12, 4) // na unidade de USO (abaixo)
  unit         String? // unidade de uso no prato; null = usa a unidade de compra do insumo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_lines")
}

model RestaurantPricingConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // Markup assumptions (percentages of the selling price)
  monthlyRevenue       Decimal? @db.Decimal(12, 2) // faturamento médio mensal — converts fixed R$ → %
  fixedExpensesMonthly Decimal? @db.Decimal(12, 2) // despesas fixas mensais (aluguel, equipe, luz…)
  taxesFeesPct         Decimal  @default(0) @db.Decimal(5, 2) // impostos + taxas de cartão/apps
  targetProfitPct      Decimal  @default(0) @db.Decimal(5, 2) // margem de lucro desejada

  // Reprice device
  autoRepriceMode  AutoRepriceMode @default(SUGGEST)
  rounding         PriceRounding   @default(ENDING_90)
  maxAutoChangePct Decimal         @default(15) @db.Decimal(5, 2) // AUTO applies only up to this variation; beyond it stays a suggestion

  // CMV do período (optional gauge: opening stock + purchases − closing stock)
  periodOpeningStock Decimal? @db.Decimal(12, 2)
  periodPurchases    Decimal? @db.Decimal(12, 2)
  periodClosingStock Decimal? @db.Decimal(12, 2)
  periodRevenue      Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_pricing_configs")
}

model PriceChangeLog {
  id              String            @id @default(cuid())
  restaurantId    String
  // Intentionally NOT a FK to MenuItem: the audit trail must survive item
  // deletion. itemName is denormalized for the same reason.
  menuItemId      String
  itemName        String
  oldPrice        Decimal?          @db.Decimal(10, 2)
  newPrice        Decimal?          @db.Decimal(10, 2)
  oldCost         Decimal?          @db.Decimal(10, 2)
  newCost         Decimal?          @db.Decimal(10, 2)
  source          PriceChangeSource
  changedByUserId String?
  createdAt       DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([menuItemId])
  @@map("price_change_logs")
}

// ═══════════════════════════════════════════
//  ORDER DRAFTS  (mutable cart before confirmation)
// ═══════════════════════════════════════════

model OrderDraft {
  id                String           @id @default(cuid())
  restaurantId      String
  customerId        String
  conversationId    String? // nullable – set when draft originates from WhatsApp (Phase 3)
  status            OrderDraftStatus @default(OPEN)
  fulfillmentType   FulfillmentType  @default(DELIVERY)
  deliveryAddressId String? // FK to Address; null for PICKUP/DINE_IN
  subtotal          Decimal          @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal          @default(0) @db.Decimal(10, 2)
  notes             String?
  aiSummary         String? // Phase 3: AI-generated order summary
  confirmedAt       DateTime?
  abandonedAt       DateTime?
  recoveryAttempts  Int              @default(0)
  lastRecoveryAt    DateTime?
  recoveryCode      String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id])
  deliveryAddress Address?         @relation(fields: [deliveryAddressId], references: [id])
  items           OrderDraftItem[]
  order           Order? // populated after confirmation

  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@map("order_drafts")
}

model OrderDraftItem {
  id           String   @id @default(cuid())
  orderDraftId String
  menuItemId   String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2) // snapshot of price at time of add
  isUpsell     Boolean  @default(false) // true if suggested by AI upsell (Phase 3)
  notes        String?
  addedAt      DateTime @default(now())

  orderDraft OrderDraft @relation(fields: [orderDraftId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderDraftId])
  @@map("order_draft_items")
}

enum OrderDraftStatus {
  OPEN
  CONFIRMED
  ABANDONED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

// ═══════════════════════════════════════════
//  ORDERS  (immutable after confirmation)
// ═══════════════════════════════════════════

model Order {
  id                   String      @id @default(cuid())
  restaurantId         String
  customerId           String
  orderNumber          Int? // human-friendly sequential number, unique per restaurant; null for legacy orders
  orderDraftId         String?     @unique // traceability back to originating draft
  status               OrderStatus @default(PENDING)
  type                 OrderType   @default(DELIVERY)
  subtotal             Decimal     @db.Decimal(10, 2)
  deliveryFee          Decimal     @default(0) @db.Decimal(10, 2)
  discount             Decimal     @default(0) @db.Decimal(10, 2)
  total                Decimal     @db.Decimal(10, 2)
  notes                String?
  deliveryAddressId    String? // FK to Address snapshot at order time
  estimatedAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  idempotencyKey       String?     @unique
  crmSyncedAt          DateTime? // set once customer metrics have been counted for this order
  printQueuedAt        DateTime? // set once station print jobs have been enqueued (once-only guard)
  source               String? // pedido | qr | whatsapp | manual | import — origin channel
  importedAt           DateTime? // set for historically imported orders; actual event date
  // ── Marketing / channel attribution ──────────────────────────────────────────
  trackingLinkId       String? // FK to TrackingLink if customer arrived via trackable link
  trafficSource        String? // utm_source / e.g. instagram, whatsapp, qr, google
  trafficMedium        String? // utm_medium / e.g. bio, direct, mesa, embalagem
  trafficCampaign      String? // utm_campaign
  trafficContent       String? // utm_content
  // ── Saipos POS integration fields ────────────────────────────────────
  saiposSentAt         DateTime? // when the order was successfully sent to Saipos
  saiposOrderId        String? // Saipos internal order reference (from their response)
  saiposStatus         String? // latest status received from Saipos webhook
  saiposError          String? // last error message if send failed
  saiposLastErrorCode  String? // error code from last failed attempt (e.g. "902")
  saiposLastAttemptAt  DateTime? // timestamp of last Saipos send attempt
  // ── Coupon / promotion ────────────────────────────────────────────────
  couponCode           String? // code entered by customer at checkout
  promotionId          String? // FK to Promotion that was applied (soft reference — no CASCADE)
  couponUsageCountedAt DateTime? // set once Promotion.usedCount has been incremented for this order
  customerCouponId     String? // wallet coupon (CustomerCoupon) redeemed on this order — marked USED on payment
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id])
  orderDraft      OrderDraft?     @relation(fields: [orderDraftId], references: [id])
  deliveryAddress Address?        @relation(fields: [deliveryAddressId], references: [id])
  items           OrderItem[]
  payment         Payment?
  fiscalDocument  FiscalDocument?
  editLogs        OrderEditLog[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  menuItemId   String?
  name         String // snapshot of name at order time
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  notes        String?
  total        Decimal @db.Decimal(10, 2)
  categoryId   String? // FK snapshot — stays even if category is later deleted
  categoryName String? // name snapshot at order time — stays even if category is renamed
  variantName  String? // selected variant name snapshot if applicable
  addonsJson   Json? // JSON snapshot of selected add-ons / options / customizations
  isUpsell     Boolean @default(false) // true when item was added after a Foocci upsell suggestion

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([categoryId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT // between PENDING and CONFIRMED for pay_now flows
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

// ═══════════════════════════════════════════
//  PAYMENTS
// ═══════════════════════════════════════════

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  // Cash change: the bill/note the customer will hand over ("troco para R$ 100").
  // null = exact change / not a cash order. Change to bring = changeFor - total.
  // Prints on the cashier ticket so the caixa knows before the order arrives.
  changeFor         Decimal?      @db.Decimal(10, 2)
  paidAt            DateTime?
  // Stone / hosted-link fields (all nullable — not used for cash/card-machine flows)
  paymentMode       PaymentMode   @default(PAY_NOW)
  providerName      String? // "stone" | "mercadopago" | "sumup" | null
  providerReference String? // provider payment/checkout id (Stone link, MP payment, SumUp checkout)
  paymentUrl        String? // hosted checkout URL / Pix copy-paste
  expiresAt         DateTime? // Stone link expiry
  // Transparent card (SumUp) result metadata — null for Pix/cash.
  installments      Int? // parcelas (1 = à vista)
  cardBrand         String? // "visa" | "master" | … (for the receipt/ticket)
  cardLast4         String? // last 4 digits (display only)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ═══════════════════════════════════════════
//  WHATSAPP SHORT MENU LINK
// ═══════════════════════════════════════════
// Short redirect code the receptionist sends instead of the long identified
// /pedido URL (a ~180-char signed waToken looked awful in WhatsApp). One stable
// code per (restaurant, customer); /r/[code] signs a fresh waToken on tap and
// 302-redirects to /pedido/[slug]. expiresAt is refreshed on every send.

model WaMenuLink {
  code         String   @id
  restaurantId String
  phone        String
  name         String?
  hits         Int      @default(0)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("wa_menu_links")
}

// ═══════════════════════════════════════════
//  ORDER EDIT LOG  (audit trail for item replacements)
// ═══════════════════════════════════════════

model OrderEditLog {
  id           String  @id @default(cuid())
  orderId      String
  restaurantId String
  userId       String? // staff member who made the change; null = system

  // What changed
  action String @default("ITEM_REPLACED")

  // Previous item snapshot
  previousItemId   String? // OrderItem.id that was removed (informational only)
  previousItemName String
  previousItemQty  Int
  previousItemData Json // { name, price, quantity, variantName, addonsJson, total }

  // New item snapshot
  newItemName String
  newItemQty  Int
  newItemData Json // { name, price, quantity, variantName, addonsJson, total }

  // Financial impact
  previousTotal Decimal @db.Decimal(10, 2) // order total before change
  newTotal      Decimal @db.Decimal(10, 2) // order total after change
  priceDiff     Decimal @db.Decimal(10, 2) // newTotal − previousTotal (positive = to collect)

  // Reason
  reason     String // CLIENTE_PEDIU | PRODUTO_INDISPONIVEL | ERRO_SABOR | ERRO_OPERACIONAL | OUTRO
  reasonNote String?

  // Payment adjustment tracking (staff must resolve manually)
  paymentResolved Boolean @default(false) // staff marked the payment diff as handled

  createdAt DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([restaurantId])
  @@map("order_edit_logs")
}

enum PaymentMode {
  PAY_NOW
  PAY_ON_DELIVERY
  PAY_ON_PICKUP
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  ONLINE
  CARD_MACHINE // physical terminal (pay on delivery/pickup)
  PIX_IN_PERSON // QR code shown at door/counter
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  LINK_SENT // Stone link sent, awaiting payment
  PAY_ON_DELIVERY // collected at delivery
  PAY_ON_PICKUP // collected at counter
  EXPIRED // Stone link expired
}

// ═══════════════════════════════════════════
//  CONVERSATIONS & MESSAGES  (Phase 3)
// ═══════════════════════════════════════════

model Conversation {
  id                String             @id @default(cuid())
  restaurantId      String
  customerId        String?
  channel           Channel            @default(WHATSAPP)
  status            ConversationStatus @default(OPEN)
  aiEnabled         Boolean            @default(true) // false when human has taken over (temporary)
  sessionId         String? // stable browser session ID for web agent tracking
  customerName      String? // denormalized — set for anonymous web sessions
  customerPhone     String? // denormalized — set when customer identifies
  orderId           String?
  orderDraftId      String?
  // ── Persistent non-customer classification + permanent AI lock (P0-A) ──
  // Stronger than `aiEnabled=false`: when aiLocked is true the AI NEVER replies
  // automatically and is NOT re-enabled by any auto-return rule — only an
  // explicit manual unlock can restore AI.
  conversationType  ConversationType   @default(CUSTOMER)
  aiLocked          Boolean            @default(false)
  aiLockedReason    String? // free-text or classification note
  aiLockedAt        DateTime?
  aiLockedByUserId  String? // operator who applied the lock
  assignedTo        String?
  // WhatsApp menu: which configured submenu (top-level option id) the customer is
  // currently viewing; null = top-level menu. Lets numbered selection resolve to
  // the submenu's children instead of the main menu.
  activeSubmenuId   String?
  contextType       String? // INBOUND | CRM_CAMPAIGN | CRM_AUTOMATION | ORDER_SUPPORT | HUMAN_SUPPORT
  relatedCampaignId String? // denormalized Campaign.id — no FK; avoids cascade complexity
  resolvedAt        DateTime?
  // Set when an operator hits "Estou ciente" / "Silenciar" on the human-attention
  // alarm. Persists the acknowledgement server-side so the app-wide GlobalAlertEngine
  // stops ringing for this conversation from EVERY page and EVERY device — not just
  // the tab where Atendimento happens to be open. Cleared on a fresh escalation
  // (markConversationNeedsHuman) so a genuinely new human request rings again.
  handoffAlarmAckAt DateTime?
  lastMessageAt     DateTime? // updated on every new message; used for inbox sort
  unreadCount       Int                @default(0) // denormalized; reset when agent marks read
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id])
  messages   Message[]

  @@index([restaurantId])
  @@index([customerId])
  @@index([restaurantId, status])
  @@index([restaurantId, lastMessageAt])
  @@index([sessionId])
  @@index([customerPhone])
  @@index([channel])
  @@map("conversations")
}

model Message {
  id                String      @id @default(cuid())
  conversationId    String
  direction         Direction   @default(INBOUND)
  senderType        String? // CUSTOMER | AI | HUMAN | SYSTEM
  content           String
  type              MessageType @default(TEXT)
  mediaUrl          String?
  isRead            Boolean     @default(false)
  sentAt            DateTime    @default(now())
  deliveredAt       DateTime?
  readAt            DateTime?
  errorMessage      String?
  metadata          Json?
  // Phase 3: explicit external identifiers for idempotency and status tracking
  externalMessageId String?     @unique // Evolution API / WhatsApp message ID
  externalStatus    String? // sent | delivered | read | failed

  // Dual-provider tracking (additive, nullable). For Evolution rows these stay null
  // and the existing external* fields remain the source of truth; Meta rows populate
  // these so Central de Conversas / diagnostics can tell providers apart.
  provider          String? // EVOLUTION | META_CLOUD_API
  providerMessageId String? // provider-native id (wamid for Meta)
  providerStatus    String? // provider-native delivery status
  providerError     String? // masked provider error

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

enum Channel {
  WHATSAPP
  EMAIL
  SMS
  WEB_AGENT
  QR_AGENT
  MANUAL
  INSTAGRAM_DIRECT
  INSTAGRAM_COMMENT
  MESSENGER
}

enum ConversationStatus {
  OPEN
  BOT
  HUMAN
  RESOLVED
  AI_ATENDENDO
  HUMANO_ASSUMIU
}

// Persistent classification of who is on the other side of a conversation.
// Anything other than CUSTOMER marks a non-customer context where the AI must
// stay silent until an operator manually reclassifies / unlocks it (P0-A).
enum ConversationType {
  CUSTOMER
  STAFF
  SUPPLIER
  PARTNER
  INTERNAL
  OTHER_NON_CUSTOMER
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
}

// ═══════════════════════════════════════════
//  CAMPAIGNS  (Phase 3)
// ═══════════════════════════════════════════

model Campaign {
  id                 String         @id @default(cuid())
  restaurantId       String
  name               String
  message            String
  objective          String? // RECUPERAR | RECOMPRA | TICKET | BEBIDA | SOBREMESA | AVALIACAO | VIP | OUTRO
  channel            String         @default("WHATSAPP")
  targetSegment      String? // FRIO | MORNO | QUENTE | VIP | PRIMEIRO_PEDIDO | RECENTE_AVALIACAO | RECORRENTE_SUMIDO | TODOS | etc.
  templateId         String? // links back to the action template id (e.g. "recuperar-frios")
  segmentId          String?
  scheduledAt        DateTime?
  sentAt             DateTime?
  status             CampaignStatus @default(DRAFT)
  totalAudience      Int            @default(0)
  totalSent          Int            @default(0)
  totalFailed        Int            @default(0)
  totalRead          Int            @default(0)
  totalResponded     Int            @default(0)
  totalConverted     Int            @default(0)
  totalRevenue       Decimal        @default(0) @db.Decimal(12, 2)
  couponCode         String? // soft link to Promotion.couponCode for attribution
  promotionId        String? // soft FK to Promotion.id for attribution (no cascade)
  scheduleConfig     Json? // { mode, ..., dailyLimit?, priority?, allowWeeklyCustomerCapOverride?, overrideReason? }
  audienceConfig     Json? // { templateId?, segment?, filters? }
  // ── Governance / impact-memory identity (additive) ─────────────────────────
  // Stable concept key (e.g. "pascoa-2026") so a deleted/recreated campaign still
  // knows who was already impacted by the CONCEPT, not just by this campaignId.
  campaignFamilyKey  String?
  // Normalized hash of the message — same/near-same text under a NEW campaignId
  // is recognised as a duplicate.
  messageFingerprint String?
  // { dedupeByConcept?, dedupeByMessage?, dedupeWindowDays?, allowResendToImpacted? }
  dedupePolicy       Json?
  lastRunAt          DateTime? // set at the start of each recurring batch; defines cycle boundary
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  segment    CustomerSegment?    @relation(fields: [segmentId], references: [id])
  executions CampaignExecution[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, campaignFamilyKey])
  @@map("campaigns")
}

// CRM Contact Ledger — immutable impact memory. Records who was contacted (or
// blocked/failed), by which campaign + CONCEPT + message fingerprint, and when.
// Intentionally has NO foreign keys: deleting a campaign or customer NEVER erases
// the ledger (it is audit + dedupe memory). Stores no full message text.
model CRMContactLedger {
  id                   String    @id @default(cuid())
  restaurantId         String
  customerId           String?
  phone                String?
  campaignId           String? // soft reference (no FK / no cascade)
  campaignFamilyKey    String?
  messageFingerprint   String?
  channel              String    @default("WHATSAPP")
  contactType          String // CAMPAIGN | AUTOMATION | BIRTHDAY | REACTIVATION | REVIEW_REQUEST | POST_ORDER | MANUAL
  status               String // SENT | BLOCKED | FAILED | SKIPPED
  reasonCode           String? // canonical reason code (see crmReasonCodes)
  usedPriorityOverride Boolean   @default(false)
  sentAt               DateTime?
  blockedAt            DateTime?
  failedAt             DateTime?
  sourceExecutionId    String?
  metadata             Json?
  createdAt            DateTime  @default(now())

  @@index([restaurantId, customerId])
  @@index([restaurantId, campaignFamilyKey, customerId])
  @@index([restaurantId, messageFingerprint, customerId])
  @@index([restaurantId, createdAt])
  @@map("crm_contact_ledger")
}

/// Records a customer leaving the CRM base during auto-cleanup, so the Migração
/// panel can show "how many left for lack of contact" over a period. Written when
/// the runner deletes a dead lead (invalid/unreachable number, no history) or
/// retires a contactable=false customer that still has order history.
/// "Indique um amigo": created when a NEW customer places their first order
/// through a referrer's personal link (?ref=customerId). Both sides are then
/// rewarded with the campaign coupon. A customer can only ever be referred once.
model Referral {
  id                 String   @id @default(cuid())
  restaurantId       String
  referrerCustomerId String // soft reference — who shared the link
  referredCustomerId String   @unique // soft reference — the new customer (once ever)
  orderId            String? // the first order that validated the referral
  createdAt          DateTime @default(now())

  @@index([restaurantId, referrerCustomerId])
  @@index([restaurantId, createdAt])
  @@map("referrals")
}

model CrmBaseExclusion {
  id           String   @id @default(cuid())
  restaurantId String
  customerId   String? // soft reference — the row may have been hard-deleted
  phone        String?
  /// INVALID_PHONE_DELETED | RETIRED_NO_CONTACT — canonical exclusion reason
  reason       String
  /// true = the customer had order history (retired, not deleted)
  hadHistory   Boolean  @default(false)
  /// segment the customer was in at exclusion time (QUENTE|MORNO|FRIO|PERDIDO|SEM_PEDIDOS)
  priorSegment String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@map("crm_base_exclusions")
}

model CampaignExecution {
  id               String          @id @default(cuid())
  campaignId       String
  restaurantId     String? // denormalized for fast tenant-scoped queries
  customerId       String
  customerName     String? // snapshot at campaign creation
  customerPhone    String? // snapshot at campaign creation
  messageText      String?         @db.Text // personalized message for this recipient
  variantKey       String? // fingerprint of the phrase template used (message pool A/B tracking)
  status           ExecutionStatus @default(PENDING)
  sentAt           DateTime?
  readAt           DateTime?
  failedReason     String?
  errorMessage     String?
  converted        Boolean         @default(false)
  convertedAt      DateTime?
  revenue          Decimal?        @db.Decimal(10, 2) // order.total at time of conversion
  convertedOrderId String? // denormalized Order.id — no FK to avoid cascade complexity
  createdAt        DateTime        @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([restaurantId])
  @@map("campaign_executions")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE // recurring campaign is live and within its schedule window
  SENDING
  SENT
  PAUSED // recurring campaign manually paused
  COMPLETED // recurring: audience exhausted or end condition met
  CANCELLED
}

enum ExecutionStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  // A safety BLOCK (weekly cap / cooldown / opt-out / window) is NOT a send
  // failure — it is stored distinctly so the UI never counts it as a "falha".
  BLOCKED
  // Recipient intentionally not attempted (not eligible this run).
  SKIPPED
}

// ═══════════════════════════════════════════
//  CUSTOMER SEGMENTS  (Phase 3)
// ═══════════════════════════════════════════

model CustomerSegment {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  filters      Json
  memberCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  members    CustomerSegmentMembership[]
  campaigns  Campaign[]

  @@index([restaurantId])
  @@map("customer_segments")
}

model CustomerSegmentMembership {
  segmentId  String
  customerId String
  addedAt    DateTime @default(now())

  segment  CustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([segmentId, customerId])
  @@map("customer_segment_memberships")
}

// ═══════════════════════════════════════════
//  OFFERS  (Phase 3)
// ═══════════════════════════════════════════

model Offer {
  id            String    @id @default(cuid())
  restaurantId  String
  title         String
  description   String?
  discount      Decimal   @db.Decimal(5, 2)
  type          OfferType
  code          String?
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("offers")
}

// ═══════════════════════════════════════════
//  IMPORT JOBS

model ProductSalesAggregate {
  id           String   @id @default(cuid())
  restaurantId String
  sourceSystem String   @default("SAIPOS")
  periodStart  DateTime
  periodEnd    DateTime
  categoryName String
  productName  String?
  quantitySold Int      @default(0)
  grossRevenue Decimal  @default(0) @db.Decimal(12, 2)
  percent      Decimal? @db.Decimal(6, 4)
  rowType      String // CATEGORY | PRODUCT
  importKey    String // deduplication fingerprint (unique per restaurant+period+product)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([importKey])
  @@index([restaurantId])
  @@map("product_sales_aggregates")
}

model ImportJob {
  id                String    @id @default(cuid())
  restaurantId      String
  type              String // "customers" | "orders" | "customers_orders"
  filename          String    @default("")
  status            String // "VALIDATING" | "IMPORTING" | "COMPLETED" | "FAILED"
  totalRows         Int       @default(0)
  validRows         Int       @default(0)
  errorRows         Int       @default(0)
  warningRows       Int       @default(0)
  createdCustomers  Int       @default(0)
  updatedCustomers  Int       @default(0)
  createdOrders     Int       @default(0)
  createdItems      Int       @default(0)
  skippedDuplicates Int       @default(0)
  unmatchedProducts Int       @default(0)
  reportJson        Json?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("import_jobs")
}

model ImportMappingTemplate {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sourceSystem String   @default("GENERIC")
  importType   String   @default("customers")
  mappings     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("import_mapping_templates")
}

enum MenuSource {
  MANUAL // created by restaurant staff via the dashboard
  EXTERNAL // imported from a third-party POS or menu integration
}

enum OfferType {
  PERCENTAGE
  FIXED
  FREE_DELIVERY
}

// ═══════════════════════════════════════════
//  AI INTERACTION LOGS  (Phase 3)
// ═══════════════════════════════════════════

model AIInteractionLog {
  id               String   @id @default(cuid())
  restaurantId     String
  conversationId   String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  latencyMs        Int      @default(0)
  success          Boolean  @default(true)
  errorMessage     String?
  // Phase 4 additions
  turnNumber       Int      @default(0) // which conversation turn (for multi-turn audit)
  toolCalls        Json? // array of {name, args, result} for every tool executed
  estimatedCostUsd Decimal? @db.Decimal(10, 6) // null = modelo NÃO precificado (custo indeterminado), nunca preço chutado
  // Qual agente fez a chamada. NULÁVEL: linhas antigas e chamadores que não sabem
  // ficam nulos e aparecem como "não atribuído" — nunca somados ao agente errado.
  agentSlug        String?
  createdAt        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([conversationId])
  @@index([agentSlug])
  @@map("ai_interaction_logs")
}

// ═══════════════════════════════════════════
//  EVOLUTION API CONFIG  (Phase 3)
//  Per-restaurant Evolution API credentials.
//  apiKey and webhookSecret are stored AES-256-GCM encrypted.
//  Plain values are NEVER returned in API responses — only masked.
//
//  Future: RestaurantBrandConfig will sit alongside this model and
//  provide per-tenant AI persona settings (tone, formality, vocabulary,
//  emoji usage, upsell style) consumed by the Phase 4 AI layer.
// ═══════════════════════════════════════════

// ═══════════════════════════════════════════
//  META WHATSAPP CLOUD API CONFIG  (official provider — parallel to Evolution)
//  Stored per restaurant. Connected via Meta Embedded Signup. accessToken is
//  AES-256-GCM encrypted (see lib/crypto). Raw token is NEVER returned to the
//  client — only masked previews. Additive; does not touch EvolutionConfig.
// ═══════════════════════════════════════════

model MetaWhatsAppConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  wabaId             String // WhatsApp Business Account id
  phoneNumberId      String  @unique // Graph API phone_number_id — routes inbound webhooks
  displayPhoneNumber String? // human-readable connected number
  businessId         String? // Meta Business (portfolio) id
  configId           String? // Embedded Signup configuration id (if used)

  accessToken        String // AES-256-GCM encrypted long-lived/system-user token
  tokenExpiresAt     DateTime?
  webhookVerifyToken String // AES-256-GCM encrypted per-restaurant verify token

  connectionStatus  String    @default("PENDING") // PENDING | CONNECTED | ERROR | DISCONNECTED
  lastHealthCheckAt DateTime?
  lastError         String?
  qualityRating     String? // GREEN | YELLOW | RED (when available)
  messagingLimit    String? // TIER_1K | TIER_10K | ... (when available)

  metaCrmEnabled Boolean @default(false) // when true, CRM campaigns route through Meta Cloud API

  // Coexistence: the number is ALSO live on the WhatsApp Business App (phone). Onboarded
  // via Embedded Signup with featureType=whatsapp_business_app_onboarding; it must NEVER
  // be /register-ed (a normal register would evict it from the phone).
  coexistence Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
  @@map("meta_whatsapp_configs")
}

// Analytics of FOOCCI'S OWN commercial site — not a restaurant's.
//
// The Google integration that already existed is per-restaurant (`GoogleIntegrationConfig`,
// keyed by restaurantId): it shows a merchant THEIR GA4 and their Google Business. There
// was nothing at all for foocci.com.br itself, so the day paid campaigns started there
// was no way to measure them.
//
// Read at RUNTIME on purpose. A `NEXT_PUBLIC_*` env var is baked at build time, so
// changing the measurement id would need a fresh deploy — and the person who has the id
// is the CEO, not whoever can trigger a deploy.
//
// Singleton by construction, same as meta_app_credentials.
model SiteSettings {
  id String @id @default("singleton")

  /// GA4 measurement id, e.g. "G-XXXXXXXXXX". Public by nature — it ships to the browser.
  gaMeasurementId        String?
  /// Meta Pixel id. Also public by nature.
  metaPixelId            String?
  /// Google Search Console HTML verification token, when verifying by meta tag.
  googleSiteVerification String?

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_settings")
}

// App-level Meta credentials — the ONE Foocci app inside Meta (`Foocci Whats`), which
// serves WhatsApp AND Instagram at the same time. Until now these lived only as Railway
// env vars, so changing them required a deploy and a person with Railway access.
//
// Singleton by construction: `id` defaults to "singleton" and is the primary key, so a
// second row cannot be created by accident.
//
// Secrets are AES-256-GCM encrypted at rest and NEVER returned by the API — the admin
// screen only ever receives masked previews (`maskSecret`). Env vars remain the fallback:
// a row here overrides them, an empty row changes nothing. That ordering is deliberate —
// it means shipping this model cannot break a working production deploy.
model MetaAppCredentials {
  id String @id @default("singleton")

  // WhatsApp / app-level
  appId               String? // public — not a secret, stored plain
  appSecret           String? // AES-256-GCM encrypted — MASTER KEY, never returned
  configId            String? // Embedded Signup configuration id
  coexistenceConfigId String? // Embedded Signup config for the coexistence flow
  webhookVerifyToken  String? // AES-256-GCM encrypted
  graphVersion        String? // e.g. "v21.0" — falls back to META_GRAPH_VERSION

  // Instagram — same Meta app, separate credential pair
  igAppId              String? // public
  igAppSecret          String? // AES-256-GCM encrypted
  igWebhookVerifyToken String? // AES-256-GCM encrypted

  // Optional system-user token: lets the Director operate the Graph API without
  // borrowing a restaurant's token. Long-lived, high blast radius — encrypted.
  systemUserToken String? // AES-256-GCM encrypted

  // Result of the last "Testar conexão" run, so the screen can show real state
  // instead of a green badge that proves nothing (the Instagram lesson).
  lastTestAt    DateTime?
  lastTestOk    Boolean?
  lastTestError String?

  updatedAt DateTime @updatedAt
  updatedBy String? // who saved last — "admin" for now; audit hook for later

  @@map("meta_app_credentials")
}

// Approved Meta message templates per restaurant. Business-initiated WhatsApp sends
// OUTSIDE the 24h customer-service window must use an APPROVED template; this is the
// minimal registry CRM/automation can resolve a template from. Additive, Meta-only.
model MetaMessageTemplate {
  id           String @id @default(cuid())
  restaurantId String

  templateName       String // Meta-registered name, e.g. "order_update"
  languageCode       String  @default("pt_BR")
  category           String  @default("UTILITY") // UTILITY | MARKETING | AUTHENTICATION
  // PENDING | APPROVED | REJECTED | DISABLED | MISSING
  // MISSING = a Meta não lista mais este modelo na conta que envia hoje (conta
  // trocada, ou modelo apagado lá). NÃO é reprovação — ver MetaTemplateService.
  status             String  @default("PENDING")
  bodyVariables      Int     @default(0) // number of {{n}} placeholders in the body
  mappedCampaignType String? // optional: CRM campaign type this template fulfils
  rejectedReason     String? // Meta's reason when status = REJECTED (shown to the owner)
  metaTemplateId     String? // Meta's template id — enables zero-gap edits of an approved template

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, templateName, languageCode])
  @@index([restaurantId, status])
  @@map("meta_message_templates")
}

// ═══════════════════════════════════════════
//  EVOLUTION WEBHOOK EVENT LOG
//  Diagnostic-only ring buffer for the last webhook events received.
//  Stores no message content — only metadata useful for debugging.
// ═══════════════════════════════════════════

// ═══════════════════════════════════════════
//  GENERIC INTEGRATION CONFIG
//  Stores per-restaurant credentials for external integrations
//  (Stone, Mercado Pago, Tipos, etc.).
//  WhatsApp credentials live in EvolutionConfig above.
//  configBlob is AES-256-GCM encrypted JSON containing all fields.
// ═══════════════════════════════════════════

model IntegrationConfig {
  id           String    @id @default(cuid())
  restaurantId String
  provider     String // "stone" | "mercadopago" | "tipos"
  configBlob   String // AES-256-GCM encrypted JSON
  isActive     Boolean   @default(false)
  lastTestedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, provider])
  @@index([restaurantId])
  @@map("integration_configs")
}

// ═══════════════════════════════════════════
//  GOOGLE INTEGRATION  (Meu Negócio + Analytics GA4)
//  One OAuth connection per restaurant powers both Google Business Profile
//  (Meu Negócio) and Google Analytics (GA4 Data API). Tokens are AES-256-GCM
//  encrypted at rest and NEVER returned to the client — only masked previews
//  and connection status. Login com Google is separate (NextAuth, no tokens here).
// ═══════════════════════════════════════════

model GoogleIntegrationConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  connected Boolean @default(false)

  // OAuth tokens (AES-256-GCM encrypted ciphertext — never plaintext)
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String? // space-separated granted scopes
  googleEmail           String? // connected Google account email (display only)
  googleUserId          String? // Google account sub (display/debug)

  // Google Business Profile (Meu Negócio)
  businessAccountId    String?
  businessLocationId   String? // e.g. "locations/12345"
  businessLocationName String?

  // Google Analytics (GA4)
  ga4PropertyId   String? // e.g. "properties/123456789"
  ga4PropertyName String?

  lastSyncedAt DateTime?
  lastError    String?
  metadata     Json? // { connectedAt?, ... } non-secret display data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("google_integration_configs")
}

// Single-use CSRF state for the Google OAuth handshake. Trust is anchored on this
// row (not just the session). Short-lived; consumed on callback.
model GoogleOAuthState {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String
  state        String   @unique
  status       String   @default("PENDING") // PENDING | CONSUMED
  error        String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([expiresAt])
  @@map("google_oauth_states")
}

// ═══════════════════════════════════════════
//  RESTAURANT BRAND CONFIG  (Phase 4)
//  Per-restaurant AI brand voice and ordering engine settings.
//  Injected into PromptBuilder to shape the AI's tone, style,
//  and behaviour for every conversation turn.
// ═══════════════════════════════════════════

model RestaurantBrandConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // ── Voice & tone ────────────────────────────────────────────
  tone               String @default("friendly")
  // friendly | professional | casual | warm
  formality          String @default("informal")
  // formal | informal | mixed
  emojiUsage         String @default("moderate")
  // none | minimal | moderate | expressive
  communicationStyle String @default("conversational")
  // conversational | concise | detailed

  // ── Ordering behaviour ──────────────────────────────────────
  upsellStyle      String  @default("gentle")
  // none | gentle | moderate | proactive
  greetingTemplate String? // optional custom opening message

  // ── Advanced overrides ──────────────────────────────────────
  // When set, replaces the auto-generated system prompt entirely.
  // The token {CONTEXT} is replaced with the dynamic context block.
  systemPromptOverride String?

  // ── AI model settings ───────────────────────────────────────
  aiModel            String @default("gpt-4o-mini")
  // gpt-4o-mini | gpt-4o
  maxHistoryMessages Int    @default(20)
  // how many recent messages to include in the prompt

  // ── Experience / behavioral config (Phase 5) ─────────────────
  personalityPreset String @default("traditional")
  // traditional | fast | premium | young | aggressive
  upsellIntensity   String @default("medium")
  // low | medium | high
  salesFocus        String @default("balanced")
  // balanced | ticket | volume
  salesPriority     String @default("bestsellers")
  // bestsellers | high_margin | promotions

  // ── Visual identity ──────────────────────────────────────────
  brandPrimaryColor   String? // hex e.g. #6366f1
  brandSecondaryColor String? // hex e.g. #8b5cf6
  // Capa do cardápio — a faixa larga no topo do /qr/[slug], atrás do logo.
  // Vazio é o caso NORMAL, não um defeito: sem capa o cardápio desenha a faixa
  // com o degradê da própria marca (brandPrimary → brandSecondary). Por isso é
  // opcional e por isso a tela nunca depende dela para ficar bonita.
  coverImageUrl       String?

  // ── Social links (shown in ordering header if filled) ──────
  instagramUrl String?
  tiktokUrl    String?
  facebookUrl  String?
  youtubeUrl   String?

  // ── Review links (shown in CRM Avaliações tab) ───────────────
  googleReviewUrl String?
  ifoodReviewUrl  String?

  // ── Analytics / Tag Manager ───────────────────────────────────
  ga4MeasurementId String? // G-XXXXXXXXXX
  gtmId            String? // GTM-XXXXXXX

  // ── Waiter custom instructions ────────────────────────────────
  // Free-text instructions from the restaurant owner (AI Agents panel).
  // Injected into the Waiter system prompt AFTER all hard rules.
  waiterPrompt String? @db.Text

  // ── Ofertas no fechamento do pedido ───────────────────────────
  // Lista ORDENADA de nomes de categoria DESTE cardápio que o Garçom oferece
  // quando o cliente vai fechar. Antes era constante no código ("bebida" e
  // "sobremesa" por regex) — uma padaria não tem "sobremesa", tem "Confeitaria",
  // e o upsell simplesmente não acontecia.
  // Vazio = usar o padrão legado (bebida → sobremesa), derivado do cardápio.
  waiterUpsellCategories String[] @default([])

  // ── Brand Persona (marketing strategy) ───────────────────────
  // Stored as JSON to allow flexible evolution without migrations.
  brandPersona Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_brand_configs")
}

// ═══════════════════════════════════════════
//  WHATSAPP AGENT CONFIG
// ═══════════════════════════════════════════

model WhatsAppAgentConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // Behavior mode — controls whether WhatsApp uses full AI ordering or receptionist-only
  // RECEPTIONIST_ONLY       (default) — greet, answer basics, send menu link, hand off
  // HUMAN_ASSISTED          — same as receptionist but escalates to human sooner
  // AI_ORDERING_EXPERIMENTAL — full AIOrderService sales agent (opt-in only)
  agentMode String @default("RECEPTIONIST_ONLY")

  // Personality
  agentName String @default("Agente")
  tone      String @default("informal") // informal | neutral | premium
  style     String @default("sales_driven") // direct | consultive | sales_driven

  // Welcome message
  welcomeMessage String @default("Olá! Bem-vindo! 😊 O que você deseja?")

  // Entry menu options — JSON array of { id, label, flow, message? }
  // flow: order | handoff | menu | promotions | custom
  menuOptions Json?

  // Order action
  orderPreMessage String  @default("Ótimo! Aqui está nosso cardápio 👇")
  menuUrl         String?

  // Human handoff
  handoffPhone   String?
  handoffMessage String  @default("Vou te conectar com um atendente. Um momento! 👋")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_agent_configs")
}

model MenuItemExtra {
  id                    String   @id @default(cuid())
  menuItemId            String
  name                  String
  quantity              Int      @default(1)
  price                 Decimal  @db.Decimal(10, 2)
  portion               String? // e.g. "100g", "50ml", "1 porção"
  isAvailable           Boolean  @default(true)
  saiposIntegrationCode String? // PDV code for this extra/add-on
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_extras")
}

// ═══════════════════════════════════════════
//  OPTION GROUPS (product customisation)
// ═══════════════════════════════════════════

model OptionGroup {
  id         String   @id @default(cuid())
  menuItemId String
  name       String // e.g. "Tipo do peixe", "Molho"
  required   Boolean  @default(false) // if true, customer must pick at least minSelect
  minSelect  Int      @default(0) // minimum selections required
  maxSelect  Int      @default(1) // maximum selections allowed
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  OptionGroupItem[]

  @@index([menuItemId])
  @@map("option_groups")
}

model OptionGroupItem {
  id                    String   @id @default(cuid())
  groupId               String
  name                  String // e.g. "Cru", "Flambado", "Shoyu"
  price                 Decimal  @default(0) @db.Decimal(10, 2)
  portion               String? // e.g. "50g"
  isAvailable           Boolean  @default(true)
  sortOrder             Int      @default(0)
  saiposIntegrationCode String? // PDV code sent as choice_items[].integration_code
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("option_group_items")
}

model MediaUpload {
  id           String   @id @default(cuid())
  restaurantId String
  mimeType     String
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([restaurantId])
  @@map("media_uploads")
}

// ═══════════════════════════════════════════
//  MENU IMAGE ENHANCEMENT (internal/admin)
// ═══════════════════════════════════════════
// TODO: Potential future feature — Menu Photo Enhancement with AI,
//       always requiring owner approval before replacing product images.

enum MenuItemEnhancementStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  APPROVED
  REJECTED
  LOW_SOURCE_QUALITY
  NEEDS_NEW_PHOTO
}

model MenuItemImageEnhancement {
  id           String                    @id @default(cuid())
  menuItemId   String                    @unique
  restaurantId String
  originalUrl  String // snapshot of imageUrl at enhancement time
  enhancedUrl  String? // enhanced image (stored in Foocci storage)
  status       MenuItemEnhancementStatus @default(PENDING)
  processMode  String? // "enhance" | "upscale" | "enhance+upscale"
  providerName String? // which provider processed this
  errorReason  String?
  notes        String?
  approvedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("menu_item_image_enhancements")
}

// ═══════════════════════════════════════════
//  GENERAL SETTINGS
// ═══════════════════════════════════════════

model DeliveryConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // Global toggles
  enabled       Boolean @default(true)
  pickupEnabled Boolean @default(true)

  // UI mode — "simple" | "advanced" | "distance"
  mode String @default("simple")

  // Simple-mode fields
  fee              Decimal? @db.Decimal(10, 2)
  estimatedMinutes Int?
  areaDescription  String?

  // Commercial rules (apply in all modes)
  minOrderValue     Decimal? @db.Decimal(10, 2)
  freeDeliveryAbove Decimal? @db.Decimal(10, 2) // free delivery above this order value

  // Distance-mode fields: fee = baseFee + (distanceKm * pricePerKm), clamped to [minFee, maxFee]
  distanceBaseFee       Decimal? @db.Decimal(10, 2)
  distancePricePerKm    Decimal? @db.Decimal(10, 2)
  distanceMaxKm         Float?
  distanceMinFee        Decimal? @db.Decimal(10, 2)
  distanceMinFeeKm      Float? // km included in minimumFee (new formula)
  distanceMaxFee        Decimal? @db.Decimal(10, 2)
  distanceEstimatedBase Int?

  // Phase 3 — dynamic pricing hooks (not yet active)
  peakHoursEnabled Boolean @default(false)
  peakHoursConfig  String? // JSON blob: [{ days, startTime, endTime, surchargePercent }]

  // Phase 5 — map-ready geographic anchor
  geoCenter   String? // JSON: { lat: number, lng: number }
  geoRadiusKm Float? // max delivery radius in km

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("delivery_configs")
}

// ── Delivery Zones (advanced mode) ─────────────────────────────────────────────
//  Each zone represents a distance tier with its own fee and estimated time.
//  Phase 3: peakFee field for future time-based surcharge.
//  Phase 5: geoPolygon field for future map-drawn boundaries.

model DeliveryZone {
  id           String @id @default(cuid())
  restaurantId String

  name             String // e.g. "Zona 1 — Centro", "Raio 5km"
  sortOrder        Int      @default(0)
  maxDistanceKm    Float // upper bound for this tier (km)
  fee              Decimal  @db.Decimal(10, 2)
  estimatedMinutes Int
  minOrderValue    Decimal? @db.Decimal(10, 2) // zone-level minimum (overrides global)
  isActive         Boolean  @default(true)

  // Phase 3 — time-based pricing hook
  peakFee Decimal? @db.Decimal(10, 2) // future: surge fee during peak hours

  // Phase 5 — map-ready boundary
  geoPolygon String? // future: JSON polygon [[lat,lng], …]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, sortOrder])
  @@map("delivery_zones")
}

model BusinessHours {
  id           String   @id @default(cuid())
  restaurantId String
  dayOfWeek    Int // 0 = Sunday … 6 = Saturday
  isOpen       Boolean  @default(true)
  openTime     String   @default("09:00") // "HH:MM" — legacy single period open; use periodsJson when set
  closeTime    String   @default("22:00") // "HH:MM" — legacy single period close; use periodsJson when set
  periodsJson  Json? // [{open:"HH:MM",close:"HH:MM"},…] — null means use openTime/closeTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@map("business_hours")
}

model PaymentSettings {
  id           String   @id @default(cuid())
  restaurantId String   @unique
  acceptPix    Boolean  @default(true)
  acceptCash   Boolean  @default(true)
  acceptCard   Boolean  @default(true)
  acceptLink   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("payment_settings")
}

// ─── RestaurantSoundSettings ──────────────────────────────────────────────────
//  Per-restaurant sound/notification preferences.
//  Device-level audio permission state (blocked/unlocked) is tracked in
//  localStorage only — it is browser-specific and intentionally not stored here.

model RestaurantSoundSettings {
  id           String @id @default(cuid())
  restaurantId String @unique

  soundEnabled                     Boolean @default(true)
  newOrderSoundEnabled             Boolean @default(true)
  humanAttentionSoundEnabled       Boolean @default(true)
  soundVolume                      Int     @default(100) // 0–400; 100 = padrão, >100 = reforço via Web Audio
  repeatNewOrderSoundUntilAccepted Boolean @default(true) // new-order alert repeats until accepted (P0: reliable)
  repeatHumanAttentionUntilSeen    Boolean @default(true) // human-attention alarm repeats until assumed/resolved (P0)
  soundTheme                       String  @default("DEFAULT") // DEFAULT | SOFT | URGENT

  // Cross-DEVICE alarm lease (not just cross-tab — Web Locks alone only dedupes
  // tabs within one browser). Whichever device's heartbeat last renewed this is
  // the only one allowed to actually play the alarm; the lease is considered
  // stale (reclaimable by any other device) after ALARM_LEASE_STALE_MS with no
  // renewal — see AlarmLeaderService.
  alarmLeaderDeviceId    String?
  alarmLeaderHeartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_sound_settings")
}

// ─── PrintStation ─────────────────────────────────────────────────────────────
//  Maps each kitchen/station (Caixa, Cozinha 1–5, Copa, Cupom…) to a physical
//  printer. The local print agent ("Carteiro") reads this mapping to route each
//  ticket to the right printer. `printerName` is the Windows printer name as
//  reported by the agent; null means "not assigned yet". Additive & tenant-scoped.

model PrintStation {
  id           String   @id @default(cuid())
  restaurantId String
  key          String // stable identifier: CAIXA, COZINHA_1…COZINHA_5, COPA, CUPOM
  name         String // display name, editable by the owner
  printerName  String? // assigned Windows printer (null = unassigned)
  enabled      Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, key])
  @@index([restaurantId])
  @@map("print_stations")
}

// ─── PrintAgent ───────────────────────────────────────────────────────────────
//  One local print agent ("Carteiro") per restaurant. It lives on the restaurant's
//  PC and reaches OUT to Foocci (polling) — the cloud can't reach into the LAN.
//  Pairing: the owner copies `pairingCode` from the panel into the Carteiro once;
//  the agent receives a durable `token` and authenticates with it from then on.
//  The agent reports the printers it sees (`reportedPrinters`) so the panel shows
//  a real dropdown. `lastSeenAt` drives the online/offline badge.

model PrintAgent {
  id               String    @id @default(cuid())
  restaurantId     String    @unique
  pairingCode      String    @unique // short code the owner types into the Carteiro (single-use; rotates on pair)
  token            String?   @unique // durable agent secret, issued after pairing
  reportedPrinters String[] // printers the agent last saw on the PC
  agentVersion     String?
  lastSeenAt       DateTime?
  // Opt-in: emit ESC/POS double-height codes on kitchen item lines ("letras
  // grandes"). OFF by default — only enable if the printer accepts raw ESC/POS.
  kitchenLargeFont Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("print_agents")
}

// ─── PrintJob ─────────────────────────────────────────────────────────────────
//  A single ticket queued for the Carteiro to print. Created by Foocci (panel test
//  or, later, on order accept); the agent claims PENDING jobs on poll, prints them,
//  and acks (PRINTED/FAILED). Additive: no agent paired → jobs simply wait.

model PrintJob {
  id            String    @id @default(cuid())
  restaurantId  String
  orderId       String? // source order (null for test prints) — traceability + dedupe
  stationKey    String? // which station this came from (CAIXA, COZINHA_1, …)
  printerName   String // target Windows printer
  title         String // short label (e.g. "Pedido #123" / "TESTE")
  body          String // the ticket text to print
  /// PENDING → na fila · CLAIMED → entregue ao Carteiro, com prazo de ack
  /// PRINTED → saiu papel · DEAD → esgotou as tentativas, precisa de gente.
  /// Não existe estado terminal de falha silenciosa: CLAIMED sem ack volta
  /// para PENDING quando o prazo vence (era aqui que a comanda sumia).
  status        String    @default("PENDING") // PENDING | CLAIMED | PRINTED | DEAD
  error         String?
  /// Quantas vezes o job já saiu para o Carteiro. Conta no CLAIM, não no ack:
  /// job que foi entregue e sumiu também gastou tentativa.
  attempts      Int       @default(0)
  /// Antes disto o job não é servido de novo — o respiro entre as tentativas.
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  claimedAt     DateTime?
  printedAt     DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([orderId])
  @@map("print_jobs")
}

// ─── StoreProfile ─────────────────────────────────────────────────────────────
//  Complete fiscal, address, contact and operational data for the restaurant.
//  Extends the base Restaurant row without bloating it.

model StoreProfile {
  id           String @id @default(cuid())
  restaurantId String @unique

  // ── Dados da loja ──────────────────────────────────────────
  tradeName   String? // Nome fantasia
  legalName   String? // Razão social
  cuisineType String? // Tipo de cozinha / segmento

  // ── Dados fiscais ──────────────────────────────────────────
  cnpj                  String?
  stateRegistration     String? // Inscrição estadual
  municipalRegistration String? // Inscrição municipal
  taxRegime             String? // Regime tributário
  legalResponsibleName  String?
  legalResponsibleCpf   String?

  // ── Endereço estruturado ────────────────────────────────────
  cep            String?
  street         String?
  streetNumber   String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  country        String? @default("Brasil")
  referencePoint String?
  latitude       Float?
  longitude      Float?

  // ── Contatos ───────────────────────────────────────────────
  mainPhone         String?
  whatsappPhone     String?
  secondaryPhone    String?
  secondaryWhatsapp String?
  mainEmail         String?
  financeEmail      String?
  supportEmail      String?

  // ── Responsáveis ───────────────────────────────────────────
  ownerName       String?
  ownerRole       String?
  ownerPhone      String?
  ownerWhatsapp   String?
  ownerEmail      String?
  managerName     String?
  managerRole     String?
  managerPhone    String?
  managerWhatsapp String?
  managerEmail    String?

  // ── Operação ───────────────────────────────────────────────
  deliveryEnabled           Boolean @default(true)
  pickupEnabled             Boolean @default(true)
  dineInEnabled             Boolean @default(true)
  averagePreparationMinutes Int?

  // ── Quem é esse cliente (cadastro interno) ─────────────────
  //
  // Nasceu de um buraco concreto: para escrever a primeira peça de um cliente
  // foi preciso procurar o @ dele — e não existia em lugar nenhum. Nem o @, nem
  // o nicho, nem a persona. Cada vez que alguém precisava, perguntava de novo.
  //
  // Estes campos são o CADASTRO: quem é o restaurante, não como ele está. Ficam
  // ao lado do fiscal e do endereço de propósito — é tudo a mesma ficha, e
  // dividir em duas tabelas seria só garantir que uma delas ficaria vazia.
  instagram         String? // @ ou URL
  facebook          String?
  tiktok            String?
  youtube           String?
  website           String?
  googleBusinessUrl String? // Google Meu Negócio
  ifoodUrl          String?
  otherLinks        Json? // [{ label, url }] — o que não coube acima

  niche              String? // "hamburgueria artesanal", "japonês delivery"
  targetPersona      String? @db.Text // quem compra, descrito como gente
  differentiator     String? @db.Text // por que escolhem ele e não o vizinho
  averageTicketRange String? // faixa de ticket, como o dono fala
  mainCompetitors    String? @db.Text
  brandTone          String? // como a marca fala

  /// De onde veio este cliente (indicação, inbound, prospecção…).
  leadSource    String?
  /// Anotações da equipe. NUNCA exposto ao lojista — só no admin.
  internalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("store_profiles")
}

model StorePolicies {
  id                 String   @id @default(cuid())
  restaurantId       String   @unique
  termsOfUse         String?
  privacyPolicy      String?
  cancellationPolicy String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("store_policies")
}

// ═══════════════════════════════════════════
//  PROMOTIONS  (Marketing Engine)
// ═══════════════════════════════════════════

enum PromotionType {
  PERCENTAGE // e.g. 10% off
  FIXED // e.g. R$5 off
  COMBO // bundled offer (configured via description/rules)
  FREE_DELIVERY // zeroes delivery fee
  COUPON // code-gated discount
  BANNER // visual banner displayed on all menus on scheduled day
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum PromotionChannel {
  QR_MENU
  DELIVERY
  WHATSAPP
  ALL
}

enum PromotionTarget {
  PRODUCT // applies to specific products
  CATEGORY // applies to a whole category
  ORDER // applies to the whole order
}

model Promotion {
  id            String          @id @default(cuid())
  restaurantId  String
  name          String
  description   String?
  type          PromotionType
  status        PromotionStatus @default(DRAFT)
  discountValue Decimal         @default(0) @db.Decimal(10, 2)

  // Targeting
  target            PromotionTarget  @default(ORDER)
  targetProductIds  String[]         @default([])
  targetCategoryIds String[]         @default([])
  channel           PromotionChannel @default(ALL)

  // Coupon
  couponCode         String?
  // When granted to a customer's wallet, the coupon stays valid this many days from
  // the grant. Null = fall back to endsAt, else a 30-day default.
  couponValidityDays Int?

  // Banner (type=BANNER only)
  bannerImageUrl String?

  // Validity window
  startsAt   DateTime?
  endsAt     DateTime?
  daysOfWeek Int[]     @default([]) // 0=Sun … 6=Sat; empty = every day
  timeFrom   String? // "HH:MM" (local restaurant time)
  timeTo     String? // "HH:MM"

  // Eligibility rules
  minOrderValue  Decimal? @db.Decimal(10, 2)
  minQuantity    Int?
  maxUses        Int?
  usedCount      Int      @default(0)
  oneTimePerUser Boolean  @default(false)
  combinable     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  walletEntries CustomerCoupon[]

  @@index([restaurantId])
  @@map("promotions")
}

// A coupon a specific customer has earned — their personal wallet (iFood-style).
// Granted by CRM campaigns; redeemed in the cart. Accumulates over time.
model CustomerCoupon {
  id               String               @id @default(cuid())
  restaurantId     String
  customerId       String
  promotionId      String? // legacy link; new card-defined coupons are self-contained
  couponCode       String // short reference label (auto)
  // Self-contained reward (card-defined). PERCENTAGE (value = %), FIXED (value = R$),
  // or CUSTOM (a physical gift; description holds the text, no auto-discount).
  discountType     String? // "PERCENTAGE" | "FIXED" | "CUSTOM"
  discountValue    Decimal?             @db.Decimal(10, 2)
  description      String? // CUSTOM reward text, e.g. "sobremesa grátis"
  costEstimate     Decimal?             @db.Decimal(10, 2) // estimated R$ cost, for the monthly coupon budget
  status           CustomerCouponStatus @default(ACTIVE)
  grantedAt        DateTime             @default(now())
  expiresAt        DateTime? // null = never expires
  sourceCampaignId String? // which campaign credited it
  usedAt           DateTime?
  usedOrderId      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  promotion  Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([restaurantId])
  @@map("customer_coupons")
}

enum CustomerCouponStatus {
  ACTIVE
  USED
  EXPIRED
}

// ═══════════════════════════════════════════
//  CRM AUTOMATIONS
// ═══════════════════════════════════════════

enum AutomationTrigger {
  REACTIVATION // fires after X days of customer inactivity
  BIRTHDAY // fires on customer birthday
  POST_ORDER // fires X days after a completed order
}

model CRMAutomation {
  id                      String            @id @default(cuid())
  restaurantId            String
  trigger                 AutomationTrigger
  isEnabled               Boolean           @default(false)
  messageTemplate         String            @default("")
  triggerAfterDays        Int               @default(30)
  oncePerCustomerLifetime Boolean           @default(false)
  discountType            String? // "PERCENTAGE" | "FIXED" | null
  discountValue           Decimal?          @db.Decimal(10, 2)
  scheduleConfig          Json? // { sendTime?, sendDays?, timezone? }
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, trigger])
  @@index([restaurantId])
  @@map("crm_automations")
}

/// Manually-created CRM action template by the restaurant owner.
/// Never triggers sending by itself — status stays DRAFT until a future
/// scheduling layer is built.
model CRMCustomAction {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  objective     String // RECUPERAR | RECOMPRA | TICKET | BEBIDA | SOBREMESA | AVALIACAO | VIP | ANIVERSARIO | OUTRO
  targetSegment String // TODOS | QUENTE | MORNO | FRIO | NOVOS | RECORRENTES | VIP | PRIMEIRO_PEDIDO | ...
  channel       String   @default("WHATSAPP") // WHATSAPP | MANUAL | CRM_AGENT
  message       String   @db.Text
  notes         String?  @db.Text
  status        String   @default("DRAFT") // DRAFT (only status for now)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@map("crm_custom_actions")
}

// ═══════════════════════════════════════════
//  CRM ADAPTIVE BRAIN
// ═══════════════════════════════════════════

enum CRMMessageStyle {
  FRIENDLY
  PLAYFUL
  DIRECT
  EMOTIONAL
  PREMIUM
}

/// Tone personality of the restaurant — biases style selection.
enum CRMToneProfile {
  CASUAL // boosts PLAYFUL + FRIENDLY
  PREMIUM_FEEL // boosts PREMIUM + EMOTIONAL
  FRIENDLY // boosts FRIENDLY + EMOTIONAL
  SALES_FORWARD // boosts DIRECT + PREMIUM
}

/// One row per CRM message dispatched. Outcomes updated asynchronously.
model CRMActionLog {
  id           String          @id @default(cuid())
  restaurantId String
  customerId   String?
  actionType   String // maps to MessageIntent values
  messageStyle CRMMessageStyle
  messageText  String
  responded    Boolean         @default(false)
  converted    Boolean         @default(false)
  revenue      Decimal?        @db.Decimal(10, 2)
  respondedAt  DateTime?
  convertedAt  DateTime?
  orderId      String? // denormalized Order.id — no FK to avoid cascade complexity
  // Structured action context (nullable, additive). For review requests:
  // { status: "sent"|"failed"|"skipped", platform: "GOOGLE"|"IFOOD", reviewLink, channel, error? }
  metadata     Json?
  createdAt    DateTime        @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, messageStyle])
  @@index([restaurantId, createdAt])
  @@map("crm_action_logs")
}

/// One row per restaurant. Tone preference + cached style weights.
model RestaurantCRMProfile {
  id                   String         @id @default(cuid())
  restaurantId         String         @unique
  toneProfile          CRMToneProfile @default(FRIENDLY)
  styleWeights         Json           @default("{}") // { FRIENDLY: 0.3, PLAYFUL: 0.2, ... }
  profileVersion       Int            @default(0) // bumped each time weights are recomputed
  whatsAppSafetyConfig Json? // CRMWhatsAppSafetyConfig — global sending safety rules
  segmentConfig        Json? // SegmentConfig — relationship segment day thresholds
  readyMadeConfig      Json? // ReadyMadeConfig — on/off for non-campaign ready-made engines (cart recovery)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_crm_profiles")
}

// ═══════════════════════════════════════════
//  AUTO SIMULATOR
// ═══════════════════════════════════════════

model AutoSimulatorConfig {
  id              String    @id @default(cuid())
  restaurantId    String    @unique
  enabled         Boolean   @default(false)
  intervalMinutes Int       @default(60)
  scenarioCount   Int       @default(10)
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("auto_simulator_configs")
}

model SimulationRun {
  id                String   @id @default(cuid())
  restaurantId      String
  ranAt             DateTime @default(now())
  scenarioCount     Int
  overallScore      Float
  conversionRate    Float
  attachRateDrink   Float
  attachRateDessert Float
  errorSummary      Json
  analysis          Json
  insight           String
  suggestedPrompt   String   @db.Text
  triggeredBy       String   @default("scheduler")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, ranAt])
  @@map("simulation_runs")
}

// ═══════════════════════════════════════════
//  TRACKING LINKS  (Channel attribution)
//  Each link represents a specific marketing channel / placement.
//  Customers arrive via /l/[restaurantSlug]/[trackingSlug] which
//  redirects to the destination and attaches UTM attribution.
// ═══════════════════════════════════════════

model TrackingLink {
  id              String  @id @default(cuid())
  restaurantId    String
  name            String // human label, e.g. "Instagram Bio"
  slug            String // URL-safe slug, e.g. "instagram-bio"
  destinationType String  @default("PEDIDO") // PEDIDO | QR
  source          String // utm_source — e.g. instagram, whatsapp, qr, google
  medium          String // utm_medium — e.g. bio, direct, mesa, embalagem
  campaign        String? // utm_campaign (optional)
  content         String? // utm_content  (optional)
  term            String? // utm_term     (optional)
  isActive        Boolean @default(true)

  // ── Short link ─────────────────────────────────────────────────
  shortCode String? @unique // e.g. "k7m9qx3" — used for /r/[code] redirect

  // ── Aggregated metrics (incremented atomically) ────────────────
  clickCount              Int     @default(0)
  identifiedCustomerCount Int     @default(0)
  orderStartedCount       Int     @default(0)
  orderCompletedCount     Int     @default(0)
  revenue                 Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, slug])
  @@index([restaurantId])
  @@map("tracking_links")
}

// ═══════════════════════════════════════════
//  RELATIONSHIP PROGRAM
// ═══════════════════════════════════════════

/// Per-restaurant tier thresholds. If absent, defaults from crm-helpers are used.
model TierSettings {
  id           String @id @default(cuid())
  restaurantId String @unique

  /// Master switch: the whole relationship program (tiers, benefits, tier
  /// campaigns, customer-facing badge) is inert until the owner turns it on.
  programEnabled Boolean @default(false)

  /// Rolling window (months) of sales that counts toward the tier. 0 = vitalício
  /// (lifetime). Reclassified daily so a customer who stops buying slides down.
  classificationWindowMonths Int @default(0)

  /// PRATA thresholds (OR logic — either is enough to qualify)
  silverMinSpend  Decimal @default(300) @db.Decimal(10, 2)
  silverMinOrders Int     @default(0) // 0 = spend-only

  /// OURO thresholds
  goldMinSpend  Decimal @default(800) @db.Decimal(10, 2)
  goldMinOrders Int     @default(0)

  /// DIAMANTE thresholds
  diamondMinSpend  Decimal @default(2000) @db.Decimal(10, 2)
  diamondMinOrders Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("tier_settings")
}

/// Custom benefits per tier, configured by the restaurant.
model TierBenefit {
  id             String   @id @default(cuid())
  restaurantId   String
  tier           String // BRONZE | PRATA | OURO | DIAMANTE
  title          String
  description    String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  /// Physical restaurant gift (e.g. a branded mug) handed to customers who reach
  /// this tier — tracked against a real stock so the owner never over-promises.
  isPhysicalGift Boolean  @default(false)
  stockTotal     Int? // null = untracked; a number = physical units available
  stockUsed      Int      @default(0) // units already delivered to customers
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, tier])
  @@map("tier_benefits")
}

// ═══════════════════════════════════════════
//  ONBOARDING
// ═══════════════════════════════════════════

model RestaurantOnboardingStatus {
  id                   String    @id @default(cuid())
  restaurantId         String    @unique
  finalTestCompletedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_onboarding_statuses")
}

// ═══════════════════════════════════════════
//  CUSTOMER INTELLIGENCE
// ═══════════════════════════════════════════

/// Inferred or collected data signals about a customer.
/// Confirmed signals must not auto-overwrite confirmed Customer fields.
model CustomerDataSignal {
  id           String @id @default(cuid())
  restaurantId String
  customerId   String

  /// PREFERENCE | POSSIBLE_FAVORITE_PRODUCT | MISSING_FIELD | ADDRESS_CLUE | BIRTHDAY_REQUESTED | NAME_CLUE
  type String

  /// Which customer field this signal pertains to (e.g. "birthDate", "address", "preferences.dietary")
  field String?

  /// The inferred or collected value (stringified)
  value String?

  /// 0–1 confidence score (1 = confirmed)
  confidence Float?

  /// IMPORT | ORDER_HISTORY | WHATSAPP_CONVERSATION | HUMAN_NOTE | CRM_CAMPAIGN | ANALYTICS
  source String

  /// INFERRED | CONFIRMED | REJECTED | NEEDS_REVIEW
  status String @default("INFERRED")

  notes      String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([restaurantId, status])
  @@map("customer_data_signals")
}

// Lightweight page-view event fired when a customer opens the delivery menu.
// Used to compute visits-by-source without touching the Order table.
model MenuEvent {
  id           String   @id @default(cuid())
  restaurantId String
  /// Normalized source: instagram | whatsapp | google | qrcode | crm | manual | direct | other
  source       String?
  /// Set when the visitor is IDENTIFIED (passed the mandatory phone screen, or
  /// arrived already identified). A visit only counts for conversion when this is
  /// present — an anonymous open that never enters a phone is not a real visit.
  customerId   String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, source])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, customerId])
  @@map("menu_events")
}

// ═══════════════════════════════════════════
//  RESTAURANT KNOWLEDGE BASE
// ═══════════════════════════════════════════
//
// Stores facts, FAQs and operational answers learned from human conversations
// or entered manually. The WhatsApp Agent uses ACTIVE items to answer customers
// without hallucinating. SUGGESTED items await owner approval.

model RestaurantKnowledgeItem {
  id           String @id @default(cuid())
  restaurantId String

  // Human-readable title for the owner (not shown to customer)
  title    String
  category String // FAQ | POLICY | PROMOTION | BUSINESS_HOURS | DELIVERY_INFO | RODIZIO_INFO | BIRTHDAY_BENEFIT | PAYMENT_INFO | HUMAN_HANDOFF_RULE | UNKNOWN_GAP

  // Example phrases the customer might use — used for keyword matching
  questionPatterns Json // string[]

  // What the agent will say to the customer (empty when status=UNKNOWN_GAP)
  answer String @default("")

  // Lifecycle: SUGGESTED → APPROVED/REJECTED → ACTIVE
  status String @default("SUGGESTED") // SUGGESTED | APPROVED | REJECTED | ACTIVE

  // Origin of this knowledge item
  source String // HUMAN_REPLY | MANUAL | AI_SUGGESTED | IMPORTED

  // Confidence score (0.0–1.0); null means manually set / unconditional
  confidence Float?

  // Audit trail — links this item back to the conversation it was learned from
  createdFromConversationId String?
  createdFromMessageIds     Json? // string[]

  // Usage stats
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  // Retrieval por embedding (backfill lazy — ver KnowledgeEmbeddingService); null = ainda não calculado
  embedding      Json? // number[]
  embeddingModel String? // ex.: "text-embedding-3-small"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, category])
  @@map("restaurant_knowledge_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
//  MANUAL OPERACIONAL DO FOOCCI (INTERNAL — Admin/Master only)
//
//  This is the internal "operational bible" for Foocci/Fute.
//  It documents product rules, AI agent behaviour, flows, integrations,
//  UI rules, CRM rules, WhatsApp rules, checkout rules, and operational
//  decisions.
//
//  Phase 1: database structure + admin APIs + admin UI + version/publish flow.
//  Agents do NOT query this manual yet. RAG/embeddings come in a later phase.
//  Only content with isPublished=true and agentVisibility=true will be surfaced
//  to agents — but that gate is not open yet.
//
//  Change requests MUST be approved before any chapter is published.
// ═══════════════════════════════════════════════════════════════════════════════

/// Module area / domain that a chapter or decision belongs to.
enum ManualArea {
  GENERAL
  WAITER_AGENT
  CRM
  WHATSAPP
  UI_UX
  BRANDING
  INTEGRATIONS
  CHECKOUT
  PAYMENTS
  ANALYTICS
  SECURITY
  BACKLOG
}

/// Lifecycle status of a chapter or decision.
enum ManualRuleStatus {
  IMPLEMENTED
  PARTIAL
  DECIDED
  BACKLOG
}

/// Workflow status for a pending change request.
enum ManualChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Where a change or decision originated.
enum ManualSourceType {
  CHATGPT
  CLAUDE_AUDIT
  CODE_AUDIT
  MANUAL
  DEPLOY
  BUGFIX
  PRODUCT_DECISION
}

/// A chapter in the Foocci Operational Manual.
/// Each chapter has a versioned content body, a lifecycle status, and an
/// optional flag for future agent visibility.
model OperationalManualChapter {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  area            ManualArea       @default(GENERAL)
  description     String?
  content         String           @db.Text
  status          ManualRuleStatus @default(BACKLOG)
  version         String           @default("0.1")
  isPublished     Boolean          @default(false)
  /// When true, agents may read this chapter (gate not yet open — Phase 2+).
  agentVisibility Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  approvedBy      String?
  /// Vetor de embedding do capítulo (number[]), calculado sob demanda pelo
  /// retrieval do assistente. Fica null até o primeiro backfill.
  embedding       Json?
  /// Modelo que gerou o vetor — trocar de modelo invalida o vetor antigo.
  embeddingModel  String?

  revisions      OperationalManualRevision[]
  changeRequests OperationalManualChangeRequest[]

  @@index([area])
  @@index([status])
  @@index([isPublished])
  @@map("operational_manual_chapters")
}

/// Immutable snapshot of a chapter at a specific version.
/// Created automatically on every publish action.
model OperationalManualRevision {
  id              String           @id @default(cuid())
  chapterId       String
  version         String
  content         String           @db.Text
  changeSummary   String?
  sourceType      ManualSourceType @default(MANUAL)
  sourceReference String?
  createdAt       DateTime         @default(now())
  createdBy       String?

  chapter OperationalManualChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("operational_manual_revisions")
}

/// A proposed change to one or more chapters, waiting for admin approval.
/// Nothing becomes official content without an APPROVED change request.
model OperationalManualChangeRequest {
  id              String             @id @default(cuid())
  chapterId       String?
  title           String
  proposedContent String             @db.Text
  proposedDiff    String?            @db.Text
  reason          String
  impactAreas     String?
  status          ManualChangeStatus @default(PENDING)
  sourceType      ManualSourceType   @default(MANUAL)
  sourceReference String?
  createdAt       DateTime           @default(now())
  reviewedAt      DateTime?
  createdBy       String?
  reviewedBy      String?

  chapter OperationalManualChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([status])
  @@map("operational_manual_change_requests")
}

/// Permanent log of product and operational decisions, independently of chapters.
/// Useful for answering "why did we decide X?" without editing live chapter content.
model OperationalManualDecisionLog {
  id              String           @id @default(cuid())
  title           String
  description     String           @db.Text
  area            ManualArea       @default(GENERAL)
  status          ManualRuleStatus @default(DECIDED)
  sourceType      ManualSourceType @default(PRODUCT_DECISION)
  sourceReference String?
  createdAt       DateTime         @default(now())
  createdBy       String?

  @@index([area])
  @@index([status])
  @@map("operational_manual_decision_logs")
}

// ═══════════════════════════════════════════
//  FOOCCI HELP WIDGET — lojista-facing guide / AI chat / support channel
// ═══════════════════════════════════════════
//
//  Powers the floating, retractable in-app help widget for restaurant owners:
//   • AI Q&A grounded on the published + agent-visible Operational Manual (RAG)
//   • "Falar com a FOOD" — escalation to the Foocci team as a last resort
//  The Foocci team answers escalated threads from /admin/support-inbox.
//
//  A thread starts in AI mode; escalation flips it to HUMAN mode + ESCALATED
//  status. SUPPORT messages are written by the Foocci team, USER by the lojista,
//  ASSISTANT by the AI, SYSTEM for state-change markers.

model HelpThread {
  id            String           @id @default(cuid())
  restaurantId  String
  userId        String? // lojista user who opened it (soft ref, no FK)
  subject       String?
  status        HelpThreadStatus @default(OPEN)
  mode          HelpThreadMode   @default(AI)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  messages    HelpMessage[]
  attachments HelpAttachment[]

  @@index([restaurantId])
  @@index([status])
  @@map("help_threads")
}

model HelpMessage {
  id         String          @id @default(cuid())
  threadId   String
  role       HelpMessageRole
  content    String          @db.Text
  authorName String? // display name for SUPPORT/USER messages
  createdAt  DateTime        @default(now())

  thread      HelpThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments HelpAttachment[]

  @@index([threadId])
  @@map("help_messages")
}

/// Anexo do chat de suporte — print, foto ou PDF que o lojista manda junto com
/// a mensagem ("a tela está assim", "a nota saiu errada").
///
/// ⚠️ **O binário mora no Postgres de propósito, não no S3.** O `uploadToS3`
/// deste projeto grava com `ACL: "public-read"` (src/lib/s3.ts) e o
/// `/api/media/[id]` que serve aquele acervo é rota PÚBLICA — foi feito para
/// foto de cardápio, que é para todo mundo ver. Print de painel de suporte é o
/// oposto: contém nome, telefone e endereço de cliente final. Por isso o byte
/// fica aqui e sai só por rota autenticada, que confere o tenant.
///
/// `messageId` nasce nulo: o arquivo sobe enquanto a pessoa ainda está
/// escrevendo (para haver pré-visualização) e só é amarrado à mensagem no
/// envio. Anexo solto é rascunho e pode ser removido por quem subiu.
///
model HelpAttachment {
  id           String   @id @default(cuid())
  restaurantId String
  threadId     String
  messageId    String?
  /// Quem subiu. Nulo quando veio da equipe Foocci pelo inbox admin.
  uploadedBy   String?
  /// Nome saneado — nunca o caminho cru que o navegador mandou.
  fileName     String
  mimeType     String
  bytes        Int
  data         Bytes
  createdAt    DateTime @default(now())

  thread  HelpThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message HelpMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([messageId])
  @@index([restaurantId])
  @@map("help_attachments")
}

enum HelpThreadStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum HelpThreadMode {
  AI
  HUMAN
}

enum HelpMessageRole {
  USER
  ASSISTANT
  SUPPORT
  SYSTEM
}

/// Chamado de suporte — o "último caso" do agente de suporte.
/// Nasce quando o agente não resolve e o lojista pede humano. É o COFRE: existe
/// mesmo que o e-mail de aviso falhe (notifyError guarda o porquê). Carrega a
/// evidência do caso (pergunta, o que o agente tentou, por que escalou) para o
/// time humano não precisar reconstituir nada.
model SupportTicket {
  id           String              @id @default(cuid())
  /// Número sequencial legível — vira "CHM-0042" para o lojista.
  number       Int                 @unique @default(autoincrement())
  restaurantId String
  userId       String?
  threadId     String?
  subject      String
  /// Por que escalou (motivo do agente ou pedido explícito do lojista).
  reason       String              @db.Text
  /// Evidência: transcrição/resumo do que foi perguntado e tentado.
  evidence     String              @db.Text
  status       SupportTicketStatus @default(OPEN)
  notifiedAt   DateTime?
  notifyError  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ═══════════════════════════════════════════
//  AI AGENTS ADMIN — FOUNDATION (Phase 1)
// ═══════════════════════════════════════════
//
//  Internal foundation for the future "Admin → AI Agents" area.
//
//  ┌────────────────────────────────────────────────────────────────────────┐
//  │  SOURCE-OF-TRUTH PRECEDENCE (do NOT violate)                            │
//  │                                                                        │
//  │  1. HARDCODED safety / protocol rules = the IMMUTABLE FLOOR.            │
//  │     - src/lib/agent/protocol.ts  → ABSOLUTE_RULES                       │
//  │     - src/services/ai/waiter/WaiterAgentProfile.ts → SAFETY_BOUNDARIES  │
//  │     These are never overridable by DB rows, ever.                      │
//  │  2. MASTER AgentProfile (these tables) may ENRICH behavior.            │
//  │  3. RestaurantAgentProfileOverride may PERSONALIZE tone only —         │
//  │     it can NEVER override safety / forbidden rules.                    │
//  │                                                                        │
//  │  RUNTIME USE IS DISABLED in Phase 1. The Waiter runtime still reads    │
//  │  exclusively from the code-defined constitution. These rows are        │
//  │  data-only (seed + future Admin UI). The `isRuntimeEnabled` column     │
//  │  and the AGENT_PROFILE_DB_ENABLED env flag both default to OFF and     │
//  │  gate any future DB-driven runtime (Phase 3).                          │
//  └────────────────────────────────────────────────────────────────────────┘

/// Logical area / department of an AI agent. Mirrors the agent registry.
enum AgentArea {
  ORCHESTRATOR // Manager agent that coordinates the others
  SECURITY // Security & Governance agent
  WAITER // Sales / ordering agent inside /pedido
  WHATSAPP // Inbound WhatsApp receptionist
  CRM // Outbound relationship agent
  UI_UX // UI/UX agent
  MANUAL // Manual / Constitution agent
  QA // QA / Test agent
  INTEGRATION // Integration agent
  BRANDING // Branding agent
  ANALYTICS // Analytics / Product agent
  GENERAL
}

/// Lifecycle status of an agent profile.
enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Who is allowed to SEE an agent profile.
/// INTERNAL = master/internal admins only (never exposed to restaurant users).
enum AgentVisibility {
  INTERNAL
  RESTAURANT
  PUBLIC
}

/// Master, global definition of an AI agent's professional profile.
/// One row per logical agent (Waiter, WhatsApp, CRM, …). Structured sections
/// map 1:1 to the future Admin → Agents editor. Rich, normalized-where-cheap,
/// JSON-where-flexible (objectives/rules/examples are arrays, not tables).
///
/// SAFETY: `forbiddenActions` and `safetyRules` are INTERNAL/master-only and
/// are NEVER editable or visible to restaurant users.
model AgentProfile {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  title       String?
  area        AgentArea @default(GENERAL)
  description String?   @db.Text

  // ── Professional identity (structured sections) ──
  mission            String? @db.Text
  objectives         Json    @default("[]") // string[]
  responsibilities   Json    @default("[]") // string[]
  skills             Json    @default("[]") // string[]
  allowedActions     Json    @default("[]") // string[]  (CAN_DO)
  forbiddenActions   Json    @default("[]") // string[]  (CANNOT_DO) — INTERNAL ONLY
  tools              Json    @default("[]") // string[]
  knowledgeAreas     Json    @default("[]") // string[]  (Phase 4 will link real items)
  interfaceContext   String? @db.Text
  businessRules      Json    @default("[]") // string[]
  safetyRules        Json    @default("[]") // string[]  (SAFETY_BOUNDARIES) — INTERNAL ONLY, IMMUTABLE FLOOR
  escalationRules    Json    @default("[]") // string[]
  promptInstructions String? @db.Text
  outputRules        Json    @default("[]") // string[]
  evaluationCriteria Json    @default("[]") // string[]

  /// Agent-specific rich sections that do not deserve their own columns yet
  /// (e.g. Waiter: salesPrinciples, menuReadingRules, examples, …).
  /// Kept as JSON to evolve without migrations until patterns stabilize.
  extendedSections Json? // Record<string, unknown>

  // ── Governance / lifecycle ──
  status           AgentStatus     @default(DRAFT)
  visibility       AgentVisibility @default(INTERNAL)
  isGlobalDefault  Boolean         @default(true)
  /// Master kill-switch for DB-driven runtime for THIS agent. OFF in Phase 1.
  isRuntimeEnabled Boolean         @default(false)
  version          String          @default("0.1")
  /// Where the row originated: CODE_SEED | MANUAL | IMPORT | …
  source           String?         @default("CODE_SEED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  // ── Organização interna (ADR-002 + ADR-006) ────────────────────────────────
  //
  // Campos aditivos. Toda linha que já existia continua significando o mesmo:
  // `population` nasce PRODUTO e `executionMode` nasce AI, que é o que os
  // quatro agentes de produto sempre foram.

  /// A qual das três populações esta ficha pertence. Ver ADR-006.
  ///
  /// Em 07/08/2026 quatro fichas foram apagadas por confundir DUAS populações.
  /// Este campo existe para que a terceira não repita o acidente — e para que a
  /// tela de produto nunca liste, sem querer, o Closer da empresa.
  population AgentPopulation @default(PRODUTO)

  /// IA executa sozinha · HUMAN é pessoa · HYBRID é IA com humano no comando.
  executionMode AgentExecutionMode @default(AI)

  /// Nulo para agente de produto, que não pertence a departamento da empresa.
  departmentId String?

  /// O CARGO responsável pela ficha, e o CARGO que a gerencia — não a pessoa.
  ownerPositionId   String?
  managerPositionId String?

  /// Numeração do catálogo aprovado ("2.2"). É como o proprietário chama a ficha.
  catalogNumber String?

  versions  AgentProfileVersion[]
  overrides RestaurantAgentProfileOverride[]

  naoConformidades NaoConformidade[]
  department       Department?       @relation(fields: [departmentId], references: [id])
  ownerPosition    Position?         @relation("DonoDaFicha", fields: [ownerPositionId], references: [id])
  managerPosition  Position?         @relation("GestorDaFicha", fields: [managerPositionId], references: [id])

  @@index([area])
  @@index([status])
  @@index([visibility])
  @@index([population])
  @@index([departmentId])
  @@map("agent_profiles")
}

/// As três populações de agente. Elas NÃO se medem igual, e somá-las produz um
/// total sem significado — por isso o campo é enum e não booleano.
///
/// `PRODUTO`         roda dentro do sistema, para o lojista ou o cliente final.
/// `DESENVOLVIMENTO` constrói o Foocci (vive em `.claude/agents/`).
/// `EMPRESA`         quem trabalha NA Foocci: SDR, Closer, Gerente Financeiro.
enum AgentPopulation {
  PRODUTO
  DESENVOLVIMENTO
  EMPRESA
}

/// Como a ficha executa. `HUMAN` com dono preenchido é ficha de gente, não de IA.
enum AgentExecutionMode {
  AI
  HUMAN
  HYBRID
}

/// Immutable snapshot of an AgentProfile at a specific version.
/// Created on every meaningful edit (Phase 2+). Enables history / rollback /
/// "why did the Waiter change?" audits — the same pattern as the Operational
/// Manual revisions.
model AgentProfileVersion {
  id             String   @id @default(cuid())
  agentProfileId String
  version        String
  /// Full structured snapshot of the profile at this version.
  snapshot       Json
  changeSummary  String?
  source         String?  @default("MANUAL")
  createdAt      DateTime @default(now())
  createdBy      String?

  profile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  @@index([agentProfileId])
  @@map("agent_profile_versions")
}

/// Per-restaurant personalization of a master agent profile.
///
/// SAFETY: this layer may ONLY personalize tone/voice and ADD non-safety
/// enrichment. It can NEVER override `forbiddenActions` / `safetyRules` from
/// the master profile, nor the hardcoded protocol floor. The application layer
/// enforces this; the schema deliberately exposes no safety columns here.
model RestaurantAgentProfileOverride {
  id             String @id @default(cuid())
  restaurantId   String
  agentProfileId String

  displayName        String?
  toneOverride       String?
  styleOverride      String?
  /// Free-text additions from the restaurant owner. Injected AFTER all hard
  /// rules (same contract as RestaurantBrandConfig.waiterPrompt). Never safety.
  customInstructions String? @db.Text
  /// Non-safety enrichment sections (e.g. local specialties, seasonal notes).
  enrichmentSections Json?
  /// Whether this restaurant has opted into the override. OFF by default.
  isEnabled          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  profile    AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, agentProfileId])
  @@index([restaurantId])
  @@index([agentProfileId])
  @@map("restaurant_agent_profile_overrides")
}

// TODO (Phase 4 — Knowledge Library): AgentKnowledgeRef
// A join model linking an AgentProfile to concrete knowledge sources
// (RestaurantKnowledgeItem, OperationalManualChapter with agentVisibility=true).
// Intentionally NOT created in Phase 1 — knowledge governance + the manual
// `agentVisibility` gate are Phase 4 concerns. Until then, AgentProfile.knowledgeAreas
// holds plain string labels only.

// ═══════════════════════════════════════════
//  BUILD OS — PROMPT RELAY / COMMAND ROUTER (Priority 1.1)
// ═══════════════════════════════════════════
//
//  Project-agnostic command intake foundation. Foocci is the first project, but
//  these models deliberately have NO `restaurantId` — tenancy is by BuildProject.
//
//  ┌────────────────────────────────────────────────────────────────────────┐
//  │  SCOPE (Priority 1.1) — intake + persistence + audit ONLY                │
//  │   • An authorized operator sends a WhatsApp command (/build, /cmd,        │
//  │     /prompt). It is stored as a BuildCommand with append-only events.     │
//  │   • NO Claude relay, NO GitHub issues, NO LLM prompt generation,          │
//  │     NO code execution. Confirmation reply only.                           │
//  │  SECURITY: only allow-listed phone numbers create records. Unauthorized   │
//  │     senders are ignored (no record, no sensitive reply).                  │
//  └────────────────────────────────────────────────────────────────────────┘

enum BuildCommandStatus {
  RECEIVED
  DRAFTED
  AWAITING_CONFIRMATION
  APPROVED_FOR_RELAY
  REVISION_REQUESTED
  CANCELLED
  FAILED
}

/// How a stored prompt draft was produced. Priority 1.4 = TEMPLATE only (no LLM).
enum BuildPromptKind {
  TECHNICAL_DRAFT
}

enum BuildPromptGeneratedBy {
  TEMPLATE
}

enum BuildCommandSourceChannel {
  WHATSAPP
  ADMIN
}

enum BuildRiskLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BuildTaskType {
  UNKNOWN
  FEATURE
  FIX
  REFACTOR
  AUDIT
  DOCS
  UI_UX
  CONFIG
  TEST
  SECURITY
}

/// Deterministic execution intent inferred from the command text (Priority 1.3).
enum BuildExecutionIntent {
  UNKNOWN
  AUDIT_ONLY
  IMPLEMENT
  FIX
  REVIEW
  EXPLAIN
}

/// A project the Build OS can receive commands for. Project-agnostic tenancy:
/// NOT tied to Restaurant. Foocci is seeded as the default project.
model BuildProject {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  description   String?
  defaultBranch String  @default("main")
  githubOwner   String?
  githubRepo    String?
  isDefault     Boolean @default(false)
  isActive      Boolean @default(true)

  // ── Priority 1.2: registry metadata (no secrets; GitHub fields are metadata
  //    only — never tokens). projectRules/promptContext are high-level notes
  //    used by FUTURE phases; nothing here drives runtime or prompt generation.
  projectRules  Json? // string[] of high-level rules (no secrets)
  promptContext String? @db.Text // freeform context block for later prompt phases
  displayOrder  Int     @default(0)
  category      String? // e.g. "platform", "agency", "experiment"
  riskNotes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commands BuildCommand[]

  @@index([isActive])
  @@map("build_projects")
}

/// Allow-list of operators permitted to issue Build OS commands.
/// Build OS operator identity is SEPARATE from any restaurant customer.
/// `allowedProjectIds` is a JSON string[] of BuildProject ids; an empty array
/// means "all active projects" (resolved in the service layer).
model BuildAuthorizedSender {
  id                String    @id @default(cuid())
  /// Normalized E.164 phone, e.g. "+5511999990000". Unique. (canonical match key)
  phone             String    @unique
  /// Raw value the admin typed (for display); the canonical match uses `phone`.
  rawPhone          String?
  name              String?
  role              String    @default("operator")
  isActive          Boolean   @default(true)
  allowedProjectIds Json      @default("[]") // string[] of BuildProject ids ([] = all)
  notes             String?
  lastUsedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("build_authorized_senders")
}

/// Operating mode for Build OS (Priority 1.4.1).
enum BuildOSMode {
  INTERNAL_ONLY
  PRODUCT
}

/// ADMIN/SYSTEM-level WhatsApp channel for Build OS — the Foocci/Futi Admin
/// command line. Completely independent of any restaurant/tenant: it has NO
/// restaurantId. Diego/CEO sends internal commands here and names the target
/// (restaurant/agent/area) inside the message. Credentials are stored encrypted
/// and never tied to a Restaurant row. Singleton-ish (most recent row wins).
model BuildOSMasterWhatsAppConfig {
  id            String   @id @default(cuid())
  /// Evolution instance dedicated to the Admin channel, e.g. "futi-admin".
  instanceName  String   @unique
  /// Evolution server base URL, e.g. https://evo.example.com
  baseUrl       String
  /// AES-256-GCM encrypted Evolution API key/token. Never returned in full.
  apiKey        String
  /// AES-256-GCM encrypted webhook secret used to verify inbound webhook signatures.
  webhookSecret String
  isEnabled     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("buildos_master_whatsapp_config")
}

/// Singleton-ish runtime configuration for Build OS, editable from the admin UI
/// WITHOUT touching env vars / Railway. Env vars remain bootstrap/emergency only.
/// There is normally exactly one active row (the most recent is authoritative).
model BuildOSConfig {
  id                               String      @id @default(cuid())
  isEnabled                        Boolean     @default(false)
  mode                             BuildOSMode @default(INTERNAL_ONLY)
  /// Optional override for the default project; falls back to BuildProject.isDefault.
  defaultProjectId                 String?
  /// When true, env BUILD_OS_AUTHORIZED_PHONES is allowed as a fallback even when
  /// DB senders exist. When false, DB authorized senders are the sole source once any exist.
  allowEnvAuthorizedPhonesFallback Boolean     @default(true)

  /// ── Build OS WhatsApp Master/Admin channel (separate from restaurant WhatsApp) ──
  /// The Evolution instanceName dedicated to internal Build OS commands (Diego/CEO).
  /// NULL = no Master channel configured yet → diagnostics must say "não configurado"
  /// and must NOT assume a restaurant instance (e.g. sushicazza) is the Build OS channel.
  whatsappInstanceName                    String?
  /// Whether the Master channel is active. When false, Build OS won't process commands
  /// even from the configured instance.
  whatsappEnabled                         Boolean @default(false)
  /// EMERGENCY/TEMPORARY only: allow restaurant instances to act as the Build OS channel.
  /// Default OFF — restaurant WhatsApp must never be the Build OS command channel unless
  /// this is explicitly enabled (and the UI labels it "fallback legado — não recomendado").
  legacyRestaurantInstanceFallbackEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("build_os_config")
}

/// A single command received from an authorized operator. Raw + parsed parts are
/// stored; classification (risk/task) defaults to UNKNOWN in Priority 1.1.
model BuildCommand {
  id            String                    @id @default(cuid())
  projectId     String? // optional until project resolution is implemented
  senderPhone   String // normalized E.164
  senderName    String?
  sourceChannel BuildCommandSourceChannel @default(WHATSAPP)
  rawMessage    String                    @db.Text
  commandPrefix String // "/build" | "/cmd" | "/prompt"
  commandText   String                    @db.Text // raw message minus the prefix
  status        BuildCommandStatus        @default(RECEIVED)
  riskLevel     BuildRiskLevel            @default(UNKNOWN)
  taskType      BuildTaskType             @default(UNKNOWN)
  receivedAt    DateTime                  @default(now())

  // ── Priority 1.3: deterministic (non-LLM) classification metadata ──
  executionIntent           BuildExecutionIntent @default(UNKNOWN)
  targetArea                String? // e.g. "checkout", "whatsapp", "waiter", "buildos", "unknown"
  requiresHumanConfirmation Boolean              @default(true)
  classificationSummary     String? // short human-readable summary

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        BuildProject?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events         BuildCommandEvent[]
  promptVersions BuildPromptVersion[]

  @@index([status])
  @@index([senderPhone])
  @@index([projectId])
  @@index([createdAt])
  @@map("build_commands")
}

/// Append-only audit log for a command's lifecycle.
model BuildCommandEvent {
  id        String   @id @default(cuid())
  commandId String
  type      String // RECEIVED | CONFIRMATION_SENT | ...
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  command BuildCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([commandId])
  @@map("build_command_events")
}

/// Diagnostic trace of EVERY Build OS webhook attempt (Priority 1.4.1 debug).
/// Persisted so the admin can confirm — without console/Railway — whether the
/// REAL Evolution webhook reached the Build OS branch and what happened. Holds
/// no secrets; the phone is stored masked. Best-effort write; never blocks the
/// webhook. Trimmed by keeping only recent rows in the admin view.
model BuildWebhookTrace {
  id             String   @id @default(cuid())
  /// Evolution instanceName the event arrived on — lets diagnostics show whether a
  /// /build came from the Build OS Master channel or a restaurant instance.
  instanceName   String?
  /// Masked phone (e.g. "+55***0692"). Never the full number.
  maskedPhone    String?
  /// Full normalized E.164 sender, stored SERVER-SIDE ONLY so the admin can
  /// authorize an unauthorized /build sender by traceId without the full number
  /// ever leaving the backend. NEVER returned in any API/view — masked only.
  rawPhone       String?
  prefixDetected String?
  configEnabled  Boolean?
  configSource   String?
  authorized     Boolean?
  fromMe         Boolean?
  commandCreated Boolean  @default(false)
  promptDrafted  Boolean  @default(false)
  responseSent   Boolean  @default(false)
  shortCircuited Boolean  @default(false)
  failureReason  String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("build_webhook_traces")
}

/// A stored, versioned prompt draft for a command (Priority 1.4).
/// Generated deterministically from a TEMPLATE — never by an LLM in this phase.
/// Stored internally only; the full text is visible solely in the admin area.
model BuildPromptVersion {
  id                  String                 @id @default(cuid())
  commandId           String
  versionNumber       Int                    @default(1)
  promptText          String                 @db.Text
  promptKind          BuildPromptKind        @default(TECHNICAL_DRAFT)
  generatedBy         BuildPromptGeneratedBy @default(TEMPLATE)
  /// When this version was produced by an AJUSTAR reply, the operator's instruction.
  revisionInstruction String?                @db.Text
  createdAt           DateTime               @default(now())

  command BuildCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@unique([commandId, versionNumber])
  @@index([commandId])
  @@map("build_prompt_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Agency OS — Client Projects + AI Strategy Room
// ─────────────────────────────────────────────────────────────────────────────

enum AgencyProjectStatus {
  DRAFT
  STRATEGY_PENDING
  STRATEGY_DONE
  PROPOSAL_READY
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StrategyRoomStatus {
  PENDING
  DONE
  ERROR
}

/// An internal agency engagement for a restaurant client.
/// Tracks a project from intake → strategy → proposal → execution.
model AgencyProject {
  id           String              @id @default(cuid())
  restaurantId String
  name         String
  objective    String              @db.Text
  audience     String?             @db.Text
  timeline     String?
  budget       String?
  services     Json                @default("[]") // string[] of service names
  notes        String?             @db.Text
  status       AgencyProjectStatus @default(DRAFT)

  strategySession StrategyRoomSession?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([status])
  @@map("agency_projects")
}

/// AI Strategy Room session — 6 specialist perspectives + final synthesis.
/// Generated by StrategyRoomService (rule-based, no external LLM calls).
model StrategyRoomSession {
  id        String             @id @default(cuid())
  projectId String             @unique
  status    StrategyRoomStatus @default(DONE)

  /// Snapshot of brand config + brief used at generation time
  briefSnapshot Json

  /// Individual specialist outputs (SpecialistOutput JSON)
  strategist     Json
  socialMedia    Json
  creative       Json
  paidTraffic    Json
  businessScope  Json
  criticalReview Json

  /// Final cross-specialist synthesis
  synthesis Json

  generatedAt DateTime @default(now())

  project AgencyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("strategy_room_sessions")
}

// ═══════════════════════════════════════════
//  AGENT LIBRARY — Workbench v1 (additive, read-only vs. runtime)
//  The "private university" of the agents. Stores curated technical FORMATION
//  (sources + techniques) per agent. NOT read by any runtime: WaiterBrain,
//  WaiterBrainV2, PromptBuilderService and AIOrderService are untouched.
//  Copyright-safe: store syntheses/techniques, never full reproductions.
// ═══════════════════════════════════════════

enum AgentLibrarySourceType {
  BOOK
  PDF
  ARTICLE
  MANUAL
  TRAINING
  PLAYBOOK
  INTERNAL_NOTE
}

enum AgentLibraryExtractionStatus {
  PENDING
  EXTRACTING
  EXTRACTED
  FAILED
  // v2 deep/chunked extraction states
  EXTRACTING_TEXT
  CHUNKING
  PROCESSING_CHUNKS
  CONSOLIDATING
  PARTIAL
  READY
}

enum AgentLibrarySourceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AgentLibraryTechniqueStatus {
  EXTRACTED
  IN_REVIEW
  ACTIVE
  ARCHIVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
//  WAITER RUNTIME MERGE — versioning + Library→runtime bridge (additive only).
//  Lets curated Library techniques optionally feed the Waiter prompt UNDER
//  governance: a technique only reaches the runtime when it is ACTIVE +
//  runtimeEnabled, and only via an ACTIVE WaiterRuntimeVersion in
//  LIBRARY_ASSISTED mode. Default is always the safe CURRENT runtime.
//  Nothing here touches checkout / payment / Pix / order creation.
// ─────────────────────────────────────────────────────────────────────────────

enum WaiterRuntimeVersionStatus {
  DRAFT
  TESTING
  ACTIVE
  ROLLED_BACK
  ARCHIVED
}

enum WaiterRuntimeMode {
  CURRENT // runtime atual, sem Library no prompt (seguro)
  LIBRARY_ASSISTED // runtime atual + técnicas ACTIVE da Library, versionadas
}

model AgentLibrarySource {
  id               String                       @id @default(cuid())
  agentSlug        String
  title            String
  author           String?
  sourceType       AgentLibrarySourceType       @default(INTERNAL_NOTE)
  category         String?
  description      String?
  // Pasted content (synthesis/notes). Never store full copyrighted works here.
  rawText          String?
  // Optional original file (kept PRIVATE) — reserved for a future upload phase.
  fileUrl          String?
  storageKey       String?
  fileName         String?
  mimeType         String?
  fileSize         Int?
  extractionStatus AgentLibraryExtractionStatus @default(PENDING)
  status           AgentLibrarySourceStatus     @default(DRAFT)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  techniques    AgentLibraryTechnique[]
  file          AgentLibraryFile?
  extractionJob AgentLibraryExtractionJob?

  @@index([agentSlug])
  @@index([status])
  @@map("agent_library_sources")
}

// Original uploaded file for a Library source, stored PRIVATELY in the database.
// Never served by any public route and never exposed via a public URL — read
// back only server-side so the "extract again" retry can re-parse the file.
// 1:1 with the source; cascades on delete.
model AgentLibraryFile {
  id        String   @id @default(cuid())
  sourceId  String   @unique
  fileName  String
  mimeType  String
  fileSize  Int
  data      Bytes
  createdAt DateTime @default(now())

  source AgentLibrarySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("agent_library_files")
}

model AgentLibraryTechnique {
  id              String                      @id @default(cuid())
  agentSlug       String
  sourceId        String
  category        String?
  techniqueName   String
  purpose         String?
  principle       String?
  application     String?
  usageRule       String?
  qualityTest     String?
  goodExample     String?
  badExample      String?
  confidence      Float?
  status          AgentLibraryTechniqueStatus @default(EXTRACTED)
  // ── Curation / runtime governance (additive) ───────────────────────────────
  // A technique only reaches the Waiter prompt when status=ACTIVE AND
  // runtimeEnabled=true AND it is selected by an ACTIVE LIBRARY_ASSISTED version.
  runtimeEnabled  Boolean                     @default(false)
  runtimePriority Int                         @default(0)
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  lastUsedAt      DateTime?
  usageCount      Int                         @default(0)
  qualityScore    Float?
  tags            String? // JSON-encoded string[] (kept as String for SQLite/Postgres parity)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  source             AgentLibrarySource              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  versionAssignments WaiterRuntimeVersionTechnique[]

  @@index([agentSlug])
  @@index([sourceId])
  @@index([status])
  @@index([agentSlug, status, runtimeEnabled])
  @@map("agent_library_techniques")
}

// A versioned snapshot of the Waiter's runtime behaviour. Only ONE version may be
// ACTIVE per scope (agentSlug + restaurantId). When none is ACTIVE, the runtime
// falls back to CURRENT (no Library in the prompt). DRAFT/TESTING never affect a
// real customer. Activation is gated by the Quality gate; rollback is instant.
model WaiterRuntimeVersion {
  id           String                     @id @default(cuid())
  agentSlug    String                     @default("waiter")
  restaurantId String? // null = global default scope
  name         String
  description  String?
  status       WaiterRuntimeVersionStatus @default(DRAFT)
  mode         WaiterRuntimeMode          @default(CURRENT)
  isActive     Boolean                    @default(false)

  // Library governance knobs
  libraryEnabled           Boolean @default(false)
  maxTechniques            Int     @default(6)
  techniqueSelectionPolicy String  @default("PRIORITY_DESC") // how techniques are ordered/picked
  promptPolicy             String? // JSON-encoded prompt assembly knobs
  safetyPolicy             String? // JSON-encoded safety constraints
  metadata                 String? // JSON-encoded free-form metadata

  // Lifecycle / audit
  activatedAt         DateTime?
  activatedBy         String?
  rolledBackAt        DateTime?
  rollbackToVersionId String?

  // Quality gate snapshot
  qualityStatus    String? // PASS | FAIL | UNKNOWN at last gate check
  lastQualityRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  techniques WaiterRuntimeVersionTechnique[]

  @@index([agentSlug, restaurantId, status])
  @@index([agentSlug, isActive])
  @@map("waiter_runtime_versions")
}

// Freezes which techniques belong to a version (so an ACTIVE version is not
// silently changed by later edits to the Library). priority overrides the
// technique's own runtimePriority within this version.
model WaiterRuntimeVersionTechnique {
  id          String   @id @default(cuid())
  versionId   String
  techniqueId String
  priority    Int      @default(0)
  reason      String?
  createdAt   DateTime @default(now())

  version   WaiterRuntimeVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  technique AgentLibraryTechnique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  @@unique([versionId, techniqueId])
  @@index([versionId])
  @@index([techniqueId])
  @@map("waiter_runtime_version_techniques")
}

// ─────────────────────────────────────────────────────────────────────────────
//  AGENT SIMULATION LAB — safe, dry-run behavioural simulation (additive only).
//  Artificial customers interact with an agent (Waiter first) in SIMULATION mode:
//  no order, no Pix, no WhatsApp, no real customer, no runtime mutation. It only
//  records runs, scenarios and OPPORTUNITIES for a human to review/approve.
//  Reusable across agents (Waiter / WhatsApp / CRM / Analytics / future).
// ─────────────────────────────────────────────────────────────────────────────

enum AgentSimulationMode {
  MANUAL
  CRON
  DIAGNOSTIC
}

enum AgentSimulationDriver {
  SERVICE // drives the real deterministic engine (no LLM, no side effects)
  API
  UI_STUB
  PLAYWRIGHT // backlog — real browser UI driver
}

enum AgentSimulationRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum AgentSimulationScenarioStatus {
  PASS
  WARNING
  FAIL
}

enum AgentSimulationSeverity {
  P0
  P1
  P2
  INFO
}

enum AgentSimulationOpportunityType {
  BUG
  MISSED_SALE
  UX_FRICTION
  PROMPT_GAP
  POLICY_GAP
  LIBRARY_OPPORTUNITY
  TRAINING_OPPORTUNITY
}

enum AgentSimulationOpportunityStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  BACKLOGGED
}

model AgentSimulationRun {
  id               String                   @id @default(cuid())
  agentSlug        String
  departmentSlug   String
  restaurantId     String? // null = synthetic/global (no real restaurant)
  mode             AgentSimulationMode      @default(MANUAL)
  driver           AgentSimulationDriver    @default(SERVICE)
  status           AgentSimulationRunStatus @default(RUNNING)
  seed             String?
  startedAt        DateTime                 @default(now())
  finishedAt       DateTime?
  durationMs       Int                      @default(0)
  scenariosTotal   Int                      @default(0)
  scenariosPassed  Int                      @default(0)
  scenariosWarning Int                      @default(0)
  scenariosFailed  Int                      @default(0)
  p0Count          Int                      @default(0)
  p1Count          Int                      @default(0)
  p2Count          Int                      @default(0)
  opportunityCount Int                      @default(0)
  metadata         String? // JSON-encoded
  createdAt        DateTime                 @default(now())

  scenarios     AgentSimulationScenario[]
  opportunities AgentSimulationOpportunity[]

  @@index([agentSlug, createdAt])
  @@map("agent_simulation_runs")
}

model AgentSimulationScenario {
  id                  String                        @id @default(cuid())
  runId               String
  agentSlug           String
  scenarioKey         String
  scenarioType        String
  persona             String
  customerGoal        String
  customerConstraints String? // JSON-encoded
  initialMessage      String
  status              AgentSimulationScenarioStatus @default(PASS)
  severity            AgentSimulationSeverity       @default(INFO)
  score               Int                           @default(0)
  summary             String
  evidence            String? // JSON-encoded
  transcript          String? // JSON-encoded, sanitized
  createdAt           DateTime                      @default(now())

  run           AgentSimulationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  opportunities AgentSimulationOpportunity[]

  @@index([runId])
  @@map("agent_simulation_scenarios")
}

model AgentSimulationOpportunity {
  id             String                           @id @default(cuid())
  runId          String
  scenarioId     String?
  agentSlug      String
  type           AgentSimulationOpportunityType
  severity       AgentSimulationSeverity          @default(INFO)
  title          String
  summary        String
  evidence       String? // JSON-encoded
  recommendation String
  expectedImpact String?
  status         AgentSimulationOpportunityStatus @default(PENDING_REVIEW)
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime                         @default(now())

  run      AgentSimulationRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  scenario AgentSimulationScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([agentSlug, status])
  @@map("agent_simulation_opportunities")
}

// ─────────────────────────────────────────────────────────────────────────────
//  SIMULATION EXAMPLE LIBRARY — sanitized real-conversation patterns (additive).
//  Real conversations are read READ-ONLY, sanitized (PII/secrets stripped) and
//  classified into reusable examples that inspire (never copy) generated
//  scenarios. An example only feeds the generator after a human approves it.
//  Nothing here mutates a real conversation, order, payment or runtime.
// ─────────────────────────────────────────────────────────────────────────────

enum AgentSimulationExampleSourceType {
  REAL_CONVERSATION
  MANUAL
  GENERATED
  IMPORTED
}

enum AgentSimulationExampleStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  BACKLOGGED
}

model AgentSimulationExample {
  id                      String                           @id @default(cuid())
  agentSlug               String
  restaurantId            String?
  sourceType              AgentSimulationExampleSourceType @default(REAL_CONVERSATION)
  sourceId                String? // e.g. the originating Conversation id (for dedupe)
  channel                 String                           @default("UNKNOWN") // WHATSAPP | WEB_AGENT | QR_AGENT | MANUAL | UNKNOWN
  intent                  String
  scenarioType            String
  customerProfile         String?
  // Sanitized ONLY — raw transcript is NEVER stored.
  sanitizedTranscript     String? // JSON-encoded TranscriptTurn[]
  summary                 String
  labels                  String? // JSON-encoded string[]
  riskFlags               String? // JSON-encoded string[] (what was masked)
  qualityNotes            String?
  status                  AgentSimulationExampleStatus     @default(PENDING_REVIEW)
  isApprovedForSimulation Boolean                          @default(false)
  reviewedAt              DateTime?
  reviewedBy              String?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  @@unique([agentSlug, sourceType, sourceId])
  @@index([agentSlug, status])
  @@index([agentSlug, isApprovedForSimulation])
  @@map("agent_simulation_examples")
}

//  Durable state for the WhatsApp AI text-ordering engine (controlled rollout).
//  Additive only — no existing table is altered. Behind feature flag/allowlist;
//  in DRY_RUN_ONLY mode this table is not written from production webhook paths.
// ═══════════════════════════════════════════

model WhatsAppOrderingSession {
  id             String  @id @default(cuid())
  restaurantId   String
  customerId     String? // nullable — anonymous until identified
  conversationId String? // nullable — links to Atendimento conversation when known
  phone          String

  status String @default("ACTIVE") // ACTIVE | AWAITING_CUSTOMER | READY_TO_CONFIRM | AWAITING_PAYMENT | COMPLETED | CANCELLED | HANDOFF_REQUIRED | EXPIRED
  stage  String @default("IDLE") // see WaOrderStage in types.ts

  selectedItems    Json @default("[]")
  unresolvedItems  Json @default("[]")
  missingQuestions Json @default("[]")

  deliveryType  String? // DELIVERY | PICKUP | DINE_IN
  address       Json? // normalized address fragments
  deliveryQuote Json? // resolved delivery fee result

  paymentMethod String? // PIX | CARD | CASH
  paymentStatus String? // PENDING | AWAITING_PIX | PAID | FAILED

  orderDraftId String?
  orderId      String?
  pixPaymentId String?

  mode     String @default("DRY_RUN_ONLY") // DRY_RUN_ONLY | ALLOWLIST_REPLY_ONLY | ALLOWLIST_FULL_TEST
  source   String @default("admin_test") // admin_test | webhook
  metadata Json?

  lastMessageAt DateTime  @default(now())
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([restaurantId, phone, status])
  @@index([conversationId])
  @@map("whatsapp_ordering_sessions")
}

// ═══════════════════════════════════════════
//  WHATSAPP TEXT ORDERING — per-restaurant live activation config
// ═══════════════════════════════════════════
// Moves controlled-rollout activation out of Railway env vars and into the
// admin UI. One row per restaurant. The global env kill switch
// (WHATSAPP_TEXT_ORDERING_ENABLED=false / WHATSAPP_TEXT_ORDERING_PAUSED=true)
// always overrides this row. When no row exists, the runtime falls back to the
// env-based config for backward compatibility. Default is fully OFF/safe.
model WhatsAppTextOrderingConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  enabled Boolean @default(false)

  // DRY_RUN_ONLY | ALLOWLIST_REPLY_ONLY | ALLOWLIST_FULL_TEST
  mode String @default("DRY_RUN_ONLY")

  // PHONE_ALLOWLIST | RESTAURANT_WIDE
  scope String @default("PHONE_ALLOWLIST")

  // E.164 phone strings; matched format-tolerantly at runtime.
  allowlistedPhones Json @default("[]")

  paused Boolean @default(false)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_text_ordering_configs")
}

// ═══════════════════════════════════════════
//  QUALITY CONTROL – audit run history (v2)
// ═══════════════════════════════════════════
// Read-only audit results produced by /admin/quality. Standalone tables (no FK
// into business data): they only store the standardized audit output so Diego
// can open the dashboard and see the latest run, history and open P0/P1/P2.
// Nothing here is written by runtime ordering/payment/CRM paths.

model QualityAuditRun {
  id               String   @id @default(cuid())
  source           String   @default("MANUAL") // MANUAL | CRON | SYSTEM
  globalStatus     String // PASS | WARNING | FAIL
  startedAt        DateTime
  finishedAt       DateTime
  durationMs       Int
  triggeredBy      String? // admin identifier (no PII)
  auditorId        String? // set when a single auditor ran
  countsBySeverity Json // { P0, P1, P2, INFO }
  countsByStatus   Json // { PASS, WARNING, FAIL }
  metadata         Json?
  createdAt        DateTime @default(now())

  findings QualityAuditFinding[]

  @@index([createdAt])
  @@index([globalStatus])
  @@map("quality_audit_runs")
}

model QualityAuditFinding {
  id             String   @id @default(cuid())
  runId          String
  auditorId      String
  status         String // PASS | WARNING | FAIL
  severity       String // P0 | P1 | P2 | INFO
  title          String
  summary        String
  evidence       Json // string[] (sanitized technical evidence only)
  affectedArea   String
  recommendation String
  createdAt      DateTime @default(now())

  run QualityAuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([auditorId, severity])
  @@map("quality_audit_findings")
}

// ═══════════════════════════════════════════
//  AGENT LIBRARY – deep chunked extraction (v2)
// ═══════════════════════════════════════════
// Background, chunked deep extraction so long materials (books/trainings) are
// processed in parts with progress, then consolidated + deduped into final
// AgentLibraryTechnique rows. Additive; the quick single-shot path still works.
// Library remains OFF the runtime — techniques are archived knowledge only.

model AgentLibraryExtractionJob {
  id              String    @id @default(cuid())
  sourceId        String    @unique
  agentSlug       String
  // PENDING | EXTRACTING_TEXT | CHUNKING | PROCESSING_CHUNKS | CONSOLIDATING | EXTRACTED | PARTIAL | FAILED
  stage           String    @default("PENDING")
  processingMode  String    @default("CHUNKED") // SAMPLE | FULL | CHUNKED
  extractionDepth String    @default("DEEP") // QUICK | DEEP
  totalChunks     Int       @default(0)
  processedChunks Int       @default(0)
  failedChunks    Int       @default(0)
  techniquesFound Int       @default(0)
  lastError       String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source     AgentLibrarySource                    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks     AgentLibrarySourceChunk[]
  candidates AgentLibraryChunkTechniqueCandidate[]

  @@index([stage])
  @@index([agentSlug])
  @@map("agent_library_extraction_jobs")
}

model AgentLibrarySourceChunk {
  id                  String   @id @default(cuid())
  jobId               String
  sourceId            String
  chunkIndex          Int
  totalChunks         Int
  charCount           Int
  text                String
  status              String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  techniquesExtracted Int      @default(0)
  retries             Int      @default(0)
  error               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  job AgentLibraryExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, chunkIndex])
  @@index([jobId, status])
  @@map("agent_library_source_chunks")
}

model AgentLibraryChunkTechniqueCandidate {
  id              String   @id @default(cuid())
  jobId           String
  sourceId        String
  agentSlug       String
  chunkIndex      Int
  techniqueName   String
  category        String?
  purpose         String?
  principle       String?
  application     String?
  usageRule       String?
  qualityTest     String?
  goodExample     String?
  badExample      String?
  confidence      Float?
  // Short synthesized evidence only — never long copyrighted excerpts.
  evidenceSnippet String?
  createdAt       DateTime @default(now())

  job AgentLibraryExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("agent_library_chunk_technique_candidates")
}

// ═══════════════════════════════════════════
//  AGENT TRAINING CENTER — 24/7 continuous improvement
// ═══════════════════════════════════════════
// Immutable principle: production brain/config/prompt NEVER changes
// automatically. Human approval is required for every production change.
// allowSideEffects=false is always enforced inside the training runner.

// ── Training run (one execution batch) ───────────────────────────────────────

model AgentTrainingRun {
  id             String    @id @default(cuid())
  agentType      String // AgentType enum value
  restaurantId   String?
  status         String    @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED|CANCELLED
  source         String // REAL_CONVERSATION|AI_SIMULATION|MIXED|REGRESSION
  mode           String? // QUICK|REGRESSION|REAL_CONVERSATION_REPLAY|AI_SIMULATION_BATCH|NIGHTLY|CONTINUOUS
  startedAt      DateTime?
  completedAt    DateTime?
  totalScenarios Int       @default(0)
  passCount      Int       @default(0)
  warnCount      Int       @default(0)
  failCount      Int       @default(0)
  score          Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  scenarios AgentTrainingScenario[]
  proposals AgentImprovementProposal[]

  @@index([agentType, status])
  @@index([restaurantId])
  @@index([createdAt])
  @@map("agent_training_runs")
}

// ── Individual scenario (one simulated or replayed conversation) ─────────────

model AgentTrainingScenario {
  id                   String   @id @default(cuid())
  runId                String
  restaurantId         String?
  source               String // REAL_CONVERSATION|AI_SIMULATION
  sourceConversationId String? // FK to Conversation.id (nullable — simulator scenarios have none)
  title                String
  customerPersona      String?
  goal                 String?
  transcriptJson       Json // array of {role, content, ts} turn objects
  expectedOutcomeJson  Json?
  actualOutcomeJson    Json?
  status               String   @default("PENDING") // PENDING|PASS|WARN|FAIL
  score                Float?
  riskLevel            String?
  failureSummary       String?
  createdAt            DateTime @default(now())

  run         AgentTrainingRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  evaluations AgentTrainingEvaluation[]

  @@index([runId])
  @@index([status])
  @@index([runId, status])
  @@map("agent_training_scenarios")
}

// ── AI evaluation of one scenario ────────────────────────────────────────────

model AgentTrainingEvaluation {
  id               String   @id @default(cuid())
  scenarioId       String
  evaluatorModel   String // e.g. "gpt-4o"
  scoreJson        Json // {conversionScore, clarityScore, safetyScore, frictionScore, menuAccuracyScore, orderCompletionScore, handoffScore, overallScore}
  verdict          String // PASS|WARN|FAIL
  strengths        String?
  weaknesses       String?
  safetyIssues     String?
  conversionIssues String?
  frictionIssues   String?
  recommendation   String?
  createdAt        DateTime @default(now())

  scenario AgentTrainingScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@map("agent_training_evaluations")
}

// ── Improvement proposal (pending human approval) ─────────────────────────────

model AgentImprovementProposal {
  id                 String    @id @default(cuid())
  agentType          String // AgentType enum value
  restaurantId       String?
  sourceRunId        String
  sourceScenarioIds  Json // string[]
  title              String
  problemSummary     String
  rootCause          String?
  proposedChangeType String // PROMPT_PATCH|ROUTING_RULE|STATE_MACHINE_RULE|COPY_CHANGE|MENU_MATCHING_RULE|HANDOFF_RULE|CONFIG_CHANGE
  proposedPatchText  String?   @db.Text
  proposedConfigJson Json?
  riskLevel          String    @default("MEDIUM") // LOW|MEDIUM|HIGH
  expectedImpact     String?
  beforeScore        Float?
  afterScoreEstimate Float?
  status             String    @default("PENDING_APPROVAL") // PENDING_APPROVAL|APPROVED|REJECTED|NEEDS_REVISION|APPLIED_TO_SANDBOX|APPLIED_TO_PRODUCTION
  reviewerNotes      String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sourceRun     AgentTrainingRun    @relation(fields: [sourceRunId], references: [id], onDelete: Cascade)
  brainVersions AgentBrainVersion[]

  @@index([status])
  @@index([agentType, status])
  @@index([sourceRunId])
  @@map("agent_improvement_proposals")
}

// ── Candidate brain/prompt version ───────────────────────────────────────────
// ACTIVE versions must never be changed automatically.

model AgentBrainVersion {
  id               String    @id @default(cuid())
  agentType        String // AgentType enum value
  restaurantId     String?
  versionLabel     String
  status           String    @default("DRAFT") // DRAFT|SANDBOX|ACTIVE|ARCHIVED
  promptText       String?   @db.Text
  configJson       Json?
  sourceProposalId String?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())

  sourceProposal AgentImprovementProposal? @relation(fields: [sourceProposalId], references: [id])

  @@index([agentType, status])
  @@map("agent_brain_versions")
}

// ── Per-agent training configuration ─────────────────────────────────────────

model AgentTrainingConfig {
  id                        String   @id @default(cuid())
  agentType                 String   @unique // one config per agent type (global)
  enableContinuousTraining  Boolean  @default(false)
  maxScenariosPerHour       Int      @default(20)
  useRealConversationMining Boolean  @default(true)
  useAiGeneratedScenarios   Boolean  @default(true)
  minimumScoreThreshold     Float    @default(0.6)
  autoCreateProposals       Boolean  @default(true)
  autoApplySandbox          Boolean  @default(false)
  autoApplyProduction       Boolean  @default(false) // always false in v1
  enabledRestaurantIds      Json     @default("[]") // string[] — empty = all
  autoRunArenaOnCapture     Boolean  @default(false)
  autoDiagnoseOnFailure     Boolean  @default(true)
  smallBatchEveryHours      Int?
  nightlyBatchEnabled       Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@map("agent_training_configs")
}

// ── Waiter Result Evidence — Provas de Resultado / Evidências Comerciais ────────
// Documented, sanitized proof that the Waiter generates commercial value (sales
// conducted, upsell, recovery, friction reduction, qualitative praise, before/
// after). Soft references only (NO FKs): deleting an order/conversation never
// erases an approved proof. NEVER stores PII — excerpts are sanitized BEFORE
// persisting, and public/commercial use requires explicit human approval.
model WaiterResultEvidence {
  id                String    @id @default(cuid())
  restaurantId      String
  agentSlug         String    @default("waiter")
  sourceType        String // ORDER | CONVERSATION | SIMULATION | MANUAL_NOTE | ANALYTICS
  sourceId          String? // soft reference (no FK)
  title             String
  summary           String
  evidenceType      String // SALE_CONVERSION | UPSELL | RECOVERY | FRICTION_REDUCTION | QUALITATIVE_PROOF | BEFORE_AFTER
  valueBefore       Decimal?  @db.Decimal(10, 2)
  valueAfter        Decimal?  @db.Decimal(10, 2)
  incrementalValue  Decimal?  @db.Decimal(10, 2)
  orderValue        Decimal?  @db.Decimal(10, 2)
  customerSegment   String?
  sanitizedExcerpt  String?   @db.Text // ALWAYS sanitized before persisting
  proofScore        Int? // 0–100 subjective strength of the proof
  status            String    @default("DRAFT") // DRAFT | APPROVED | REJECTED | BACKLOG
  isPublicCandidate Boolean   @default(false) // only meaningful after human approval
  reviewedAt        DateTime?
  reviewedBy        String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([restaurantId, evidenceType])
  @@index([restaurantId, status])
  @@index([sourceType, sourceId])
  @@map("waiter_result_evidence")
}

// ── Waiter Training Suggestion — caso real vira PROPOSTA de treinamento ────────
// Each real case (or simulation/library/evidence) becomes a clear, operator-
// reviewable training proposal: problem found, the IDEAL response/behavior, the
// training rule the Waiter would learn, and expected impact. Sanitized excerpts
// only (no PII, no raw transcript). Approving is a HUMAN decision that records an
// "approved learning" — it NEVER changes the real runtime or the live prompt.
model WaiterTrainingSuggestion {
  id                       String    @id @default(cuid())
  restaurantId             String?
  agentSlug                String    @default("waiter")
  sourceType               String // REAL_CONVERSATION | SIMULATION | LIBRARY | RESULT_EVIDENCE
  sourceId                 String? // e.g. the originating AgentSimulationExample id (dedupe)
  status                   String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | BACKLOG
  title                    String
  situationSummary         String
  customerIntent           String
  whatHappened             String
  problemDetected          String
  idealResponse            String
  trainingRule             String
  expectedImpact           String
  suggestedActionType      String // RESPONSE_PATTERN | PAYMENT_RULE | MENU_GUIDANCE | UPSELL_BEHAVIOR | OBJECTION_HANDLING | RESTRICTION_HANDLING | CHECKOUT_GUIDANCE | TONE_ADJUSTMENT
  riskLevel                String    @default("LOW") // LOW | MEDIUM | HIGH
  sanitizedCustomerExcerpt String?
  sanitizedWaiterExcerpt   String?
  technicalDetails         Json?
  reviewedAt               DateTime?
  reviewedBy               String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([agentSlug, sourceType, sourceId])
  @@index([agentSlug, status])
  @@index([restaurantId, status])
  @@map("waiter_training_suggestions")
}

// ── Brain Change Request — governança persistente do Foocci Brain ──────────────
// Every structural change to the Brain becomes a durable record: proposed,
// risk-classified, decided by a HUMAN, and only then applied elsewhere via the
// governed path (test version + Quality Gate). Approving NEVER applies anything.
// String fields (validated in the service) keep the migration light and additive.
model BrainChangeRequest {
  id                  String    @id @default(cuid())
  businessId          String?
  businessType        String    @default("RESTAURANT") // RESTAURANT | AGENCY | GENERIC
  requestedByType     String // CEO | AGENT | SYSTEM | TRAINING_CENTER | BRAIN_DIRECTOR
  requestedById       String?
  target              String // REASONING_RULE | KNOWLEDGE_SCHEMA | AGENT_POLICY | QUALITY_GATE | TRAINING_RULE | AI_ENGINE_ROUTING | KNOWLEDGE_BASE | SIMULATION_RULE | EVIDENCE_RULE
  summary             String
  rationale           String
  proposedChange      Json?
  riskLevel           String    @default("LOW") // LOW | MEDIUM | HIGH | CRITICAL
  status              String    @default("PENDING_APPROVAL") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | BACKLOG | APPLIED | ROLLED_BACK
  requiresQualityGate Boolean   @default(false)
  runtimeImpact       String    @default("NONE") // NONE | TEST_VERSION_ONLY | PRODUCTION
  reviewedBy          String?
  reviewedAt          DateTime?
  decisionReason      String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, riskLevel])
  @@index([target, status])
  @@index([createdAt])
  @@map("brain_change_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
//  CUSTOMER CHANNEL IDENTITY — maps a customer to a per-channel external user id.
//  Channel-agnostic: a customer can have a WhatsApp phone AND an Instagram scoped
//  user id without forcing a phone. Soft references (no FK) follow the existing
//  denormalized pattern; identity rows are additive and never delete a customer.
//  No PII beyond what the channel exposes; raw tokens are NEVER stored here.
// ─────────────────────────────────────────────────────────────────────────────

model CustomerChannelIdentity {
  id                String   @id @default(cuid())
  restaurantId      String
  customerId        String? // soft ref to Customer.id — nullable until linked
  channel           Channel
  externalUserId    String // e.g. Instagram-scoped user id (IGSID) or phone JID
  username          String?
  displayName       String?
  profilePictureUrl String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([restaurantId, channel, externalUserId])
  @@index([restaurantId, channel])
  @@index([customerId])
  @@map("customer_channel_identities")
}

// ─────────────────────────────────────────────────────────────────────────────
//  INSTAGRAM CHANNEL CONFIG — per-restaurant Instagram Direct connection.
//  Tokens are stored ENCRYPTED (AES-256-GCM via lib/crypto); the verify token is
//  stored as a SHA-256 hash (compared, never displayed). Modes gate behaviour:
//    DISABLED      — off.
//    RECEIVE_ONLY  — inbound persisted, NO sending.
//    REPLY_ONLY    — inbound + manual operator reply (no AI).
//    FULL          — reserved for future AI/automation (NOT used in v1).
//  Scope gates who is routed:
//    TEST_ACCOUNT_ONLY — only allowlisted external user ids (safe default).
//    RESTAURANT_WIDE   — all senders for the connected account.
//  Nothing here sends a message, creates an order, or generates a Pix.
// ─────────────────────────────────────────────────────────────────────────────

model InstagramChannelConfig {
  id                         String    @id @default(cuid())
  restaurantId               String    @unique
  enabled                    Boolean   @default(false)
  paused                     Boolean   @default(false)
  mode                       String    @default("DISABLED") // DISABLED|RECEIVE_ONLY|REPLY_ONLY|FULL
  scope                      String    @default("TEST_ACCOUNT_ONLY") // TEST_ACCOUNT_ONLY|RESTAURANT_WIDE
  instagramBusinessAccountId String?
  facebookPageId             String?
  pageAccessTokenEncrypted   String? // AES-256-GCM ciphertext — never plaintext
  verifyTokenHash            String? // SHA-256 hash of the webhook verify token
  appId                      String?
  appSecretRef               String? // name/ref of the env secret, NOT the secret itself
  allowlistedExternalUserIds Json      @default("[]") // string[]
  lastWebhookAt              DateTime?
  lastError                  String?
  metadata                   Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([facebookPageId])
  @@index([instagramBusinessAccountId])
  @@map("instagram_channel_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  META OAUTH STATE — short-lived, single-use CSRF state for the "Conectar com
//  Facebook" flow. Holds the discovered Page candidates (NO tokens) and the
//  encrypted user access token between callback and page selection. Rows expire
//  and are consumed on selection; nothing here sends a message or creates a
//  customer/order/Pix. Tokens are NEVER stored in plaintext.
// ─────────────────────────────────────────────────────────────────────────────

model MetaOAuthState {
  id                       String   @id @default(cuid())
  restaurantId             String
  userId                   String
  state                    String   @unique
  status                   String   @default("PENDING") // PENDING | AWAITING_SELECTION | CONSUMED
  returnPlatform           String? // "instagram" | "facebook" — where to redirect after callback
  userAccessTokenEncrypted String? // AES-256-GCM — short-lived user token, never plaintext
  candidates               Json? // [{ pageId, pageName, instagramBusinessAccountId?, instagramUsername?, hasInstagram }]
  error                    String?
  expiresAt                DateTime
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([expiresAt])
  @@map("meta_oauth_states")
}

// ─────────────────────────────────────────────────────────────────────────────
//  FOOCCI BRAIN — runtime governance (Fase 3-4 do roadmap universal)
//  Standalone (sem FK, como as tabelas de Quality Control): configuram COMO o
//  Brain opera, nunca executam nada sozinhas. Escrita governada:
//  BrainEngineRouting só via ChangeRequestApplier; BrainFreeFormConfig só via
//  freeFormGovernance (escada shadow → allowlist → wide, com gates e rollback).
// ─────────────────────────────────────────────────────────────────────────────

model BrainFreeFormConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // SHADOW_ONLY (default: Brain só observa/loga) | ALLOWLIST | RESTAURANT_WIDE
  mode String @default("SHADOW_ONLY")

  // E.164 phone strings; matched format-tolerantly at runtime.
  allowlistedPhones Json @default("[]")

  paused Boolean @default(false)

  // Piso de confiança para responder ao vivo (abaixo → recepcionista).
  minConfidence Float @default(0.6)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brain_freeform_configs")
}

model BrainEngineRouting {
  id String @id @default(cuid())

  // null = default global (vale para todos os negócios)
  businessId String?

  agentId String

  // CLASSIFY | REASON | JUDGE | GENERATE — por natureza da tarefa
  taskProfile String @default("REASON")

  // OPENAI | CLAUDE | GEMINI
  provider String
  model    String?

  enabled Boolean @default(true)

  // Trilha: qual BrainChangeRequest aprovado aplicou esta linha
  appliedFromChangeRequestId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, agentId, taskProfile])
  @@index([agentId])
  @@map("brain_engine_routing")
}

model BrainShadowLog {
  id             String @id @default(cuid())
  restaurantId   String
  conversationId String

  // Agente que produziu o raciocínio em sombra. Nulo = recepcionista (whatsapp),
  // preservando a semântica das linhas antigas antes da escada por-agente.
  agentId String?

  // DE ONDE a amostra veio. PRODUCTION = houve atendimento/disparo real do outro
  // lado; REPLAY = conversa real reprocessada depois; TRAINING = caso de esteira,
  // destinatário sintético, ninguém do lado de lá.
  //
  // NULO = DESCONHECIDO, de propósito: as linhas gravadas antes deste campo
  // misturam produção e replay e não há como separá-las depois. Nulo nunca é
  // contado como produção — ausência de informação não é informação.
  sampleOrigin String?

  /// Em que DEGRAU a amostra foi colhida.
  ///   SHADOW = o agente NÃO estava respondendo (a sombra clássica);
  ///   LIVE   = o agente estava no degrau alto e este turno foi atendido por ele.
  ///
  /// NULO = linha anterior a 24/08/2026. Foram todas colhidas em sombra por
  /// construção do código, mas a medição do topo não se apoia nisso: ela conta
  /// SÓ o que está marcado 'LIVE'. Os gates de SUBIDA, por sua vez, excluem
  /// 'LIVE' — amostra colhida no topo não pode virar prova para subir ao topo.
  stage String?

  intent        String
  reasoningMode String // LLM | FALLBACK
  engine        String // "OPENAI:gpt-4o-mini" etc. (sem segredos)
  confidence    Float
  coherence     String // PASS | FAIL | NEEDS_REVIEW
  wouldEscalate Boolean

  // Amostra curta da resposta que o Brain TERIA dado (sanitizada, nunca enviada)
  wouldReply String

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, agentId, createdAt])
  @@index([restaurantId, agentId, sampleOrigin, createdAt])
  @@index([restaurantId, agentId, stage, createdAt])
  @@map("brain_shadow_logs")
}

/// Piloto do Agente de CRM — a escada governada do reasoner de CRM, espelhando a
/// do recepcionista (BrainFreeFormConfig) mas por agente. Sem linha = SHADOW_ONLY
/// = produção atual (só sorteio; o agente observa). Promoção/rollback só via
/// governança (gates + confirm). abTestPercent controla o split agente-vs-sorteio
/// entre os destinatários ELEGÍVEIS (allowlist/wide).
model CrmAgentPilotConfig {
  id                String   @id @default(cuid())
  restaurantId      String   @unique
  mode              String   @default("SHADOW_ONLY") // SHADOW_ONLY | ALLOWLIST | RESTAURANT_WIDE
  allowlistedPhones Json     @default("[]")
  paused            Boolean  @default(false)
  minConfidence     Float    @default(0.6)
  abTestPercent     Int      @default(100) // % dos elegíveis que recebem a msg do agente (resto = sorteio/controle)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("crm_agent_pilot_configs")
}

/// Cofre de Experiências — o arquivo PROTEGIDO (sem PII) de interações reais de
/// cliente, por restaurante e por AGENTE. É o insumo que otimiza TODAS as IAs:
/// padrões de pergunta, o que os clientes mais querem, onde o agente escala.
/// Ingerido diariamente das conversas reais (tudo sanitizado). Admin-only. Cada
/// restaurante acumula sua própria experiência — a IA fica mais "veterana" nele.
model RestaurantExperience {
  id             String  @id @default(cuid())
  restaurantId   String
  agentId        String // whatsapp | waiter | crm | ...
  channel        String  @default("WHATSAPP")
  conversationId String?

  intent       String? // intenção classificada (DÚVIDA, PEDIDO, SOCIAL, ...)
  outcome      String // REPLIED | ESCALATED | MENU | FALLBACK
  customerText String // SANITIZADO — sem PII
  agentText    String? // SANITIZADO — sem PII
  confidence   Float?
  coherence    String? // PASS | NEEDS_REVIEW | ...
  tags         String[] // padrões/palavras-chave derivadas

  sourceAt  DateTime // quando a interação real aconteceu
  createdAt DateTime @default(now())

  @@unique([restaurantId, agentId, conversationId, sourceAt], name: "experience_dedup")
  @@index([restaurantId, agentId, sourceAt])
  @@index([restaurantId, intent])
  @@map("restaurant_experiences")
}

/// Memória do anti-mesmice da Oficina. Cada linha é uma COMBINAÇÃO de abordagem
/// (ângulo, luz, lente, abertura…) que já foi gasta numa peça — o Variador
/// consulta as recentes e escolhe outra. Precisa ser tabela, não memória de
/// processo: o app roda em mais de uma instância, então duas peças simultâneas
/// não se enxergariam e o anti-mesmice não valeria nada em produção.
/// Sem PII: guarda a assinatura da abordagem, nunca o conteúdo da peça.
model OficinaAssinatura {
  id String @id @default(cuid())

  /// negócio::agente::assunto — a janela é separada por essas três coisas.
  chave String

  /// A combinação em si, legível: "angulo:45°|luz:janela de manhã".
  assinatura String

  createdAt DateTime @default(now())

  @@unique([chave, assinatura], name: "oficina_assinatura_unica")
  @@index([chave, createdAt])
  @@map("oficina_assinaturas")
}

/// A entrevista de sondagem do SDR, guardada entre um turno e outro.
/// Uma entrevista leva dias e passa por várias conversas; sem tabela, o turno de
/// amanhã cairia noutra instância e a sondagem recomeçaria em branco sem ninguém
/// perceber — que é como o briefing quebrado nasceu.
/// `perguntadas` é o campo que sustenta a regra da casa: falta de RESPOSTA não
/// trava a proposta, falta de PERGUNTA trava. É o registro de que a agência
/// perguntou, não de que o cliente respondeu.
model SdrEntrevista {
  id String @id @default(cuid())

  /// agencia::cliente — duas agências não enxergam a entrevista uma da outra.
  chave String @unique

  /// A ficha do cliente: chave do campo → o que ele respondeu.
  ficha Json @default("{}")

  /// Chaves já PERGUNTADAS. Guardadas mesmo sem resposta — esse é o ponto.
  perguntadas Json @default("[]")

  /// Serviços contratados + de onde vem o insumo de cada um.
  servicos Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@map("sdr_entrevistas")
}

/// Um turno da entrevista do SDR, do jeito que o diário conta.
///
/// ⚠️ NÃO GUARDA CONTEÚDO DE MENSAGEM DE CLIENTE — nem pergunta, nem resposta,
/// nem valor de campo. Só a FORMA e o DESFECHO do turno. A conversa entra como
/// impressão digital (hash) e não como `agencia::cliente`, porque o `clienteId`
/// pode ser um telefone. Quem precisa do conteúdo lê a entrevista; o diário
/// existe para responder "andou ou não andou, e por quê".
///
/// Existe em banco (e não só em memória) por um motivo medido: um diário que
/// zera a cada deploy serve para o minuto seguinte, não para a semana — e é na
/// semana que se decide se o SDR pode falar com gente de verdade.
model SdrDiarioTurno {
  id String @id @default(cuid())

  quando DateTime @default(now())

  /// sha256 curto de `agencia::cliente`. Agrupa sem identificar.
  conversa String

  /// A IA devolveu leitura utilizável neste turno?
  iaRespondeu Boolean

  /// Por que não devolveu: sem_chave | timeout | erro_de_rede | json_invalido |
  /// cortado_por_limite | sem_conteudo | desconhecido. null = respondeu.
  motivoSemIA String?

  /// Quantos campos a IA preencheu / quantos o motor de regras preencheu por ela.
  camposPelaIA    Int @default(0)
  camposPeloMotor Int @default(0)

  /// QUAIS campos o motor preencheu. Só o nome da chave — nunca o valor.
  chavesPeloMotor String[] @default([])

  /// Perguntas que estavam no ar e quantas seguiram sem resposta depois do turno.
  perguntasNoAr     Int @default(0)
  seguemSemResposta Int @default(0)

  /// Havia pergunta no ar e nada foi entendido — a conversa não andou.
  travou Boolean @default(false)

  cobertura  Float   @default(0)
  podePropor Boolean @default(false)

  @@index([quando])
  @@index([conversa, quando])
  @@index([motivoSemIA, quando])
  @@map("sdr_diario_turnos")
}

// ═══════════════════════════════════════════
//  FISCAL — Emissão de Nota Fiscal (NFC-e, modelo 65)
// ═══════════════════════════════════════════
//
// OPCIONAL por loja (enabled). O lojista que já emite no manager dele deixa
// desligado; quem quer emitir direto no Foocci liga aqui. A emissão real passa
// por um GATEWAY fiscal homologado (primeiro: Focus NFe) — o Foocci monta o
// payload e chama a API REST; o gateway assina com o certificado A1 e transmite
// à SEFAZ. Segredos (CSC, tokens do gateway) são gravados CIFRADOS.
model FiscalConfig {
  id           String @id @default(cuid())
  restaurantId String @unique

  // Liga/desliga a emissão pelo Foocci (o "opcional" pedido pelo dono).
  enabled     Boolean @default(false)
  // Emissor: "DISABLED" | "FOCUS_NFE" (espaço p/ outros gateways).
  provider    String  @default("DISABLED")
  // "HOMOLOGACAO" (teste SEFAZ) | "PRODUCAO". Começa sempre em homologação.
  environment String  @default("HOMOLOGACAO")

  // ── Identificação fiscal do emitente ────────────────────────────────────
  cnpj               String?
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  razaoSocial        String?
  nomeFantasia       String?
  cnae               String?
  // CRT: "SIMPLES_NACIONAL" (1) | "SIMPLES_EXCESSO" (2) | "REGIME_NORMAL" (3)
  regimeTributario   String  @default("SIMPLES_NACIONAL")

  // ── Endereço fiscal (estruturado; a SEFAZ exige o código IBGE do município) ─
  fiscalLogradouro    String?
  fiscalNumero        String?
  fiscalComplemento   String?
  fiscalBairro        String?
  fiscalMunicipio     String?
  fiscalMunicipioIbge String? // código IBGE 7 díg (obrigatório na NFC-e)
  fiscalUf            String? // sigla do estado (regras/CSC são por UF)
  fiscalCep           String?

  // ── NFC-e ────────────────────────────────────────────────────────────────
  serie         Int     @default(1)
  proximoNumero Int     @default(1) // próximo nº; incrementado atômico na emissão
  cscId         String? // idToken do CSC (SEFAZ do estado)
  cscToken      String? // CSC (segredo) — GRAVADO CIFRADO

  // ── Credenciais do gateway (GRAVADAS CIFRADAS) ────────────────────────────
  providerTokenHomologacao String?
  providerTokenProducao    String?
  // O A1 é enviado pelo LOJISTA no painel; a Foocci registra a empresa dele no
  // gateway (conta-mãe) e guarda só a referência + validade p/ avisar.
  gatewayCompanyRef        String? // ref da empresa no gateway após subir o certificado
  certificadoNome          String?
  certificadoValidadeAte   DateTime?

  // ── Defaults fiscais (fallback quando o produto/categoria não define) ──────
  defaultNcm     String? // ex.: 21069090 (preparações alimentícias)
  defaultCfop    String? // ex.: 5102
  defaultCsosn   String? // Simples — ex.: 102 ou 500
  defaultCst     String? // Regime normal
  defaultOrigem  String  @default("0")
  defaultUnidade String  @default("UN")

  // ── Saúde da conexão (mostrado no painel) ─────────────────────────────────
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("fiscal_configs")
}

// Livro de notas — um registro por pedido, que caminha pelos status abaixo.
model FiscalDocument {
  id           String @id @default(cuid())
  restaurantId String
  orderId      String @unique

  modelo   String               @default("65") // 65 = NFC-e
  status   FiscalDocumentStatus @default(PENDENTE)
  ambiente String // HOMOLOGACAO | PRODUCAO (snapshot no momento da emissão)

  serie       Int?
  numero      Int?
  chave       String? @unique // chave de acesso (44 díg) quando autorizada
  protocolo   String? // protocolo de autorização da SEFAZ
  providerRef String? // id da nota no gateway (p/ consultar status)

  qrCodeData  String? // conteúdo do QR Code da NFC-e
  urlConsulta String? // URL de consulta pela chave
  xmlUrl      String? // XML autorizado arquivado (S3)
  danfceUrl   String? // DANFCE (PDF) arquivado (S3)

  valorTotal      Decimal? @db.Decimal(10, 2) // snapshot do total
  cpfDestinatario String? // "CPF na nota" (opcional)

  rejeicaoCodigo String? // código da rejeição SEFAZ
  rejeicaoMotivo String? // motivo legível

  emitidaAt                 DateTime?
  canceladaAt               DateTime?
  cancelamentoJustificativa String?
  cancelamentoProtocolo     String?

  attempts  Int     @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([providerRef])
  @@map("fiscal_documents")
}

enum FiscalDocumentStatus {
  PENDENTE // criada, ainda não transmitida
  PROCESSANDO // enviada ao gateway/SEFAZ, aguardando autorização
  AUTORIZADA // autorizada pela SEFAZ
  REJEITADA // rejeitada (ver rejeicaoCodigo/Motivo) — corrigir e reemitir
  CANCELADA // cancelada após autorização
  CONTINGENCIA // emitida offline, pendente de transmissão
  ERRO // falha de transporte/gateway — retryable
}

// ═══════════════════════════════════════════
// CRM DA FOOCCI — a base de prospects da própria Foocci
// ═══════════════════════════════════════════
//
// ⚠️ NÃO CONFUNDA COM O CRM DO PRODUTO.
//
//   • `Customer` + `CRMCampaign` + `CRMContactLedger` = o CRM DO RESTAURANTE,
//     multi-tenant, sobre os clientes que comem no restaurante do lojista.
//   • `SiteLead` + `SiteLeadInteraction` (aqui) = o CRM DA FOOCCI, sem tenant,
//     sobre os DONOS DE RESTAURANTE que a Foocci quer transformar em clientes.
//
// São bases diferentes, com donos diferentes e leis diferentes. Nada aqui pode
// ser cruzado com dado de tenant, e nada de tenant entra aqui.

/// Um contato capturado pela Foocci — hoje pelo formulário do site, amanhã por
/// outras portas de entrada (ver `SiteLeadSource`).
///
/// NÃO é multi-tenant: o contato chega antes de existir restaurante. É a única
/// família de tabelas do schema sem `restaurantId`, e isso é proposital.
///
/// A rota de captura grava AQUI antes de tentar qualquer notificação. Se o
/// e-mail falhar, o contato continua existindo — a notificação é aviso, não
/// cofre. **O admin é o destino; o e-mail é conveniência.**
model SiteLead {
  id          String    @id @default(cuid())
  nome        String
  whatsapp    String
  restaurante String?
  cidade      String?
  tipo        String?
  desafio     String?
  /// Página de onde o formulário foi enviado (ex.: "/site/demonstracao").
  /// LEGADO: era a ÚNICA pista de origem. Continua gravado, mas quem responde
  /// "qual anúncio funciona" são os campos utm* abaixo.
  origem      String?
  /// Código curto (ex.: "A7K2M") que vai DENTRO da mensagem que o lead manda no
  /// WhatsApp. É o que liga um "oi" que chega no número de vendas ao formulário
  /// que a pessoa acabou de preencher — sem ele, chega um "oi" sem contexto.
  ///
  /// Opcional de propósito: se a geração falhar, o lead é gravado assim mesmo.
  /// Perder o código é aceitável; perder o lead nunca é.
  codigo      String?   @unique
  /// null = ainda não notificado; data = quando o aviso saiu.
  notifiedAt  DateTime?
  /// Última falha de notificação, para o alerta carregar a própria evidência.
  notifyError String?
  createdAt   DateTime  @default(now())

  // ── ORIGEM DE VERDADE (primeiro toque) ─────────────────────────────────────
  // Capturados na PRIMEIRA página que o visitante abriu no /site e carregados
  // até o envio do formulário (sessionStorage). Primeiro toque, não último:
  // quem paga o anúncio é quem trouxe a pessoa, mesmo que ela navegue depois.
  /// utm_source normalizado (facebook, instagram, google, direct…).
  utmSource   String?
  /// utm_medium (cpc, social, organic…).
  utmMedium   String?
  /// utm_campaign — o nome da campanha no Gerenciador de Anúncios.
  utmCampaign String?
  /// utm_content — normalmente o anúncio/criativo específico.
  utmContent  String?
  /// utm_term — palavra-chave, quando houver.
  utmTerm     String?
  /// fbclid / gclid — o clique identificado do anunciante, quando presente.
  clickId     String?
  /// Página de ENTRADA no site (com query), que pode não ser a do formulário.
  landingPath String?
  /// document.referrer do primeiro toque (host + caminho, sem query).
  referrer    String?

  // ── PORTA DE ENTRADA ───────────────────────────────────────────────────────
  /// Por onde este contato entrou na base. Hoje só existe o formulário do site;
  /// o campo existe para a base receber outras portas SEM virar remendo.
  fonte          SiteLeadSource @default(FORMULARIO_DEMONSTRACAO)
  /// Só dígitos, com DDI 55 — a chave humana do contato. Índice (não único) de
  /// propósito: uma restrição de unicidade poderia FAZER UM LEAD SE PERDER numa
  /// corrida de dois envios simultâneos, e perder lead é pior que duplicar.
  whatsappDigits String?
  /// Quantas vezes esta mesma pessoa preencheu um formulário. Reenvio não cria
  /// contato novo — vira interação REENVIO_FORMULARIO no histórico.
  submissions    Int            @default(1)

  // ── FUNIL COMERCIAL ────────────────────────────────────────────────────────
  // Estado é DADO (enum), nunca texto livre: é o que o funil conta e o que o
  // agente SDR vai ler. Toda mudança gera uma SiteLeadInteraction — a etapa
  // atual é cache do último evento, e o histórico é a fonte da verdade.
  stage          SiteLeadStage @default(NOVO)
  /// Quando a etapa atual passou a valer.
  stageChangedAt DateTime      @default(now())
  /// Quem mudou por último ("admin", "sdr-agent", …). Espelha o último evento.
  stageChangedBy String?

  // ── LGPD: CONSENTIMENTO E SILÊNCIO ─────────────────────────────────────────
  // O que faltava, escrito em `docs/sdr-foocci-desenho.md`: preencher o
  // formulário BASTA juridicamente, mas não havia **prova** nem **freio**.
  // Estes quatro campos são a prova e o freio; quem os lê é o portão do SDR
  // (`src/services/foocci-sdr/LeadContactSafety.ts`).
  //
  /// Quando esta pessoa entregou os dados por vontade própria. Nulo em contato
  /// da primeira safra — e, desde 08/09/2026, **nulo é bloqueio**: o portão NÃO
  /// usa mais `createdAt` no lugar. Este comentário prometia essa compensação e
  /// ela deixou de existir; a promessa sai junto, e não fica de herança.
  /// Consequência declarada: lead do site anterior a 14/08/2026 não é abordado
  /// pelo portão de consentimento. Errar aqui é errar para o lado de não falar.
  /// NUNCA é preenchido "de ofício": consentimento sem ato é consentimento falso.
  consentAt            DateTime?
  /// Qual versão da política estava no ar naquele momento. Sem isso não há como
  /// dizer A QUE a pessoa consentiu — a política muda, o aceite não volta atrás.
  consentPolicyVersion String?
  /// Quando pediu para parar. Preenchido = **silêncio para sempre, todos os
  /// canais**. É terminal de propósito: não existe "opt-out por 30 dias" aqui.
  optOutAt             DateTime?
  /// Por onde o pedido de silêncio chegou ("whatsapp", "email", "admin").
  /// Guardrail 6: quem auditar precisa saber de onde veio, não só que existe.
  optOutCanal          String?

  // ── QUEM ATENDE AGORA (v3, Sala de Vendas) ─────────────────────────────────
  //
  // A pergunta que a base não sabia responder: "de quem é este lead NESTE
  // momento?". Sem ela não existe fila "sem responsável", não existe "meus
  // leads", e não existe handoff — dois atendentes podem responder o mesmo lead
  // sem nenhum dos dois saber do outro.
  //
  /// Estado da responsabilidade. Muda por escrita CONDICIONAL, nunca por
  /// leitura-seguida-de-escrita: ver `src/services/salaDeVendas/responsavel.ts`.
  atendidoPor     LeadAtendidoPor @default(NINGUEM)
  /// A pessoa que assumiu, quando `atendidoPor = HUMANO`.
  atendenteUserId String?
  /// Desde quando o responsável atual responde. É o relógio do SLA de handoff.
  atendenteDesde  DateTime?
  /// Por que a IA pediu gente. Sem motivo, quem pega não sabe o que fazer.
  motivoDoPedido  String?

  /// Última vez que a FOOCCI falou com esta pessoa (interação de saída).
  /// null = ninguém abordou ainda. É o filtro "quem falta abordar" do SDR.
  lastContactedAt   DateTime?
  /// Última interação de qualquer tipo — para ordenar a base por movimento.
  lastInteractionAt DateTime?

  // ── SALA DE VENDAS: o que a LISTA precisa filtrar e ordenar ────────────────
  //
  // Estes campos moram aqui, e não na ficha, por um motivo só: a coluna do meio
  // da Sala ordena e filtra por eles a cada carregamento. Buscá-los numa tabela
  // ligada obrigaria um `join` por lead em toda listagem — e a lista é a tela
  // que mais abre no dia de quem trabalha aqui.
  //
  /// E-mail, quando a pessoa deu. O WhatsApp continua sendo a chave.
  email String?

  /// A nota de qualificação. **`null` significa "ninguém mediu"**, e é diferente
  /// de zero, que significa "medido e não qualifica". Escrever zero no lugar de
  /// null aqui esconderia a fila inteira de quem nunca foi avaliado.
  score       Int?
  scoreAt     DateTime?
  /// A leitura do número. `null` = não classificado — nunca FRIO por omissão.
  temperatura LeadTemperatura?

  /// O compromisso mais próximo com esta pessoa. É o que sustenta a regra
  /// "nenhum lead em aberto sem próxima ação" — e a fila de follow-up vencido
  /// é literalmente `proximaAcaoEm < agora`.
  proximaAcaoEm   DateTime?
  proximaAcaoNota String?

  /// Marcado à mão pelo gerente. Fila "Prioritários".
  prioritario Boolean @default(false)

  /// Etiquetas livres do time comercial.
  tags String[] @default([])

  /// Quando a pessoa respondeu pela primeira vez. Congela o tempo de primeira
  /// resposta: sem ele o indicador teria de ser recalculado varrendo mensagens.
  primeiraRespostaEm DateTime?
  /// Prazo do SLA vigente. Vencido e sem resposta = fila de SLA estourado.
  slaVenceEm         DateTime?

  /// Espelho da última mensagem, para a lista não precisar buscar a conversa.
  /// É CACHE: a verdade são as linhas de `LeadMensagem`.
  ultimaMensagemEm     DateTime?
  ultimaMensagemTexto  String?
  ultimaMensagemDeQuem DirecaoDaMensagem?
  /// Quantas mensagens do lead ainda não foram lidas por gente.
  naoLidas             Int                @default(0)

  /// Só preenchido em PERDIDO. O motivo é ESTRUTURADO de propósito: motivo em
  /// texto livre não vira relatório, e "o que mais nos faz perder" é a pergunta
  /// que paga a próxima decisão de produto.
  motivoPerdaId String?

  interactions          SiteLeadInteraction[]
  mensagens             LeadMensagem[]
  tarefas               LeadTarefa[]
  compromissos          LeadCompromisso[]
  propostas             LeadProposta[]
  handoffs              LeadHandoff[]
  fatoresDoScore        LeadScoreFator[]
  avaliacoes            LeadAvaliacaoQA[]
  avaliacoesSupervisora SupervisoraAvaliacao[]
  cadencias             LeadCadencia[]
  qualificacao          LeadQualificacao?
  motivoPerda           MotivoDePerda?         @relation(fields: [motivoPerdaId], references: [id])
  atendente             InternalUser?          @relation("LeadAtendente", fields: [atendenteUserId], references: [id])

  @@index([createdAt])
  @@index([atendidoPor, stage])
  @@index([atendenteUserId])
  @@index([notifiedAt])
  @@index([stage, createdAt])
  @@index([utmCampaign])
  @@index([whatsappDigits])
  @@index([lastContactedAt])
  @@index([optOutAt])
  // ── Índices da Sala de Vendas ──────────────────────────────────────────────
  /// A ordenação padrão da lista de conversas: quem falou por último, no topo.
  @@index([ultimaMensagemEm])
  /// A fila de follow-up vencido, e o alerta de "sem próxima ação".
  @@index([proximaAcaoEm])
  /// A fila de SLA estourado, do painel do gerente.
  @@index([slaVenceEm])
  /// O Kanban: cada coluna é uma etapa, ordenada por movimento.
  @@index([stage, ultimaMensagemEm])
  /// "Meus atendimentos", ordenado — o SDR abre esta lista o dia inteiro.
  @@index([atendenteUserId, ultimaMensagemEm])
  @@index([temperatura])
  @@index([prioritario])
  @@index([motivoPerdaId])
}

/// As etapas do funil comercial da Foocci. ORDEM IMPORTA: a taxa de conversão
/// entre etapas é calculada na sequência declarada aqui.
///
/// PERDIDO é terminal e fica FORA da sequência — um contato perdido SAIU do
/// funil, não avançou nele. Contá-lo como etapa faria a conversão mentir.
///
/// NUTRICAO também fica fora da sequência, e é uma distinção que custa dinheiro
/// quando não existe: "não é agora" não é "não". Jogar os dois no mesmo balde
/// apaga a lista de quem voltaria a conversar em três meses.
enum SiteLeadStage {
  NOVO // chegou, ninguém falou com ele ainda
  /// Contato frio conferido e elegível, esperando a vez na base contínua.
  ///
  /// ⚠️ NÃO é o mesmo que NOVO. `NOVO` é quem chegou até nós (formulário, site,
  /// WhatsApp). Este é quem NÓS fomos buscar e ainda não abordamos. Misturar os
  /// dois faria a fila do dia disputar espaço com quem já pediu contato — e
  /// quem pediu contato tem sempre precedência sobre quem não pediu.
  DISPONIVEL_PARA_PROSPECCAO
  PRIMEIRO_CONTATO // alguém (ou o TA) mandou a primeira mensagem — é o "abordado"
  /// ⭐ ELE FALOU DE VOLTA. O estágio que faltava, e faltava caro.
  ///
  /// Sem ele, um lead que respondeu à abordagem ficava em PRIMEIRO_CONTATO junto
  /// com os que nunca disseram nada — e a diferença entre esses dois é a única
  /// coisa que importa no dia seguinte a um disparo. EM_QUALIFICACAO não servia:
  /// exige que a descoberta tenha COMEÇADO, e há um vão real entre "respondeu" e
  /// "estamos qualificando" onde o lead esfria sem aparecer em lista nenhuma.
  RESPONDEU
  EM_QUALIFICACAO // respondeu e a descoberta está em andamento
  QUALIFICADO // tem perfil, dor e interesse — vale tempo humano
  DEMO_AGENDADA // marcou a demonstração
  DEMO_REALIZADA // a demonstração aconteceu
  PROPOSTA_ENVIADA // recebeu preço e condições por escrito
  EM_NEGOCIACAO // está discutindo condição, prazo ou desconto
  GANHO // virou cliente assinante
  PERDIDO // terminal — motivo estruturado é obrigatório
  NUTRICAO // não é agora, mas pode ser depois. NÃO é perda
}

/// Quão quente está o lead. Separado do `score` de propósito: o número é o
/// cálculo, a temperatura é a leitura. Quem opera decide pela leitura; quem
/// ajusta a régua mexe no número.
///
/// **Não existe valor "frio" por omissão.** Lead sem classificação tem
/// `temperatura = null`, e a tela escreve "não classificado". Chutar FRIO em
/// quem ninguém avaliou é o mesmo erro de escrever zero quando a resposta é
/// "não sei" — e este erra para o lado caro: arquiva quem ninguém olhou.
enum LeadTemperatura {
  PRIORIDADE_MAXIMA
  QUENTE
  MORNO
  FRIO
  DESQUALIFICADO
  NUTRICAO
}

/// Por onde o contato entrou na base da Foocci.
enum SiteLeadSource {
  FORMULARIO_DEMONSTRACAO // /site/demonstracao e variantes do formulário
  AGENDAMENTO // marcou horário em /site/agendar
  WHATSAPP_DIRETO // chamou no WhatsApp comercial
  INDICACAO // veio por indicação de alguém
  MANUAL // cadastrado à mão no admin
  INSTAGRAM // veio da conta do Instagram
  FACEBOOK // veio da página do Facebook
  CAMPANHA_PAGA // anúncio pago; a peça exata mora nos campos utm*
  LISTA_PROSPECCAO // saiu de um lote de prospecção nosso, não procurou a gente
  IMPORTACAO // entrou por importação autorizada de uma base
  OUTRO
}

/// O que aconteceu com um contato. Append-only.
///
/// É o espelho comercial do `CRMContactLedger`: quem tocou, quando, em que
/// direção e com que resultado. **Mudança de etapa é UM tipo de interação**, não
/// uma tabela separada — assim o SDR lê UMA linha do tempo, não duas.
///
/// Nada no código atualiza nem apaga uma interação. O único apagamento possível
/// é em cascata, quando o contato inteiro é excluído (direito de eliminação).
model SiteLeadInteraction {
  id        String                  @id @default(cuid())
  leadId    String
  lead      SiteLead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tipo      SiteLeadInteractionType
  /// Preenchidos só em MUDANCA_ETAPA. `fromStage` null = evento de criação.
  fromStage SiteLeadStage?
  toStage   SiteLeadStage?
  /// Quem fez. "admin" (tela), "sistema" (captura), "sdr-agent" (futuro).
  actor     String
  /// Texto curto: motivo da perda, resumo da conversa, o que foi dito.
  nota      String?
  /// `true` = o lead NUNCA vê. Nota interna que vaza para o canal externo é o
  /// pior defeito possível nesta tela, e a trava é aqui, não na cor do campo.
  interna   Boolean                 @default(false)
  createdAt DateTime                @default(now())

  @@index([leadId, createdAt])
  @@index([createdAt])
  @@index([tipo, createdAt])
}

/// Tipos de interação. `direcaoDeSaida` em `foocciCrmFunnel.ts` diz quais contam
/// como "a Foocci falou com a pessoa" (e portanto mexem em `lastContactedAt`).
/// Quem está atendendo o lead AGORA.
///
/// Não é "quem já falou com ele" — é quem responde pela próxima mensagem. Essa
/// distinção é a que sustenta as filas da Sala de Vendas: "aguardando humano" é
/// um lead que a IA devolveu e que ninguém pegou, e ele é invisível em qualquer
/// lista organizada por etapa do funil.
enum LeadAtendidoPor {
  /// Ninguém assumiu. Cai na fila "Sem responsável", que é visível e cobrada.
  NINGUEM

  /// O Agente SDR IA está conduzindo.
  IA

  /// Uma pessoa assumiu. A IA silencia ANTES do próximo envio.
  HUMANO

  /// A IA devolveu e pediu gente. Fila mais importante da tela: uma venda em
  /// queda livre que não aparece em nenhuma outra lista.
  AGUARDANDO_HUMANO
}

enum SiteLeadInteractionType {
  CAPTURA // entrou na base
  REENVIO_FORMULARIO // a mesma pessoa preencheu de novo
  MUDANCA_ETAPA // andou (ou voltou) no funil
  MENSAGEM_ENVIADA // saída: WhatsApp/e-mail que a Foocci mandou
  RESPOSTA_RECEBIDA // entrada: a pessoa respondeu
  LIGACAO // saída: telefonema
  REUNIAO // saída: demonstração/reunião realizada
  NOTA // observação livre, sem contato
  ASSUMIU_HUMANO // uma pessoa pegou a conversa; a IA silencia
  DEVOLVEU_PARA_IA // a pessoa devolveu, com objetivo escrito
  PEDIU_HUMANO // a IA parou e pediu gente
  NOTA_INTERNA // nota que o lead NUNCA vê
}

// ═══════════════════════════════════════════
// AGENDA COMERCIAL — horários do CEO para chamadas de demonstração (/site/agendar)
// ═══════════════════════════════════════════

/// Um horário que o CEO abriu para uma chamada curta de apresentação do produto.
///
/// Como o SiteLead, NÃO é multi-tenant: quem agenda ainda não é cliente.
/// Slot livre = `bookedAt` null. A reserva é transacional (updateMany condicional)
/// para dois visitantes nunca levarem o mesmo horário.
model MeetingSlot {
  id          String   @id @default(cuid())
  /// Início da chamada (UTC no banco; exibido em America/Sao_Paulo).
  startsAt    DateTime
  durationMin Int      @default(20)

  // ── Reserva (null = livre) ──
  bookedAt    DateTime?
  nome        String?
  whatsapp    String?
  restaurante String?

  /// Notificação ao CEO — mesmo contrato do SiteLead: gravar antes, avisar depois.
  notifiedAt  DateTime?
  notifyError String?
  createdAt   DateTime  @default(now())

  @@index([startsAt])
  @@index([bookedAt])
}

// ═══════════════════════════════════════════
// VÍDEOS DE DEMONSTRAÇÃO — conteúdo da página /site/demonstracao
// ═══════════════════════════════════════════

/// Um vídeo de demonstração do produto (YouTube), gerenciado pelo admin.
/// `published` false = rascunho: não aparece no site.
model DemoVideo {
  id          String   @id @default(cuid())
  title       String
  description String?
  /// URL do YouTube (watch, youtu.be ou shorts) — o embed é derivado dela.
  youtubeUrl  String
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([published, sortOrder])
}

// ═══════════════════════════════════════════
//  BILLING DA PLATAFORMA — assinatura de plano da PRÓPRIA Foocci
// ═══════════════════════════════════════════

/// Uma contratação de plano por um restaurante-cliente da Foocci.
///
/// NÃO é multi-tenant no sentido usual: como o SiteLead, nasce ANTES de o
/// restaurante existir no sistema (a venda é 1:1 — o CEO fecha no WhatsApp e o
/// restaurante pode ser provisionado depois). Por isso `restaurantId` é opcional.
///
/// O fluxo V1 (assistido) anda por status: DRAFT → AGUARDANDO_ACEITE (link
/// enviado) → ACEITO (termo registrado com trilha) → AGUARDANDO_PAGAMENTO
/// (link MP criado) → ATIVA (webhook confirmou) → INADIMPLENTE/CANCELADA.
model PlanSubscription {
  id               String                 @id @default(cuid())
  restaurantId     String?
  customerName     String
  customerCnpj     String?
  customerEmail    String?
  customerWhatsapp String
  plan             Plan
  cycle            BillingCycle
  /// Centavos, como todo dinheiro nesta casa.
  priceCents       Int
  status           PlanSubscriptionStatus @default(DRAFT)

  /// Token do link público de aceite (/contratar/[token]). Único e não adivinhável.
  acceptToken String @unique

  /// Trilha do aceite — sem ela o aceite não vale nada numa disputa.
  termsVersion    String?
  termsAcceptedAt DateTime?
  termsAcceptedIp String?
  termsAcceptedBy String?

  /// Vínculo com o Mercado Pago Assinaturas (preapproval).
  mpPreapprovalId String?
  mpInitPoint     String?

  /// ── Regra dos 50% do primeiro mês ─────────────────────────────────────────
  /// `priceCents` é o valor CHEIO do ciclo (o que sai do cartão a cada renovação).
  /// `firstChargeCents` é o que sai na PRIMEIRA cobrança. O preapproval do Mercado
  /// Pago nasce com o valor da primeira cobrança e é elevado ao valor cheio depois
  /// que a primeira cobrança é confirmada — `fullAmountSyncedAt` é o carimbo desse
  /// degrau. Sem esse carimbo, um webhook reenviado tentaria elevar duas vezes.
  firstChargeCents   Int?
  fullAmountSyncedAt DateTime?
  /// Falha ao elevar o valor no MP. Nunca fica em silêncio: o cliente seguiria
  /// pagando metade para sempre e ninguém saberia (guardrail 6).
  priceSyncError     String?

  /// ── Dados do checkout self-service (a conta que será criada ao pagar) ─────
  /// Ficam AQUI, e não em um Restaurant criado antes da hora, para que ninguém
  /// que não pagou ocupe um slug. A senha viaja como hash bcrypt — o texto puro
  /// nunca é persistido.
  signupRestaurantName    String?
  signupSlug              String?
  signupOwnerPasswordHash String?
  /// Idempotência do POST público: o mesmo formulário reenviado (duplo clique,
  /// F5, retry de rede) reaproveita a assinatura em vez de criar outra — e, com
  /// ela, outra cobrança recorrente no Mercado Pago.
  signupIdempotencyKey    String?   @unique
  /// Carimbo da costura pagamento → conta criada.
  provisionedAt           DateTime?
  /// Motivo da falha de criação da conta APÓS pagamento confirmado. É o caso
  /// "o cliente pagou e a conta não nasceu" — o pior deste domínio. Persistido
  /// com a evidência para o operador agir; nunca engolido.
  provisionError          String?

  activatedAt DateTime?
  canceledAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  restaurant Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  invoices   PlanInvoice[]

  @@index([status])
  @@index([mpPreapprovalId])
  @@map("plan_subscriptions")
}

enum BillingCycle {
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum PlanSubscriptionStatus {
  DRAFT
  AGUARDANDO_ACEITE
  ACEITO
  AGUARDANDO_PAGAMENTO
  ATIVA
  INADIMPLENTE
  CANCELADA
}

/// Uma cobrança confirmada da assinatura → uma NFS-e a emitir.
///
/// Reusa FiscalDocumentStatus dos documentos dos lojistas: PENDENTE aqui também
/// significa "criada e ainda não transmitida" — inclusive enquanto o CNPJ da
/// Foocci não puder emitir (MEI de vestuário; ver docs/juridico/). A fila
/// acumula e emite tudo quando a SLU-ME sair. Nada se perde.
model PlanInvoice {
  id             String               @id @default(cuid())
  subscriptionId String
  amountCents    Int
  /// Competência da cobrança, ex. "2026-08".
  referenceMonth String
  status         FiscalDocumentStatus @default(PENDENTE)
  /// Referência (ref) usada no Focus NFe — idempotência da emissão.
  providerRef    String?              @unique
  pdfUrl         String?
  xmlUrl         String?
  errorMessage   String?
  /// ID do pagamento no MP que originou esta cobrança (dedupe de webhook).
  mpPaymentId    String?              @unique
  emittedAt      DateTime?
  createdAt      DateTime             @default(now())

  subscription PlanSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@map("plan_invoices")
}

// ═══════════════════════════════════════════
//  COFRE DE CREDENCIAIS DE INFRAESTRUTURA (Admin → Credenciais)
// ═══════════════════════════════════════════
//
// Onde o token do Railway (e de qualquer outro serviço de infraestrutura) fica
// guardado UMA VEZ, em vez de ser regerado a cada necessidade.
//
// Regras que a modelagem sustenta — não são só convenção:
//   • `tokenEncrypted` é AES-256-GCM (mesma ENCRYPTION_KEY do Meta/Evolution).
//     NÃO existe coluna com o valor em texto puro; não há onde vazar por engano.
//   • `last4` é gravado no ato do save justamente para que LISTAR não precise
//     descriptografar. Abrir a tela nunca toca no segredo.
//   • Um token de conta do Railway é chave-mestra (lê e altera TODO segredo do
//     projeto). Por isso toda LEITURA para uso grava linha em
//     InfraCredentialAccess: sem trilha, o risco é cego.

/// Uma credencial de infraestrutura guardada no cofre. Uma linha por serviço.
model InfraCredential {
  id String @id @default(cuid())

  /// Identificador do serviço em minúsculas, ex. "railway". Único por construção.
  service String @unique
  /// Nome que o CEO lê na tela, ex. "Railway (deploy e variáveis)".
  label   String

  /// AES-256-GCM. Nunca sai daqui em texto puro por nenhuma rota.
  tokenEncrypted String
  /// Últimos 4 caracteres — o único pedaço que a tela pode mostrar.
  last4          String
  /// Tamanho do token, para conferir "colei inteiro?" sem revelar nada.
  tokenLength    Int

  /// Quem salvou (o admin é único hoje; o campo já existe para depois).
  savedBy String?

  /// Resultado da validação feita NO ATO DE SALVAR:
  /// "valid" | "unknown" (não deu para testar, ex. sem rede). "invalid" nunca é
  /// gravado — token recusado pelo serviço não entra no cofre.
  validationStatus String    @default("unknown")
  /// O que o serviço respondeu, em linguagem de gente ("conta dioli@…").
  validationDetail String?
  validatedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accesses InfraCredentialAccess[]

  @@map("infra_credentials")
}

/// Trilha de auditoria: uma linha por LEITURA do token para uso.
///
/// Sobrevive à remoção da credencial de propósito (`onDelete: SetNull`) — apagar
/// o token não pode apagar o registro de quem já o usou.
model InfraCredentialAccess {
  id String @id @default(cuid())

  credentialId String?
  /// Repetido aqui porque a trilha precisa sobreviver ao delete da credencial.
  service      String

  /// Quem pediu (ex. "admin", nome de um job).
  actor   String
  /// Para quê — frase curta e obrigatória. Leitura sem motivo é leitura cega.
  purpose String
  /// "ok" | "missing" | "decrypt_failed"
  outcome String

  createdAt DateTime @default(now())

  credential InfraCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([service, createdAt])
  @@map("infra_credential_accesses")
}

// ═══════════════════════════════════════════
//  RAIO-X NOTURNO — a coleta determinística
// ═══════════════════════════════════════════
//
// Uma linha por madrugada. Guardar cada execução é metade do valor do raio-x:
// "37 mensagens presas" não diz nada; "37, contra 4 ontem" diz tudo. Os deltas
// vivem no achado justamente para que a comparação sobreviva a mudanças no
// conjunto de sondas.
//
// Tabelas isoladas, como as da auditoria de qualidade: o raio-x nunca escreve
// em dado de negócio, e a única camada que escreve aqui é
// src/services/raiox/persistence.

/// Uma execução do raio-x.
model RaioXRun {
  id           String   @id @default(cuid())
  source       String   @default("CRON") // CRON | MANUAL
  /// PASS | WARNING | FAIL | UNKNOWN. Só é PASS quando TODA sonda registrou
  /// resultado — ausência de dado nunca vira "está tudo bem".
  globalStatus String
  startedAt    DateTime
  finishedAt   DateTime
  durationMs   Int
  triggeredBy  String?

  countsByStatus   Json // { PASS, WARNING, FAIL, UNKNOWN }
  countsBySeverity Json // { P0, P1, P2, INFO }

  /// Execução usada como base de comparação. Nulo = primeira noite, e o
  /// relatório precisa dizer "sem base" em vez de mostrar zero.
  comparedToRunId   String?
  /// Blocos da coleta que não vieram, com o motivo. Vai inteiro para o relatório.
  unavailableBlocks Json?

  createdAt DateTime @default(now())

  findings RaioXFinding[]

  @@index([createdAt])
  @@index([globalStatus])
  @@map("raiox_runs")
}

/// Um achado de uma sonda. Carrega a própria evidência e os próprios números.
model RaioXFinding {
  id       String @id @default(cuid())
  runId    String
  probeId  String
  area     String
  status   String // PASS | WARNING | FAIL | UNKNOWN
  severity String // P0 | P1 | P2 | INFO
  title    String
  summary  String
  /// string[] — casos concretos, já sanitizados (sem telefone, e-mail ou token).
  evidence Json
  /// Números comparáveis entre execuções.
  metrics  Json
  /// Variação contra a execução anterior. null numa chave = sem base de comparação.
  deltas   Json

  recommendation String

  createdAt DateTime @default(now())

  run RaioXRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([probeId, severity])
  @@map("raiox_findings")
}

// ═══════════════════════════════════════════════════════════════════════════
// ORGANIZAÇÃO INTERNA DA FOOCCI
//
// Fase 1 do programa `docs/arquitetura-operacional-foocci-v1/`.
//
// Até aqui o repositório descrevia muito bem o PRODUTO e quase nada a EMPRESA:
// 143 models e nenhum dizia quem trabalha aqui. O admin inteiro era uma senha
// só (`ADMIN_SECRET`), e o model `User` pertence ao RESTAURANTE — tem
// `restaurantId` obrigatório. Sem identidade interna não existe responsável por
// tarefa, autor de decisão, nem "quem assumiu a conversa".
//
// Estes models são a fundação que os 9 departamentos compartilham. São
// aditivos: nada existente foi alterado.
// ═══════════════════════════════════════════════════════════════════════════

/// Papel de quem trabalha NA Foocci — não confundir com `Role`, que é o papel
/// de quem trabalha NO RESTAURANTE cliente.
/// Os seis perfis oficiais da v3 (`05-RBAC-E-PERMISSOES.md`).
///
/// A v1 tinha sete, com outros nomes. O CEO fixou estes seis em 25/08/2026, e a
/// migração mapeia cada valor antigo para o novo — nenhuma linha existente muda
/// de sentido.
enum InternalRole {
  /// O CEO. Acesso integral, em toda parte.
  MASTER_CEO

  /// Acesso integral à operação Foocci.
  DIRETOR_FOOCCI

  /// Um por departamento. Enxerga o próprio departamento: equipe, backlog,
  /// indicadores e delegações — e nada dos outros.
  GERENTE_DEPARTAMENTO

  /// Pessoa que executa. Enxerga só as ferramentas e os dados da função dela.
  /// O SDR humano é este perfil: Sala de Vendas e nada mais do Admin.
  AGENTE_HUMANO

  /// Ator técnico. NUNCA é uma credencial humana e nunca faz login interativo —
  /// existe para que uma ação executada por IA tenha autor na trilha em vez de
  /// aparecer como "sistema", que não responde por nada.
  AGENTE_IA

  /// Lê, audita, avalia e registra não conformidade. Não corrige o que auditou.
  AUDITOR_QA
}

/// Altura na hierarquia. Separada de `InternalRole` porque cargo e papel não são
/// a mesma coisa: uma pessoa pode ocupar o cargo de Gerente de Vendas e ter
/// papel CEO enquanto a empresa é pequena.
/// Níveis do organograma. Sem `GERENTE_GERAL`: o Diretor da Foocci já ocupa
/// essa camada, e o cargo criaria um degrau a mais sem ninguém para ocupá-lo
/// (regra 10 da hierarquia v3).
enum PositionLevel {
  CEO
  DIRETOR
  GERENTE
  OPERACAO
}

/// Um dos 9 departamentos canônicos.
model Department {
  id     String @id @default(cuid())
  /// Ordem canônica do plano mestre (1 = Marketing … 9 = Financeiro).
  numero Int    @unique
  slug   String @unique
  nome   String
  missao String @db.Text

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions   Position[]
  memberships DepartmentMembership[]
  fichas      AgentProfile[]

  delegacoes        Delegacao[]
  naoConformidades  NaoConformidade[]
  ordensDeServico   WorkOrder[]
  projetos          Project[]
  tarefas           Task[]
  handoffsEnviados  Handoff[]         @relation("HandoffOrigem")
  handoffsRecebidos Handoff[]         @relation("HandoffDestino")

  @@map("departments")
}

/// Um cargo no organograma. Existe INDEPENDENTE de ter gente nele.
///
/// Isto é de propósito: o plano mestre manda preservar a posição organizacional
/// "para permitir crescimento sem reconstrução". Cargo vago é informação — dizer
/// que o Gerente de Produto não existe é diferente de dizer que ninguém o ocupa.
model Position {
  id     String        @id @default(cuid())
  slug   String        @unique
  titulo String
  nivel  PositionLevel

  /// Nulo para CEO, Diretor e Gerente Geral, que estão acima dos departamentos.
  departmentId String?

  /// A quem este cargo se reporta. Auto-relação: é o organograma.
  reportsToPositionId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department  Department? @relation(fields: [departmentId], references: [id])
  reportsTo   Position?   @relation("Organograma", fields: [reportsToPositionId], references: [id])
  subordinate Position[]  @relation("Organograma")

  ocupantes   InternalUser[]
  memberships DepartmentMembership[]

  /// Fichas cujo DONO é este cargo, e fichas cujo GESTOR é este cargo.
  ///
  /// O dono é cargo, não pessoa, pelo mesmo motivo do organograma: os cargos
  /// nascem vagos e uma ficha precisa ter responsável desde o primeiro dia.
  /// "Dono: Gerente de Vendas (vago)" é verdade e é acionável; dono nulo até
  /// alguém ser contratado seria uma ficha sem responsável — que é o mesmo que
  /// IA sem responsável.
  fichasQueDono     AgentProfile[] @relation("DonoDaFicha")
  fichasQueGerencia AgentProfile[] @relation("GestorDaFicha")

  delegouDe           Delegacao[] @relation("DelegouDe")
  delegouPara         Delegacao[] @relation("DelegouPara")
  osQuePatrocina      WorkOrder[] @relation("OsSponsor")
  osQueResponde       WorkOrder[] @relation("OsOwner")
  projetosQueDono     Project[]   @relation("ProjetoOwner")
  tarefasDoCargo      Task[]      @relation("TarefaCargo")
  handoffsQueResponde Handoff[]   @relation("HandoffResponsavel")

  @@index([departmentId])
  @@index([reportsToPositionId])
  @@map("positions")
}

/// Quem trabalha na Foocci.
///
/// `passwordHash` é opcional porque `SYSTEM_AI` não tem senha — e um campo
/// obrigatório forçaria alguém a inventar uma para o ator técnico, que é
/// exatamente como uma credencial de sistema vira credencial de gente.
model InternalUser {
  id    String @id @default(cuid())
  email String @unique
  nome  String

  /// bcrypt, como o resto da casa (`src/lib/auth.ts`). Nulo = não faz login.
  passwordHash String?

  role       InternalRole @default(AGENTE_HUMANO)
  positionId String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  /// ⛔ A senha atual foi definida por OUTRA PESSOA — troca obrigatória na entrada.
  ///
  /// Ordem do CEO em 05/09/2026: *"deveria haver uma forma de a pessoa receber
  /// uma senha provisória e já trocar. Esse é o procedimento padrão em qualquer
  /// empresa."* E ele tinha razão sobre um buraco real: a casa sorteava uma
  /// senha, alguém a lia na tela, e ela valia **para sempre**. Quem criou o
  /// acesso ficava sabendo a senha de quem entra — indefinidamente.
  ///
  /// Nasce `true` em toda criação e em toda troca feita pelo Admin, inclusive
  /// quando a senha foi DIGITADA por quem criou: o que torna a senha provisória
  /// não é ela ter sido sorteada, é ela ter passado por um terceiro.
  ///
  /// Só volta a `false` quando a própria pessoa define a dela em
  /// `POST /api/interno/senha`.
  deveTrocarSenha Boolean @default(false)

  /// Quando a pessoa definiu a senha dela pela última vez. Nulo = nunca definiu
  /// — ou seja, ainda está com a que recebeu de outra pessoa.
  senhaDefinidaEm DateTime?

  /// ⛔ Até quando a senha provisória vale. Passou disso, ela não entra mais.
  ///
  /// Senha provisória que dura para sempre é senha definitiva com nome bonito —
  /// e é ela que fica escrita na caixa postal, num histórico que não se apaga.
  /// O prazo é o que fecha essa janela sozinho, sem ninguém precisar lembrar.
  ///
  /// Nulo quando a pessoa já definiu a própria: não há provisória para vencer.
  senhaProvisoriaExpiraEm DateTime?

  /// ⭐ O crachá desta pessoa no Dioli Connect, se ela tiver um.
  ///
  /// É por aqui que a senha provisória viaja: a plataforma posta na caixa do
  /// crachá, de máquina para máquina. Nulo = não há para onde mandar, e a senha
  /// só aparece na tela de quem criou o acesso, como antes.
  crachaConnect String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  position    Position?              @relation(fields: [positionId], references: [id])
  memberships DepartmentMembership[]

  leadsQueAtende     SiteLead[]        @relation("LeadAtendente")
  falhasQueAchou     NaoConformidade[] @relation("FalhaEncontradaPor")
  falhasQueAceitou   NaoConformidade[] @relation("FalhaAceitaPor")
  osQueSolicitou     WorkOrder[]       @relation("OsSolicitante")
  tarefasDaPessoa    Task[]            @relation("TarefaPessoa")
  handoffsQueEnviou  Handoff[]         @relation("HandoffEmissor")
  handoffsQueAceitou Handoff[]         @relation("HandoffReceptor")

  // ── Sala de Vendas ─────────────────────────────────────────────────────────
  mensagensQueEscreveu LeadMensagem[]      @relation("MensagemAutor")
  fichasQueAtualizou   LeadQualificacao[]  @relation("FichaAtualizadaPor")
  tarefasDeLead        LeadTarefa[]        @relation("TarefaDoLead")
  compromissos         LeadCompromisso[]   @relation("CompromissoDoLead")
  propostasQueCriou    LeadProposta[]      @relation("PropostaCriadaPor")
  handoffsDeLeadDe     LeadHandoff[]       @relation("HandoffLeadDe")
  handoffsDeLeadPara   LeadHandoff[]       @relation("HandoffLeadPara")
  disponibilidade      SdrDisponibilidade?
  versoesQuePublicou   SdrIaConfigVersao[] @relation("VersaoPublicadaPor")
  avaliacoesRecebidas  LeadAvaliacaoQA[]   @relation("QAAvaliado")
  avaliacoesQueFez     LeadAvaliacaoQA[]   @relation("QAAvaliador")

  @@index([role])
  @@index([positionId])
  @@map("internal_users")
}

/// A que departamentos a pessoa pertence. Uma pessoa pode acumular — o plano
/// mestre prevê acúmulo enquanto a empresa é pequena.
model DepartmentMembership {
  id             String  @id @default(cuid())
  internalUserId String
  departmentId   String
  positionId     String?

  /// Gerente do departamento. É o que decide quem administra a área — não o
  /// `InternalRole`, que é a altura na empresa.
  isManager Boolean @default(false)

  createdAt DateTime @default(now())

  internalUser InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  position     Position?    @relation(fields: [positionId], references: [id])

  @@unique([internalUserId, departmentId])
  @@index([departmentId, isManager])
  @@map("department_memberships")
}

/// Quem é o ator de uma ação interna.
enum InternalActorType {
  INTERNAL_USER

  /// A senha compartilhada antiga. Continua válida durante a transição (ADR-003),
  /// mas SEMPRE deixa rastro — é assim que a convivência vira número medido em
  /// vez de suposição, e é esse número que sustenta a decisão de desligá-la.
  LEGACY_ADMIN_SECRET

  /// Nenhuma sessão: a tentativa chegou sem identidade.
  ANONIMO

  SYSTEM
}

enum InternalActionResult {
  PERMITIDO
  NEGADO
}

/// Trilha append-only de ação interna sensível.
///
/// Guarda TAMBÉM o que foi negado. Uma trilha que só registra sucesso não
/// responde "alguém tentou entrar onde não devia?", que é a pergunta que uma
/// trilha existe para responder.
model InternalAuditEvent {
  id String @id @default(cuid())

  actorType  InternalActorType
  actorId    String?
  /// Nome legível de quem agiu. Guardado no evento de propósito: se a pessoa
  /// for desativada depois, o histórico continua dizendo quem foi.
  actorLabel String

  acao      String
  recurso   String
  resultado InternalActionResult
  /// Obrigatório quando NEGADO — achado sem motivo é ruído.
  motivo    String?

  departmentId String?
  origemIp     String?
  detalhe      Json     @default("{}")
  ocorridoEm   DateTime @default(now())

  @@index([ocorridoEm])
  @@index([actorType, ocorridoEm])
  @@index([resultado, ocorridoEm])
  @@map("internal_audit_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// O TRABALHO — ordem de serviço, projeto, tarefa e handoff (Fase 1, PR 1.3)
//
// O plano mestre (documento 09, seções 3.2 e 3.4) descreve o trabalho da empresa
// em quatro objetos e uma regra dura:
//
//   "O item permanece com o emissor até o aceite do destino ou regra explícita."
//
// Essa frase é o coração deste bloco. Ela NÃO é cumprida por um campo `status`
// que alguém lembra de atualizar: é cumprida por uma escrita condicional, dentro
// de transação, que só um dos dois lados consegue vencer. Ver
// `src/services/trabalho/handoff.ts`.
// ═══════════════════════════════════════════════════════════════════════════════

/// Situação de uma OS, projeto ou tarefa. Exatamente os quatro do documento 09.
///
/// Repare que NÃO existe `BLOQUEADO`. É ordem explícita do plano mestre: "não
/// usar bloqueado como lista principal" — impedimento vive dentro do item, como
/// dependência ou pendência, e não vira uma coluna onde o trabalho se acumula
/// sem dono.
enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/// Estado de um handoff.
///
/// `ENVIADO` é o único estado em que o item ainda pertence ao EMISSOR. Sair dele
/// é a transição que precisa ser atômica.
enum HandoffStatus {
  ENVIADO
  ACEITO
  RECUSADO
  DEVOLVIDO
}

/// Ordem de serviço: nasce de uma solicitação executiva ou departamental.
model WorkOrder {
  id     String @id @default(cuid())
  /// Número humano, sequencial. É como as pessoas se referem à OS.
  numero Int    @unique @default(autoincrement())

  objetivo          String @db.Text
  resultadoEsperado String @db.Text
  criterioDeAceite  String @db.Text

  /// Contexto, riscos e restrições — texto livre, porque é isso que eles são.
  contexto   String? @db.Text
  riscos     String? @db.Text
  restricoes String? @db.Text

  prioridade WorkPriority @default(MEDIA)
  status     WorkStatus   @default(NOT_STARTED)
  prazo      DateTime?

  /// Quem pediu. Pessoa, porque pedido tem autor.
  solicitanteId     String?
  /// Quem patrocina e quem responde — CARGOS, que existem mesmo vagos.
  sponsorPositionId String?
  ownerPositionId   String?
  departmentId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitante InternalUser? @relation("OsSolicitante", fields: [solicitanteId], references: [id])
  sponsor     Position?     @relation("OsSponsor", fields: [sponsorPositionId], references: [id])
  owner       Position?     @relation("OsOwner", fields: [ownerPositionId], references: [id])
  department  Department?   @relation(fields: [departmentId], references: [id])

  projects   Project[]
  tasks      Task[]
  handoffs   Handoff[]
  delegacoes Delegacao[]

  @@index([status])
  @@index([departmentId])
  @@index([ownerPositionId])
  @@map("work_orders")
}

model Project {
  id       String @id @default(cuid())
  nome     String
  objetivo String @db.Text

  status     WorkStatus   @default(NOT_STARTED)
  prioridade WorkPriority @default(MEDIA)
  prazo      DateTime?

  workOrderId     String?
  departmentId    String?
  ownerPositionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrder  WorkOrder?  @relation(fields: [workOrderId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  owner      Position?   @relation("ProjetoOwner", fields: [ownerPositionId], references: [id])

  tasks    Task[]
  handoffs Handoff[]

  @@index([status])
  @@index([workOrderId])
  @@index([departmentId])
  @@map("projects_internos")
}

model Task {
  id        String  @id @default(cuid())
  titulo    String
  descricao String? @db.Text

  status     WorkStatus   @default(NOT_STARTED)
  prioridade WorkPriority @default(MEDIA)
  prazo      DateTime?

  /// Responsável em duas camadas: o CARGO responde sempre; a PESSOA, quando
  /// houver uma. Tarefa cujo cargo está vago tem responsável — vago — e não
  /// desaparece do radar por falta de gente.
  assigneePositionId String?
  assigneeUserId     String?

  projectId    String?
  workOrderId  String?
  departmentId String?

  concluidaEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project          Project?      @relation(fields: [projectId], references: [id])
  workOrder        WorkOrder?    @relation(fields: [workOrderId], references: [id])
  department       Department?   @relation(fields: [departmentId], references: [id])
  assigneePosition Position?     @relation("TarefaCargo", fields: [assigneePositionId], references: [id])
  assigneeUser     InternalUser? @relation("TarefaPessoa", fields: [assigneeUserId], references: [id])

  dependeDe  TaskDependency[] @relation("TarefaQueDepende")
  bloqueia   TaskDependency[] @relation("TarefaDaQualDepende")
  handoffs   Handoff[]
  delegacoes Delegacao[]

  @@index([status])
  @@index([projectId])
  @@index([assigneePositionId])
  @@index([assigneeUserId])
  @@map("tasks_internas")
}

/// "A depende de B". Duas linhas iguais não podem existir, e uma tarefa não pode
/// depender de si mesma — a segunda regra vive no serviço, porque o Postgres não
/// tem CHECK declarativo no Prisma.
model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  createdAt DateTime @default(now())

  task      Task @relation("TarefaQueDepende", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TarefaDaQualDepende", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

/// A passagem de bastão entre departamentos.
///
/// Campos exigidos pelo documento 09, seção 3.4: origem, destino, responsável,
/// resumo, evidências, entregáveis, pendências, SLA e confirmação do
/// recebimento. Nenhum deles é decorativo — um handoff sem entregáveis e sem
/// pendências é uma conversa, não uma passagem de trabalho.
model Handoff {
  id String @id @default(cuid())

  origemDepartmentId    String
  destinoDepartmentId   String
  /// Quem responde pelo handoff no destino. Cargo, não pessoa.
  responsavelPositionId String?

  resumo      String @db.Text
  evidencias  Json   @default("[]")
  entregaveis Json   @default("[]")
  pendencias  Json   @default("[]")

  /// Prazo de aceite. `null` = sem SLA acordado, que é diferente de SLA zero.
  slaHoras Int?

  status HandoffStatus @default(ENVIADO)

  /// O item que está sendo passado. Exatamente um destes é preenchido — a regra
  /// vive no serviço, que recusa handoff sem item e handoff com dois.
  workOrderId String?
  projectId   String?
  taskId      String?

  enviadoPorId String?
  enviadoEm    DateTime  @default(now())
  /// Confirmação do recebimento. Enquanto for nulo, o item é do emissor.
  aceitoPorId  String?
  aceitoEm     DateTime?
  recusadoEm   DateTime?
  /// Recusa e devolução exigem motivo. "Não aceito" sem motivo não é informação.
  motivo       String?   @db.Text

  updatedAt DateTime @updatedAt

  origem      Department    @relation("HandoffOrigem", fields: [origemDepartmentId], references: [id])
  destino     Department    @relation("HandoffDestino", fields: [destinoDepartmentId], references: [id])
  responsavel Position?     @relation("HandoffResponsavel", fields: [responsavelPositionId], references: [id])
  workOrder   WorkOrder?    @relation(fields: [workOrderId], references: [id])
  project     Project?      @relation(fields: [projectId], references: [id])
  task        Task?         @relation(fields: [taskId], references: [id])
  enviadoPor  InternalUser? @relation("HandoffEmissor", fields: [enviadoPorId], references: [id])
  aceitoPor   InternalUser? @relation("HandoffReceptor", fields: [aceitoPorId], references: [id])

  @@index([status])
  @@index([destinoDepartmentId, status])
  @@index([taskId])
  @@map("handoffs")
}

/// A linha do tempo imutável do documento 09.
///
/// Append-only de verdade: gravar é permitido, alterar e apagar não. A trava é
/// gatilho no banco, não convenção — ver a migração. Prompt é aviso; código é
/// trava.
///
/// O PR 1.4 estende esta mesma tabela para aprovações e decisões. Duas tabelas
/// de evento produziriam duas linhas do tempo, e a pergunta "o que aconteceu com
/// este item?" passaria a ter duas respostas.
model DomainEvent {
  id String @id @default(cuid())

  /// Que tipo de coisa aconteceu: "handoff.aceito", "tarefa.concluida".
  tipo       String
  /// A que objeto. `entidade` + `entidadeId` em vez de FK porque um evento
  /// sobrevive ao objeto que o gerou — e uma FK o apagaria junto.
  entidade   String
  entidadeId String

  /// Quem causou. Texto, pelo mesmo motivo: o evento não pode sumir com a pessoa.
  atorTipo   String
  atorRotulo String?

  dados Json @default("{}")

  ocorridoEm DateTime @default(now())

  @@index([entidade, entidadeId, ocorridoEm])
  @@index([tipo, ocorridoEm])
  @@index([ocorridoEm])
  @@map("domain_events")
}

// ═══════════════════════════════════════════════════════════════════════════════
// GOVERNANÇA DO DEPARTAMENTO (v3, Fase 4)
//
// O documento 01 exige que cada departamento tenha dono, fila, entradas, saídas,
// SLA, métricas e regras de escalonamento. Dono e fila já existem (cargo e
// backlog). Falta o que registra o COMANDO e a QUALIDADE.
// ═══════════════════════════════════════════════════════════════════════════════

/// Uma ordem descendo a hierarquia.
///
/// ── POR QUE ISTO É UMA TABELA, E NÃO UM CAMPO NA TAREFA ──
///
/// A regra 7 da hierarquia diz que "o Diretor não opera rotineiramente delegando
/// direto aos agentes subordinados". É um HÁBITO, e hábito não se implementa com
/// `if`.
///
/// Bloquear seria errado: numa urgência, o Diretor PRECISA poder falar direto
/// com quem executa. O que não pode é isso virar rotina sem ninguém perceber.
///
/// Então a delegação registra o caminho, e o caminho vira número: quantas vezes,
/// no período, uma ordem pulou o Agente Gerente. Um pulo é exceção. Trinta pulos
/// por mês é uma estrutura que não está funcionando — e aí a conversa é sobre a
/// estrutura, não sobre a regra.
model Delegacao {
  id String @id @default(cuid())

  /// Cargo de quem delegou e de quem recebeu.
  dePositionId   String
  paraPositionId String

  departmentId String?

  /// O que foi pedido, e como se sabe que terminou.
  objetivo         String    @db.Text
  criterioDeAceite String?   @db.Text
  prazo            DateTime?

  /// O item gerado, quando houver.
  workOrderId String?
  taskId      String?

  /// `true` quando a ordem pulou o Agente Gerente do departamento.
  ///
  /// Calculado na escrita e GRAVADO, não deduzido na leitura: o organograma
  /// muda, e um relatório de junho precisa dizer o que era verdade em junho.
  pulouGerente Boolean @default(false)

  /// Quem registrou. Pessoa, porque ordem tem autor.
  criadoPorId String?
  criadoEm    DateTime @default(now())

  de         Position    @relation("DelegouDe", fields: [dePositionId], references: [id])
  para       Position    @relation("DelegouPara", fields: [paraPositionId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  workOrder  WorkOrder?  @relation(fields: [workOrderId], references: [id])
  task       Task?       @relation(fields: [taskId], references: [id])

  @@index([departmentId, criadoEm])
  @@index([pulouGerente, criadoEm])
  @@index([paraPositionId])
  @@map("delegacoes")
}

/// Gravidade de uma não conformidade.
enum GravidadeDaFalha {
  /// Não impede a operação, mas precisa entrar na fila.
  BAIXA
  /// Atrapalha e tem prazo.
  MEDIA
  /// Para a operação até resolver.
  ALTA
  /// Risco a cliente, dado ou dinheiro: bloqueia agora.
  BLOQUEANTE
}

enum SituacaoDaFalha {
  ABERTA
  EM_TRATAMENTO
  RESOLVIDA
  /// Aceita conscientemente, com quem aceitou registrado.
  ACEITA
}

/// Uma não conformidade encontrada por auditoria ou avaliação.
///
/// ── A REGRA QUE ESTE MODELO IMPÕE ──
///
/// **Ausência de evidência não é aprovação.** Toda falha nasce com evidência
/// anexada, e uma falha sem evidência não pode ser aberta — senão a auditoria
/// vira opinião, e opinião não sustenta bloqueio de mudança crítica.
///
/// **Quem audita não assina a liberação do que auditou.** `aceitaPorId` nunca
/// pode ser igual a `encontradaPorId`. A trava está no serviço, com teste.
model NaoConformidade {
  id String @id @default(cuid())

  titulo    String
  descricao String @db.Text

  gravidade GravidadeDaFalha
  situacao  SituacaoDaFalha  @default(ABERTA)

  /// Onde foi encontrada: departamento e, quando couber, o agente avaliado.
  departmentId   String?
  agentProfileId String?

  /// A prova. Sem ela a falha não existe — o serviço recusa criar sem evidência.
  evidencia Json @default("[]")

  /// O que se vai fazer, e até quando.
  planoDeAcao String?   @db.Text
  prazo       DateTime?

  encontradaPorId String?
  /// Quem aceitou o risco, quando `situacao = ACEITA`. NUNCA quem encontrou.
  aceitaPorId     String?
  motivoDaAceite  String? @db.Text

  criadaEm    DateTime  @default(now())
  resolvidaEm DateTime?
  updatedAt   DateTime  @updatedAt

  department    Department?   @relation(fields: [departmentId], references: [id])
  agentProfile  AgentProfile? @relation(fields: [agentProfileId], references: [id])
  encontradaPor InternalUser? @relation("FalhaEncontradaPor", fields: [encontradaPorId], references: [id])
  aceitaPor     InternalUser? @relation("FalhaAceitaPor", fields: [aceitaPorId], references: [id])

  @@index([situacao, gravidade])
  @@index([departmentId, criadaEm])
  @@index([agentProfileId])
  @@map("nao_conformidades")
}

// ╔═══════════════════════════════════════════════════════════════════════════╗
// ║  SALA DE VENDAS E SDRs — o comando de 25/08/2026                          ║
// ║                                                                           ║
// ║  Tudo aqui é sobre QUEM QUER CONTRATAR a Foocci. Nada aqui toca em         ║
// ║  `Customer`, `Conversation` ou `Message`, que são o consumidor do          ║
// ║  restaurante. As duas bases nunca se encostam — é a regra número um do     ║
// ║  produto, e a razão de existir uma conversa própria para o lead.           ║
// ╚═══════════════════════════════════════════════════════════════════════════╝

/// Direção de uma mensagem, do ponto de vista da Foocci.
enum DirecaoDaMensagem {
  ENTRADA // o lead escreveu
  SAIDA // a Foocci escreveu
}

/// O que a mensagem carrega. Espelha os tipos que a Meta entrega.
enum TipoDaMensagem {
  TEXTO
  AUDIO
  IMAGEM
  DOCUMENTO
  VIDEO
  TEMPLATE
  /// Chegou algo que este sistema não sabe representar (localização, contato,
  /// figurinha…). É registrado como NAO_SUPORTADO **com o tipo cru guardado** —
  /// jamais descartado. Mensagem que some é conversa que mente.
  NAO_SUPORTADO
}

/// O que aconteceu com uma mensagem que a Foocci mandou.
///
/// `FALHOU` é um estado de primeira classe, e não um log: uma mensagem que não
/// chegou e aparece na tela como se tivesse chegado faz o vendedor esperar uma
/// resposta que nunca vem.
enum StatusDaMensagem {
  PENDENTE // aceita por nós, ainda não confirmada pelo provedor
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
  /// Só para ENTRADA: mensagem recebida não tem status de entrega.
  RECEBIDA
}

/// Quem redigiu uma mensagem de saída.
enum AutorDaMensagem {
  IA // o Agente SDR IA (TA)
  HUMANO // uma pessoa da Sala
  SISTEMA // automação: cadência, confirmação, template operacional
}

/// A conversa de WhatsApp de um lead da Foocci.
///
/// ── POR QUE NÃO REUSAR `Message` ─────────────────────────────────────────────
/// `Message` pende de `Conversation`, que exige `restaurantId` obrigatório. O
/// prospecto da Foocci não tem restaurante. Usá-la exigiria inventar um tenant
/// falso dentro do sistema cuja regra número um é não misturar as bases — e o
/// preço seria prospecto aparecendo na Central de Conversas de algum lojista.
///
/// ── IDEMPOTÊNCIA ────────────────────────────────────────────────────────────
/// `waMessageId` é ÚNICO. A Meta reentrega webhook em falha de rede, e sem esta
/// restrição a mesma mensagem entraria duas vezes na conversa — o defeito mais
/// constrangedor possível numa tela de atendimento. A unicidade é a trava; a
/// verificação em código é a conveniência (guardrail 4).
model LeadMensagem {
  id     String   @id @default(cuid())
  leadId String
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  direcao DirecaoDaMensagem
  tipo    TipoDaMensagem    @default(TEXTO)
  status  StatusDaMensagem  @default(PENDENTE)

  /// O id da mensagem no provedor. Único e opcional: opcional porque uma
  /// mensagem de saída existe (PENDENTE) antes de o provedor devolver o id.
  waMessageId String? @unique
  /// Tipo cru do provedor quando `tipo = NAO_SUPORTADO`, para não perder o quê.
  tipoCru     String?

  texto         String? @db.Text
  /// Endereço da mídia no provedor + o que dá para saber sem baixar o arquivo.
  midiaId       String?
  midiaMimeType String?
  midiaNome     String?
  /// Legenda de imagem/vídeo/documento. Vem separada do texto na Meta.
  legenda       String? @db.Text
  /// Duração em segundos, para áudio e vídeo.
  duracaoSeg    Int?

  /// Nome do template, quando `tipo = TEMPLATE`. Sem ele não há como auditar o
  /// que foi disparado depois que a janela de 24h fechou.
  templateNome String?

  autor       AutorDaMensagem?
  /// Quem apertou enviar, quando `autor = HUMANO`. Item 19 do comando: toda
  /// mensagem tem responsável, e IA e humano não se confundem.
  autorUserId String?
  autorUser   InternalUser?    @relation("MensagemAutor", fields: [autorUserId], references: [id])

  /// Motivo da falha, do provedor. Nunca guarda token nem credencial.
  erro       String? @db.Text
  /// Quantas vezes já se tentou reenviar. Retentativa sem contador é laço.
  tentativas Int     @default(0)

  /// Quando o provedor carimbou. Pode ser anterior a `createdAt` — a Meta
  /// reentrega, e ordenar pela hora de gravação embaralharia a conversa.
  ocorreuEm DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Quando uma pessoa marcou como lida. Alimenta `SiteLead.naoLidas`.
  lidaEm DateTime?

  // ── ⭐ A TRILHA DO TURNO — acrescentada em 10/09/2026 ──────────────────────
  //
  // A conversa de 09/09 teve duas respostas da IA para uma sequência só, e fora
  // de ordem. Não havia como provar de onde cada uma tinha vindo: `autor = IA`
  // dizia que a máquina falou, e nada mais. Sem estes três campos o defeito é
  // visível na tela e invisível no banco — o que faz "já corrigimos" virar
  // opinião.

  /// O turno a que esta mensagem pertence.
  ///
  /// ⭐ É o que junta as mensagens de ENTRADA que o lead mandou em sequência
  /// ("oi", "é padaria", "só vendo pelo iFood") com a ÚNICA resposta que elas
  /// produziram. Duas saídas com o mesmo `turnoId` são, por definição, o defeito
  /// de resposta dupla — e agora se acha com uma consulta, não com o olho.
  turnoId String?

  /// Qual papel escreveu: `abordagem`, `recepcao`, `qualificacao`, `closer`.
  /// Um cérebro só executa os quatro; sem esta coluna a métrica de cada papel
  /// seria adivinhada pelo estágio do lead, que muda depois da mensagem.
  papelDoAgente String?

  /// De onde saiu a fala: `modelo`, `modelo-2a-tentativa`, `deterministico`.
  /// Distingue o que o modelo escreveu do que o código escreveu quando ele
  /// falhou — duas qualidades diferentes que hoje se contam como uma.
  origemDaFala String?

  /// Avaliações de QA que citam esta mensagem como evidência.
  citadaEmQA LeadAvaliacaoCriterio[]

  /// ⭐ O veredito da Supervisora sobre ESTA mensagem, quando ela passou pela
  /// revisão antes de `entregarMensagem`. Nula quando a Supervisora está `OFF`
  /// ou a mensagem nunca chegou a `entregarMensagem` (ex.: template de
  /// prospecção, que usa `enviarModeloDeVendas` direto — fora do escopo desta
  /// camada, documentado em `supervisora/README` do serviço).
  avaliacaoSupervisora SupervisoraAvaliacao?

  @@index([leadId, ocorreuEm])
  @@index([leadId, direcao, ocorreuEm])
  @@index([status])
  @@index([ocorreuEm])
  @@index([turnoId])
  @@map("lead_mensagens")
}

/// ⭐ O LOCK DE UMA CONVERSA — a trava que impede duas respostas para um turno.
///
/// ── POR QUE UMA TABELA, E NÃO UMA VARIÁVEL ─────────────────────────────────
///
/// O app roda em mais de um processo. Uma trava em memória protege um processo
/// contra si mesmo e não protege nada contra o vizinho — e o defeito de 09/09 é
/// exatamente o do vizinho: duas mensagens do lead chegam quase juntas, o
/// webhook responde 200 e dispara o TA em `void` (sem esperar), e dois turnos
/// correm em paralelo sobre o mesmo lead. Cada um lê o histórico SEM a mensagem
/// do outro, e os dois respondem.
///
/// A trava só é trava se todos lerem do mesmo lugar. O banco é esse lugar.
///
/// ── POR QUE ELA EXPIRA ─────────────────────────────────────────────────────
///
/// Um processo que morre no meio do turno deixaria a conversa trancada para
/// sempre — e uma trava sem expiração transforma uma falha de um turno em um
/// lead que nunca mais é atendido. `expiraEm` é o conserto: passada a hora, a
/// trava vale como inexistente e o próximo turno a toma.
model TravaDaConversa {
  /// O lead é a chave. Uma conversa, uma trava.
  leadId String @id

  /// Quem tomou: id do processo/turno. Serve para o dono soltar a SUA trava e
  /// nunca a de outro — soltar a trava alheia é o mesmo que não ter trava.
  donoDoTurno String

  tomadaEm DateTime @default(now())
  expiraEm DateTime

  /// A última mensagem de entrada conhecida quando a trava foi tomada. Se
  /// chegar outra depois, a geração em curso está velha e não deve ser enviada.
  ultimaEntradaId String?

  @@index([expiraEm])
  @@map("travas_da_conversa")
}

/// A ficha 360º do lead — o painel direito da tela de atendimento.
///
/// Separada de `SiteLead` de propósito: são ~15 campos que a LISTA nunca lê e a
/// FICHA sempre lê. Deixá-los na tabela principal engordaria cada linha de toda
/// consulta de fila para servir uma tela por vez.
///
/// **Todo campo é opcional, e isso é a regra, não descuido.** A ficha se
/// preenche ao longo da conversa; obrigar campo aqui obrigaria o vendedor a
/// inventar resposta para poder salvar o que ele já descobriu.
model LeadQualificacao {
  id     String   @id @default(cuid())
  leadId String   @unique
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  segmento         String?
  /// Quantas casas o restaurante tem. Muda plano e muda quem decide.
  unidades         Int?
  /// Pedidos por mês, como a pessoa informou (estimativa dela, não medição).
  volumeMensal     Int?
  /// Canais que ele usa hoje: iFood, WhatsApp, Instagram, salão…
  canaisAtuais     String[] @default([])
  sistemaAtual     String?
  dorPrincipal     String?  @db.Text
  objetivo         String?  @db.Text
  planoDeInteresse String?
  /// Quando ele quer resolver. Urgência declarada, não deduzida.
  urgencia         String?
  /// Se quem está falando decide, decide com outro, ou não decide.
  poderDeDecisao   String?
  faixaDeOrcamento String?

  /// O que a IA entendeu, com a fonte colada. Preenchido pelo TA; editável por
  /// gente. A fonte importa: "informado no formulário" e "deduzido da conversa"
  /// não valem a mesma coisa numa proposta.
  observacoes String? @db.Text

  // ── ⭐ A MEMÓRIA DA CONVERSA — acrescentada em 10/09/2026 ──────────────────
  //
  // Até aqui esta tabela tinha UM escritor: a tela, quando um humano digitava.
  // O TA extraía os mesmos fatos a cada turno (`sondagem.ts`), usava-os para
  // calcular o score e **jogava fora**. Efeito medido na conversa de 09/09: o
  // lead disse "padaria" e foi perguntado de novo sobre o tipo de cozinha; disse
  // "só vendo pelo iFood" e foi perguntado de novo qual canal usava.
  //
  // Um agente que descobre e esquece não é um agente que qualifica — é um
  // formulário que reinicia. Os campos abaixo são o que faltava para ele parar
  // de perguntar o que já sabe.

  /// De qual marketplace ele depende hoje (iFood, Rappi, 99Food).
  marketplaceAtual           String?
  /// O que ele disse que NÃO quer, ou por que hesita. Uma por linha.
  objecoes                   String[] @default([])
  /// Recursos que ele mesmo puxou (CRM, automação, cardápio, fidelidade).
  funcionalidadesDeInteresse String[] @default([])
  /// O que ele pediu com todas as letras ("quero ver os planos", "me manda o link").
  pedidoExplicito            String?  @db.Text

  /// ⛔ ELE PEDIU PARA PARAR DE RESPONDER PERGUNTA.
  ///
  /// Não é o mesmo que opt-out: ele continua querendo falar, só não quer ser
  /// interrogado. Sem esta marca o agente lia "não quero mais responder
  /// perguntas" como uma objeção qualquer e voltava a sondar no turno seguinte —
  /// que é exatamente o que aconteceu em 09/09.
  pediuPararSondagem   Boolean   @default(false)
  pediuPararSondagemEm DateTime?

  /// Ele pediu para falar com uma pessoa. Marcado aqui além do handoff porque o
  /// handoff pode ser recusado por política e o PEDIDO continua valendo.
  pediuHumano   Boolean   @default(false)
  pediuHumanoEm DateTime?

  /// Sinal de irritação lido na conversa (0 = nada, 3 = explícito).
  irritacao Int @default(0)

  /// As perguntas que o agente JÁ FEZ, por chave estável.
  ///
  /// ⚠️ Existia uma dedução no lugar disto (`atender.ts`, `texto.includes(...)`
  /// sobre as saídas): comparar a pergunta com o texto já enviado só acerta
  /// enquanto o modelo escrever a pergunta com as MESMAS palavras — e ele
  /// reformula, porque foi mandado reformular. Chave gravada não reformula.
  perguntasJaFeitas String[] @default([])

  /// Quando o TA escreveu aqui pela última vez. Separado de `updatedAt` para
  /// distinguir o que a máquina soube do que uma pessoa corrigiu depois.
  atualizadoPelaIaEm DateTime?

  atualizadoPorId String?
  atualizadoPor   InternalUser? @relation("FichaAtualizadaPor", fields: [atualizadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lead_qualificacoes")
}

/// Um fator que entrou no cálculo do score, com o peso que ele teve.
///
/// ── POR QUE ISTO É UMA TABELA E NÃO UM NÚMERO ───────────────────────────────
/// Item 10 do comando: *"Mostrar os fatores que formaram o score. Não utilizar
/// uma pontuação opaca sem explicação."*
///
/// Score sem explicação não é discutível — e um número que ninguém consegue
/// contestar é um número que o time aprende a ignorar. Guardando cada fator, a
/// tela mostra POR QUE o lead é 82, e o gerente consegue dizer "este peso está
/// errado" em vez de "não confio nesse número".
model LeadScoreFator {
  id     String   @id @default(cuid())
  leadId String
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Chave estável da regra (`unidades`, `volume`, `urgencia`…).
  fator       String
  /// O que foi observado, em texto legível ("3 unidades", "usa só iFood").
  observado   String
  /// Quanto este fator somou — pode ser negativo.
  pontos      Int
  /// A versão da régua que gerou este ponto. Sem isso, mudar os pesos
  /// reescreveria retroativamente a explicação de scores antigos.
  reguaVersao Int

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([fator])
  @@map("lead_score_fatores")
}

/// Motivo estruturado de perda. Catálogo administrável.
///
/// Existe para que "por que a gente perde" seja uma consulta, e não uma leitura
/// de trezentas notas em texto livre.
model MotivoDePerda {
  id           String  @id @default(cuid())
  slug         String  @unique
  rotulo       String
  /// Agrupa para o relatório: preço, produto, tempo, concorrente, perfil…
  grupo        String?
  /// Exige que quem marcar escreva um detalhe. Para "Outro", é obrigatório —
  /// senão "Outro" vira o maior motivo de perda da empresa e não explica nada.
  exigeDetalhe Boolean @default(false)
  ativo        Boolean @default(true)
  ordem        Int     @default(0)

  createdAt DateTime @default(now())

  leads SiteLead[]

  @@index([ativo, ordem])
  @@map("motivos_de_perda")
}

/// Tipo de compromisso que alguém assumiu com o lead.
enum TipoDeTarefa {
  FOLLOW_UP
  LIGACAO
  MENSAGEM
  PROPOSTA
  CONFIRMACAO_DE_REUNIAO
  REENGAJAMENTO
  OUTRO
}

enum SituacaoDaTarefa {
  ABERTA
  CONCLUIDA
  CANCELADA
}

/// Tarefa e follow-up de um lead.
///
/// ── POR QUE NÃO REUSAR `Task` ───────────────────────────────────────────────
/// `Task` pertence a `Project`/`WorkOrder` — é o trabalho interno da empresa,
/// com dependências, estimativa e ordem de serviço. Um follow-up comercial é
/// outra coisa: pende de um LEAD, some quando o lead fecha, e sua pergunta
/// central é "venceu?". Forçar as duas na mesma tabela faria o quadro de
/// trabalho interno encher de follow-up e o funil encher de tarefa de
/// engenharia.
model LeadTarefa {
  id     String   @id @default(cuid())
  leadId String
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  tipo     TipoDeTarefa     @default(FOLLOW_UP)
  situacao SituacaoDaTarefa @default(ABERTA)
  titulo   String
  nota     String?          @db.Text

  /// Quando vence. É o coração da fila "follow-up vencido".
  venceEm     DateTime
  concluidaEm DateTime?

  responsavelId String?
  responsavel   InternalUser? @relation("TarefaDoLead", fields: [responsavelId], references: [id])

  /// Quem criou: pessoa, TA ou cadência.
  criadaPor  AutorDaMensagem @default(HUMANO)
  /// Preenchido quando a tarefa nasceu de um passo de cadência.
  cadenciaId String?
  cadencia   LeadCadencia?   @relation(fields: [cadenciaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, situacao])
  @@index([responsavelId, situacao, venceEm])
  @@index([situacao, venceEm])
  @@map("lead_tarefas")
}

enum SituacaoDoCompromisso {
  AGENDADO
  CONFIRMADO
  REALIZADO
  NAO_COMPARECEU
  REAGENDADO
  CANCELADO
}

/// Demonstração, ligação ou reunião marcada com o lead.
///
/// `MeetingSlot` continua existindo e serve a outra coisa: são as janelas que o
/// CEO abre no site para o visitante escolher. Este modelo é o compromisso em
/// si, que também nasce de conversa e de telefone — não só do site.
///
/// `NAO_COMPARECEU` é estado próprio, e não um cancelamento: quem não apareceu
/// é uma fila de reengajamento, quem cancelou é outra conversa.
model LeadCompromisso {
  id     String   @id @default(cuid())
  leadId String
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  titulo     String
  situacao   SituacaoDoCompromisso @default(AGENDADO)
  comecaEm   DateTime
  duracaoMin Int                   @default(30)
  local      String?
  nota       String?               @db.Text

  responsavelId String?
  responsavel   InternalUser? @relation("CompromissoDoLead", fields: [responsavelId], references: [id])

  /// Quando o lead confirmou presença.
  confirmadoEm    DateTime?
  /// Aponta para o compromisso que substituiu este, quando remarcado. Preserva
  /// a cadeia: remarcar três vezes é um sinal, e apagar o anterior o esconde.
  remarcadoParaId String?          @unique
  remarcadoPara   LeadCompromisso? @relation("Remarcacao", fields: [remarcadoParaId], references: [id])
  remarcadoDe     LeadCompromisso? @relation("Remarcacao")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, comecaEm])
  @@index([responsavelId, comecaEm])
  @@index([situacao, comecaEm])
  @@map("lead_compromissos")
}

enum SituacaoDaProposta {
  RASCUNHO
  ENVIADA
  EM_NEGOCIACAO
  ACEITA
  RECUSADA
  EXPIRADA
}

/// Proposta comercial enviada a um lead.
///
/// ⚠️ **Não inventa preço.** `valorMensal` é opcional e nasce vazio: enquanto o
/// CEO não fechar os valores dos planos, a proposta registra o que foi
/// combinado, não um número que o sistema arbitrou. Guardrail 7.
model LeadProposta {
  id     String   @id @default(cuid())
  leadId String
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  situacao        SituacaoDaProposta @default(RASCUNHO)
  plano           String?
  /// Em centavos, como o resto da casa. `null` = não há valor definido ainda.
  valorMensalCent Int?
  /// Desconto pedido/concedido, em pontos percentuais. Fora da alçada, escala.
  descontoPct     Int?
  condicoes       String?            @db.Text

  enviadaEm    DateTime?
  respondidaEm DateTime?
  validaAte    DateTime?

  criadaPorId String?
  criadaPor   InternalUser? @relation("PropostaCriadaPor", fields: [criadaPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
  @@index([situacao])
  @@map("lead_propostas")
}

/// Por que a conversa mudou de mão. São os gatilhos do item 8 do comando.
///
/// É enum e não texto porque a pergunta "o que mais faz a IA desistir" é a que
/// diz onde melhorar o TA — e ela não se responde lendo trezentas frases soltas.
enum MotivoDoHandoff {
  PEDIU_HUMANO // o lead pediu gente
  INTENCAO_DE_COMPRA // sinal forte de compra
  PEDIU_PROPOSTA
  PEDIU_DESCONTO // negociação: fora da alçada da IA, sempre
  OBJECAO_NAO_RESOLVIDA
  IA_INSEGURA // o próprio modelo declarou baixa confiança
  SENTIMENTO_NEGATIVO
  RISCO // jurídico, financeiro ou reputacional
  INFORMACAO_NAO_CONFIRMADA // a resposta exigiria afirmar o que não se sabe
  SCORE_ATINGIU_LIMITE
  IA_FALHOU // repetiu, travou ou errou
  DEVOLUCAO_PARA_IA // humano → IA (o caminho inverso)
  DISTRIBUICAO // reatribuição operacional, sem falha nenhuma
}

/// Uma passagem de bastão, com o dossiê que foi junto.
///
/// ── POR QUE O RESUMO É GRAVADO, E NÃO GERADO NA HORA DE LER ─────────────────
/// O dossiê é o estado da conversa NAQUELE momento. Recalculá-lo depois
/// mostraria o que se sabe hoje, e não o que quem pegou o lead tinha em mãos —
/// o que torna impossível avaliar se a decisão dele foi boa com o que ele tinha.
model LeadHandoff {
  id     String   @id @default(cuid())
  leadId String
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  de     LeadAtendidoPor
  para   LeadAtendidoPor
  motivo MotivoDoHandoff

  /// Quem entregou e quem recebeu, quando é gente.
  deUserId   String?
  paraUserId String?
  deUser     InternalUser? @relation("HandoffLeadDe", fields: [deUserId], references: [id])
  paraUser   InternalUser? @relation("HandoffLeadPara", fields: [paraUserId], references: [id])

  // ── O dossiê, congelado ────────────────────────────────────────────────────
  resumo          String?        @db.Text
  dorIdentificada String?        @db.Text
  objecoes        String?        @db.Text
  proximaAcao     String?        @db.Text
  /// Cópia do score e da etapa no instante da passagem.
  scoreNoMomento  Int?
  etapaNoMomento  SiteLeadStage?
  /// Objetivo escrito de quem devolve para a IA. Obrigatório nesse sentido:
  /// devolver sem dizer para quê é abandonar o lead com passo extra.
  objetivo        String?        @db.Text

  createdAt DateTime  @default(now())
  /// Quando alguém efetivamente pegou. Nulo enquanto ninguém pegou — e é isso
  /// que mede a espera por gente.
  aceitoEm  DateTime?

  @@index([leadId, createdAt])
  @@index([motivo, createdAt])
  @@index([aceitoEm])
  @@map("lead_handoffs")
}

/// Em que estado um SDR está agora.
enum EstadoDoSdr {
  DISPONIVEL
  OCUPADO // no limite de atendimentos simultâneos
  PAUSADO // almoço, reunião — não recebe distribuição
  OFFLINE
}

/// Disponibilidade e capacidade de quem atende.
///
/// Existe para que a distribuição automática não jogue lead em quem saiu para
/// almoçar — que é como um lead quente vira um lead esquecido.
model SdrDisponibilidade {
  id             String       @id @default(cuid())
  internalUserId String       @unique
  internalUser   InternalUser @relation(fields: [internalUserId], references: [id], onDelete: Cascade)

  estado EstadoDoSdr @default(OFFLINE)

  /// Quantos atendimentos simultâneos esta pessoa aceita. O limite existe para
  /// impedir que o round-robin encha o mesmo SDR de vinte conversas abertas.
  capacidade Int @default(15)

  /// Especialidade e região, quando o time usar distribuição direcionada.
  especialidades String[] @default([])
  regioes        String[] @default([])

  /// Motivo da pausa, quando pausado. Sem motivo, "pausado" vira permanente.
  motivoDaPausa String?
  pausadoAte    DateTime?

  /// Último sinal de vida — o painel do gerente mostra "online há 3 min".
  vistoEm   DateTime?
  updatedAt DateTime  @updatedAt

  @@index([estado])
  @@map("sdr_disponibilidade")
}

/// Como um lead sem responsável é distribuído.
enum ModoDeDistribuicao {
  MANUAL // ninguém distribui sozinho; a fila fica visível e é puxada
  RODIZIO // round-robin entre quem está disponível
  DISPONIBILIDADE // quem tem menos conversas abertas leva
  ESPECIALIDADE // por especialidade/região, com rodízio dentro do grupo
}

/// A configuração do Agente SDR IA — o TA.
///
/// ── SINGLETON, E DE PROPÓSITO ───────────────────────────────────────────────
/// Existe UMA configuração ativa por vez (`slug` único, hoje sempre "ta"). O
/// versionamento fica em `SdrIaConfigVersao`: publicar é apontar para outra
/// versão, e voltar atrás é apontar de volta. Um registro por versão "ativo ao
/// mesmo tempo" produziria duas IAs falando com o mesmo lead.
///
/// ⚠️ **Nasce DESLIGADO.** `ligado = false` por padrão, e nenhuma migração o
/// liga. Ligar é ato humano, uma vez, com evidência — a escada de liberação do
/// Cérebro vale aqui igual a todo o resto.
model SdrIaConfig {
  id   String @id @default(cuid())
  slug String @unique @default("ta")
  nome String @default("TA")

  /// A chave mestra. Desligado, o TA não responde nada — e a Sala funciona
  /// inteira com gente, que é como ela nasce.
  ligado Boolean @default(false)

  /// Versão publicada agora. Nula = nunca publicou; o TA fica calado.
  versaoAtivaId String?             @unique
  versaoAtiva   SdrIaConfigVersao?  @relation("VersaoAtiva", fields: [versaoAtivaId], references: [id])
  versoes       SdrIaConfigVersao[] @relation("VersoesDaConfig")

  // ── Limites operacionais, fora da versão do prompt ─────────────────────────
  // Ficam aqui porque são trava, não redação: mudar o texto do prompt não pode
  // acidentalmente ampliar o horário de disparo nem soltar o desconto.
  //
  /// Janela em que o TA pode iniciar contato (0–23, hora de São Paulo).
  horaInicio      Int @default(9)
  horaFim         Int @default(20)
  /// Máximo de mensagens que o TA manda sem resposta antes de parar sozinho.
  maxSemResposta  Int @default(3)
  /// Score a partir do qual o lead vai para gente automaticamente.
  scoreParaHumano Int @default(70)

  distribuicao           ModoDeDistribuicao @default(MANUAL)
  /// Minutos até o SLA de primeira resposta estourar.
  slaPrimeiraRespostaMin Int                @default(15)
  /// Minutos que um lead pode ficar em AGUARDANDO_HUMANO antes do alerta.
  slaEsperaPorGenteMin   Int                @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sdr_ia_config")
}

enum SituacaoDaVersao {
  RASCUNHO
  EM_TESTE
  PUBLICADA
  APOSENTADA
}

/// Uma versão do comportamento do TA. Publicável e reversível.
model SdrIaConfigVersao {
  id       String      @id @default(cuid())
  configId String
  config   SdrIaConfig @relation("VersoesDaConfig", fields: [configId], references: [id], onDelete: Cascade)

  numero   Int
  situacao SituacaoDaVersao @default(RASCUNHO)

  /// Identidade e tom.
  identidade String  @db.Text
  tomDeVoz   String? @db.Text
  objetivos  String? @db.Text

  /// As perguntas de descoberta, na ordem em que o TA deve fazê-las.
  perguntas String[]          @default([])
  /// O que ele NÃO pode responder nem prometer. É a lista que impede promessa
  /// de recurso inexistente — e ela vive na versão porque muda com o produto.
  proibidos String[]          @default([])
  /// Gatilhos de handoff ligados nesta versão.
  gatilhos  MotivoDoHandoff[] @default([])

  /// A régua de score, como JSON: fator → peso. Versionada junto com o resto,
  /// porque mudar peso é mudar comportamento tanto quanto mudar texto.
  reguaDeScore Json?

  notaDaVersao String? @db.Text

  publicadaEm    DateTime?
  publicadaPorId String?
  publicadaPor   InternalUser? @relation("VersaoPublicadaPor", fields: [publicadaPorId], references: [id])

  // ── ⭐ METADADOS DA SUPERVISORA — nível 3 (alteração permanente) ────────────
  //
  // Preenchidos SÓ quando esta versão nasce de uma `SupervisoraSugestaoDePrompt`
  // aprovada por humano (nível 2 → nível 3 do comando). Uma versão criada pela
  // tela de sempre, sem passar pela Supervisora, deixa todos estes campos nulos
  // — e isso é o esperado, não uma omissão: nem toda versão nova é resposta a um
  // defeito medido em conversa.
  //
  // ⛔ Não substituem nada do que já existia: `situacao`, `versaoAtivaId` e o
  // próprio `numero` continuam sendo o mecanismo de publicar e reverter. Estes
  // campos são só o RASTRO de por que esta versão específica nasceu.
  /// A sugestão (nível 2) que esta versão aplica, se houver.
  origemSugestaoId         String?
  /// Quem escreveu o texto que caiu — papel (`recepcao`, `qualificacao`,
  /// `closer`) ou `"todos"` quando o problema não é de um agente específico.
  agenteAfetado            String?
  problemaObservado        String?  @db.Text
  /// Ids de `lead_mensagens` que sustentam a mudança — nunca menos de uma, e a
  /// validação de `nivel 3` (ver `supervisora/prompt.ts`) exige mais de uma
  /// salvo quando `problemaObservado` marca erro grave/risco explicitamente.
  evidencias               String[] @default([])
  trechoAnterior           String?  @db.Text
  trechoNovoProposto       String?  @db.Text
  justificativaDaAlteracao String?  @db.Text
  /// Quem criou ESTE rascunho — pode não ser quem publica depois
  /// (`publicadaPorId`), e a diferença importa para a auditoria.
  criadaPorId              String?
  /// Nome do arquivo/caso de teste que prova esta mudança, para quem revisa não
  /// precisar confiar de boca.
  testeCorrespondente      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ativaEm SdrIaConfig? @relation("VersaoAtiva")

  @@unique([configId, numero])
  @@index([situacao])
  @@index([origemSugestaoId])
  @@map("sdr_ia_config_versoes")
}

// ═══════════════════════════════════════════════════════════════════════════
// A SUPERVISORA — a camada de revisão que acompanha TODOS os agentes
// (humanos e IA) que falam com lead/cliente pelo WhatsApp comercial.
//
// ── O QUE ELA NÃO É ──────────────────────────────────────────────────────────
//
// Não é um segundo verificador: `ta/verificador.ts` já barra preço fora da
// tabela, promessa de prazo, garantia de resultado, integração inventada,
// fechamento em nome do cliente, negar ser agente, placeholder vazado, link
// fora da lista e pedido de telefone repetido — determinístico, sem custo de
// modelo, e roda ANTES desta camada, dentro de `falar()`/`pensar()`. A
// Supervisora cobre o que o regex não alcança: tom, naturalidade, timing do
// pitch, personalização, pressão comercial, interrogatório, insistência depois
// de recusa, mensagens em sequência — o que exige entender a CONVERSA, não só a
// frase.
//
// Não é um segundo handoff: quando decide escalar, aciona `handoff.ts` /
// `responsavel.ts` — os mesmos que já existem. Não é uma segunda memória:
// lê `ta/memoria.ts` (`blocoDeMemoria`, `lerIrritacao`, `lerPedidoDeParar`), não
// duplica.
//
// ── ONDE ELA ENTRA ───────────────────────────────────────────────────────────
//
// UM ponto só, dentro de `entrega.ts` (`entregarMensagem`), porque é o único
// caminho por onde passa toda fala LIVRE que a empresa manda a um lead — IA
// (`ta/atender.ts`), humano digitando (`/api/admin/sala-de-vendas/conversa`) e
// o conector do handoff (`connect/conector/foocci/ligacao.ts`). Isso cobre
// "todos os agentes" com UMA implementação, sem dois caminhos de revisão que
// podem divergir. `abordar.ts` (templates de prospecção aprovados) usa
// `enviarModeloDeVendas`, não `entregarMensagem` — continua fora do alcance
// DESTA função, porque não é fala composta: é template fixo, já aprovado, sem
// tom a revisar. Desde 12/09/2026 `abordar.ts` tem o SEU PRÓPRIO ponto de
// encaixe (`supervisora/adequacaoDoTemplate.ts`), gravando nesta MESMA tabela
// (`SupervisoraAvaliacao`) — ele avalia SE é hora de mandar o template
// (frequência, repetição, opt-out), nunca o conteúdo dele.
// ═══════════════════════════════════════════════════════════════════════════

/// A chave mestra + o modo — separados de propósito, como `SdrIaConfig.ligado`.
///
/// `ligada = false` é o desligamento de emergência: nenhuma chamada acontece,
/// custo e latência zero, igual a `modo = OFF`. `modo` é o que decide o que a
/// Supervisora FAZ enquanto está ligada.
enum ModoDaSupervisora {
  /// Nenhuma chamada à Supervisora. Comportamento de hoje.
  OFF
  /// Roda e GRAVA o veredito. A mensagem sai exatamente como sairia sem a
  /// Supervisora — nunca reescreve, nunca bloqueia. Modo de estreia obrigatório
  /// em produção.
  SHADOW
  /// VERDE libera; AMARELO reescreve antes de entregar; VERMELHO retém;
  /// CRITICO retém E escala para gente.
  GUARD
  /// Tudo de GUARD, mais a capacidade de pausar/assumir uma conversa em
  /// andamento fora do fluxo de uma mensagem específica.
  INTERVENTION
}

enum CamadaDaSupervisora {
  /// Modelo barato, roda em toda mensagem quando a Supervisora está ligada.
  RAPIDA
  /// Modelo mais capaz, só quando um gatilho concreto justifica o custo.
  PROFUNDA
}

enum VeredictoDaSupervisora {
  VERDE
  /// Aprovada com correção — o texto reescrito vem junto.
  AMARELO
  VERMELHO
  /// Igual a VERMELHO e, além disso, aciona escalar para gente.
  CRITICO
}

enum AcaoDaSupervisora {
  NENHUMA
  REESCREVEU
  BLOQUEOU
  BLOQUEOU_E_ESCALOU
}

/// Categorias nomeadas de reprovação da Supervisora — a FASE 3 do pedido
/// original do CEO, tal como descrita ao abrir esta frente: mensagem invasiva,
/// insistência, pitch errado, robótico, promessa incorreta, tom, naturalidade,
/// timing do pitch, personalização, pressão comercial, interrogatório,
/// mensagens em sequência. Cada nome aqui é um desses itens — quem constrói o
/// painel (parte 2) usa estes nomes, não inventa outros.
enum MotivoDaSupervisora {
  MENSAGEM_INVASIVA
  INSISTENCIA_APOS_RECUSA
  PITCH_ERRADO
  TOM_ROBOTICO
  PROMESSA_INCORRETA
  PERSONALIZACAO_FRACA
  PRESSAO_COMERCIAL
  INTERROGATORIO
  SEQUENCIA_DE_MENSAGENS
  TIMING_RUIM
  /// A Supervisora quebrou (modelo fora do ar, erro técnico) — nunca uma
  /// aprovação silenciosa. Ver `supervisora/camadaRapida.ts`.
  FALHA_TECNICA
  OUTRO
}

/// O interruptor único da Supervisora — singleton, como `ProspeccaoConfig`.
model SupervisoraConfig {
  id String @id @default("singleton")

  /// Chave mestra. `false` = comportamento de hoje, sem custo nem latência.
  ligada Boolean           @default(true)
  /// Nunca muda sozinho: só por ação explícita de gestão
  /// (`/api/admin/sala-de-vendas/supervisora`, mesmo padrão de autorização de
  /// `vePelaOperacaoToda`). O código nunca promove SHADOW → GUARD/INTERVENTION.
  modo   ModoDaSupervisora @default(SHADOW)

  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt

  historico SupervisoraModoHistorico[]

  @@map("supervisora_config")
}

/// Toda troca de modo, com quem e por quê — a auditoria que a régua exige.
model SupervisoraModoHistorico {
  id       String            @id @default(cuid())
  configId String            @default("singleton")
  config   SupervisoraConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  modoAnterior ModoDaSupervisora
  modoNovo     ModoDaSupervisora
  alteradoPor  String
  motivo       String?           @db.Text
  alteradoEm   DateTime          @default(now())
  /// `false` = tentativa recusada pela escada de modo (salto de 2+ degraus,
  /// ver `alterarModo` em `config.ts`) — registrada, não escondida. Migração
  /// aditiva `20260913000000_escada_de_modo_obrigatoria`.
  aceita       Boolean           @default(true)

  @@index([configId, alteradoEm])
  @@map("supervisora_modo_historico")
}

/// O veredito da Supervisora sobre UMA mensagem de saída.
///
/// ⭐ Ligada por `mensagemId`, e não por uma coluna nova em `lead_mensagens`:
/// isolar a opinião da Supervisora da mensagem em si é o que permite a tela
/// "isto está retido" ler sem acoplar `LeadMensagem` a um conceito que só
/// existe quando a Supervisora está ligada.
model SupervisoraAvaliacao {
  id         String       @id @default(cuid())
  mensagemId String       @unique
  mensagem   LeadMensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  leadId     String
  lead       SiteLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Cópia do que já está em `LeadMensagem`, de propósito: agregar "por agente"
  /// sem join novo, e sem risco de a agregação mudar de resultado se a mensagem
  /// for reatribuída depois.
  autorMensagem AutorDaMensagem?
  autorUserId   String?
  papelDoAgente String?

  camada        CamadaDaSupervisora
  /// O modo QUE VALIA quando esta avaliação rodou. Em SHADOW o veredito é
  /// gravado e nada muda na entrega — sem este campo, uma auditoria futura não
  /// saberia diferenciar "aprovaria mas era SHADOW" de "aprovou porque só isso".
  modoNaEpoca   ModoDaSupervisora
  veredito      VeredictoDaSupervisora
  motivos       MotivoDaSupervisora[]  @default([])
  motivoDetalhe String?                @db.Text

  /// Guardado só quando difere do que está em `LeadMensagem.texto` hoje (AMARELO
  /// em GUARD/INTERVENTION) ou quando a mensagem foi retida (para a tela mostrar
  /// o que teria saído).
  textoOriginal  String? @db.Text
  textoReescrito String? @db.Text

  /// Verdade operacional para a tela "isto está retido" — não é o mesmo que
  /// `veredito` porque em SHADOW um VERMELHO não bloqueia nada.
  bloqueada        Boolean           @default(false)
  acaoTomada       AcaoDaSupervisora @default(NENHUMA)
  /// A avaliação acionou `passarParaGente`/`pedirHumano`.
  handoffDisparado Boolean           @default(false)
  /// Esta linha nasceu de uma FALHA da Supervisora (modelo fora do ar, erro),
  /// não de um julgamento real. Em GUARD/INTERVENTION isso retém a mensagem;
  /// nunca decide sozinho em SHADOW/OFF.
  falhaTecnica     Boolean           @default(false)

  /// Motor que avaliou — auditoria, nunca segredo (o roteador já garante isso).
  engineProvider String?
  engineModel    String?

  criadaEm DateTime @default(now())

  @@index([leadId, criadaEm])
  @@index([autorUserId, criadaEm])
  @@index([papelDoAgente, criadaEm])
  @@index([veredito, criadaEm])
  @@index([bloqueada])
  @@map("supervisora_avaliacoes")
}

enum AutorDaSugestaoDePrompt {
  SISTEMA
  SUPERVISORA
}

enum SituacaoDaSugestaoDePrompt {
  PENDENTE
  APROVADA
  REJEITADA
  APLICADA
}

/// Nível 2 do comando: sugestão permanente, para REVISÃO humana. Nunca se
/// aplica sozinha — virar nível 3 (`SdrIaConfigVersao` nova) é ato de gente.
model SupervisoraSugestaoDePrompt {
  id String @id @default(cuid())

  /// Papel (`recepcao`, `qualificacao`, `closer`) ou humano nomeado, quando o
  /// problema é de UMA pessoa e não do agente IA.
  agenteAfetadoTipo   AutorDaMensagem?
  agenteAfetadoUserId String?
  papelDoAgente       String?

  problemaObservado    String   @db.Text
  /// Nunca vazio: uma sugestão sem evidência é opinião, não achado.
  evidenciaMensagemIds String[] @default([])
  evidenciaLeadIds     String[] @default([])

  trechoAnterior     String? @db.Text
  trechoNovoProposto String? @db.Text
  justificativa      String  @db.Text

  autor    AutorDaSugestaoDePrompt    @default(SUPERVISORA)
  situacao SituacaoDaSugestaoDePrompt @default(PENDENTE)

  revisadaPorId String?
  revisadaEm    DateTime?
  notaDaRevisao String?   @db.Text

  /// Preenchido quando aprovada e aplicada — a `SdrIaConfigVersao` que nasceu
  /// desta sugestão (nível 3).
  versaoResultanteId String?

  criadaEm  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([situacao, criadaEm])
  @@index([agenteAfetadoUserId])
  @@map("supervisora_sugestoes_prompt")
}

/// Uma sequência de toques programada (cadência).
model Cadencia {
  id     String  @id @default(cuid())
  slug   String  @unique
  nome   String
  ativa  Boolean @default(false)
  /// A quem ela se aplica, em texto — o filtro fino fica no serviço.
  quando String?

  passos CadenciaPasso[]
  em     LeadCadencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cadencias")
}

/// Um passo de cadência: espere N horas, faça isto.
model CadenciaPasso {
  id         String   @id @default(cuid())
  cadenciaId String
  cadencia   Cadencia @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)

  ordem        Int
  /// Horas depois do passo anterior (ou da entrada, no primeiro).
  esperaHoras  Int
  tipo         TipoDeTarefa    @default(FOLLOW_UP)
  /// Quem executa: IA, humano ou sistema.
  executor     AutorDaMensagem @default(HUMANO)
  titulo       String
  /// Template aprovado, quando o passo dispara mensagem fora da janela de 24h.
  templateNome String?
  roteiro      String?         @db.Text

  @@unique([cadenciaId, ordem])
  @@map("cadencia_passos")
}

enum SituacaoDaCadencia {
  ATIVA
  PAUSADA
  CONCLUIDA
  CANCELADA
}

/// A inscrição de um lead numa cadência.
model LeadCadencia {
  id         String   @id @default(cuid())
  leadId     String
  lead       SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cadenciaId String
  cadencia   Cadencia @relation(fields: [cadenciaId], references: [id])

  situacao      SituacaoDaCadencia @default(ATIVA)
  passoAtual    Int                @default(0)
  proximoEm     DateTime?
  /// Por que parou. Cadência que some sem motivo vira lead abandonado.
  motivoDaSaida String?

  tarefas LeadTarefa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, cadenciaId])
  @@index([situacao, proximoEm])
  @@map("lead_cadencias")
}

/// Os quinze critérios do scorecard de vendas (item 13 do comando).
///
/// É enum, e não texto, porque a pergunta que o QA existe para responder é
/// comparativa: *este SDR é pior em objeção do que a média?* Critério em texto
/// livre nunca agrega — cada avaliador escreve "objeções", "objeção" e
/// "tratamento de objeção", e o relatório mostra três colunas de uma coisa só.
enum CriterioDeQA {
  VELOCIDADE // tempo até a primeira resposta
  ABERTURA
  CLAREZA
  ESCUTA // escuta e descoberta
  QUALIFICACAO
  DOR // identificou a dor real
  VALOR // apresentou valor, não recurso
  PERSONALIZACAO
  OBJECOES
  SEGURANCA_DA_INFORMACAO // não afirmou o que não sabe
  EMPATIA
  PROXIMO_PASSO
  FECHAMENTO // tentou fechar
  CONFORMIDADE // script, política, LGPD
  REGISTRO_NO_CRM // deixou a ficha utilizável para o próximo
}

enum OrigemDaAvaliacao {
  AUTOMATICA // gerada por avaliador automático
  HUMANA // um gerente ou auditor avaliou
}

enum SituacaoDaAvaliacao {
  RASCUNHO
  PUBLICADA
  /// O avaliado contestou e o gerente ainda não respondeu. Existe porque
  /// avaliação sem direito de resposta vira ruído que o time aprende a ignorar.
  CONTESTADA
  REVISADA // contestação analisada; a nota pode ter mudado
}

/// A avaliação de qualidade de UMA conversa.
///
/// ── O QUE ESTE MODELO SE RECUSA A FAZER ─────────────────────────────────────
/// Item 13: *"Não avaliar apenas quantidade de mensagens. Avaliar qualidade e
/// capacidade de conversão."* Não há contador de mensagens aqui. Uma conversa de
/// quatro linhas que marcou a demonstração é melhor do que trinta que não foram
/// a lugar nenhum, e um scorecard que contasse volume diria o contrário.
model LeadAvaliacaoQA {
  id     String   @id @default(cuid())
  leadId String
  lead   SiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  origem   OrigemDaAvaliacao   @default(HUMANA)
  situacao SituacaoDaAvaliacao @default(RASCUNHO)

  /// Quem estava atendendo no trecho avaliado — é isto que permite comparar IA
  /// com humano na mesma régua.
  avaliado       AutorDaMensagem
  avaliadoUserId String?
  avaliadoUser   InternalUser?   @relation("QAAvaliado", fields: [avaliadoUserId], references: [id])

  avaliadorId String?
  avaliador   InternalUser? @relation("QAAvaliador", fields: [avaliadorId], references: [id])

  /// Nota final 0–100. `null` enquanto rascunho: nota vazia é honesta, nota
  /// zero seria uma acusação que ninguém fez.
  nota Int?

  /// A etapa do funil no momento da avaliação — desempenho em qualificação e em
  /// negociação não se comparam.
  etapa SiteLeadStage?

  pontosFortes  String? @db.Text
  falhas        String? @db.Text
  oportunidades String? @db.Text
  coaching      String? @db.Text

  /// Sinal de que esta conversa está prestes a ser perdida por conduta, e não
  /// por preço. É o que faz a fila de revisão valer a pena.
  riscoDePerda  Boolean @default(false)
  /// Algo grave: promessa inventada, dado pessoal exposto, desconto fora da
  /// alçada. Alerta crítico interrompe a fila e vai para o gerente na hora.
  alertaCritico Boolean @default(false)

  /// O texto da contestação de quem foi avaliado.
  contestacao       String?   @db.Text
  contestadaEm      DateTime?
  respostaDaRevisao String?   @db.Text
  revisadaEm        DateTime?

  criterios LeadAvaliacaoCriterio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, createdAt])
  @@index([avaliadoUserId, createdAt])
  @@index([situacao, alertaCritico])
  @@index([avaliado, etapa])
  @@map("lead_avaliacoes_qa")
}

/// A nota de UM critério, com a evidência colada.
///
/// ── A EVIDÊNCIA É UMA CHAVE ESTRANGEIRA, NÃO UM TEXTO ───────────────────────
/// Item 13: *"Evidências ligadas às mensagens."* Apontar para a mensagem, e não
/// copiá-la, é o que permite abrir a conversa no ponto exato onde a nota caiu.
/// Uma citação copiada envelhece e não leva a lugar nenhum — e é justamente o
/// que quem foi mal avaliado precisa ver para aceitar a nota.
model LeadAvaliacaoCriterio {
  id          String          @id @default(cuid())
  avaliacaoId String
  avaliacao   LeadAvaliacaoQA @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  criterio   CriterioDeQA
  /// 0 a 5. `null` = **não se aplica a esta conversa**, que é diferente de zero.
  /// Uma conversa que nunca chegou em preço não pode levar nota baixa em
  /// "tentativa de fechamento" — isso puniria o vendedor por seguir o processo.
  nota       Int?
  /// Por que esta nota. Obrigatório em nota baixa, pela regra do serviço.
  comentario String?      @db.Text

  /// A mensagem que sustenta a nota.
  mensagemId String?
  mensagem   LeadMensagem? @relation(fields: [mensagemId], references: [id], onDelete: SetNull)

  @@unique([avaliacaoId, criterio])
  @@index([criterio, nota])
  @@map("lead_avaliacao_criterios")
}

// ═══════════════════════════════════════════════════════════════════════════
// O CONECTOR PADRÃO DO DIOLI CONNECT — o livro de pendências do produto.
//
// ⭐ É a tabela que faz a resposta do gerente achar a conversa certa do cliente.
// Sem ela, `respostaDoGerente` continuaria sendo `null` para sempre: a decisão
// chegaria ao produto e não teria onde pousar.
//
// ⛔ E repare no que NÃO tem aqui: nenhuma coluna de política, de decisão, de
// deliberação. A memória de decisão mora na Control Room, e uma cópia local
// seria a segunda verdade — ela divergiria do núcleo na primeira revogação, e a
// divergência não viraria erro. Aqui só mora a correlação.
//
// ⚠️ É tabela, e não memória de processo, por causa de um corte específico: o
// produto perde conexão com o Connect, o deploy reinicia, e a resposta chega
// depois. Uma pendência em memória some no restart e o cliente vira órfão sem
// ninguém perceber.
// ═══════════════════════════════════════════════════════════════════════════

/// Uma consulta aberta ao Dioli Connect, esperando decisão.
model ConnectPendencia {
  id String @id @default(cuid())

  /// `produto:conversa:sufixo`. Chave de correlação com o núcleo, e única.
  protocolo String @unique
  /// Qual produto. Redundante com o prefixo do protocolo de propósito: é a
  /// coluna que se consulta, e a conferência das duas é o que recusa um
  /// protocolo bem-formado vindo de outro lugar.
  produto   String
  /// A conversa DENTRO do produto. No Foocci, o `SiteLead.id`.
  conversa  String
  /// Qual canal/tela abriu. Ligação local: `sala-de-vendas`.
  canal     String
  /// Qual agente do produto abriu. Ligação local: `ta`.
  agente    String

  /// O fio da conversa interna com o gerente, quando a consulta saiu.
  fio     String?
  assunto String  @db.Text

  /// PENDENTE | RESPONDIDA | ENCERRADA
  estado String @default("PENDENTE")

  /// Quando o cliente foi avisado de que a decisão está pendente. `null` = ele
  /// ainda não sabe, e é isso que `deveAvisar` lê.
  avisadoEm    DateTime?
  respondidaEm DateTime?

  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  /// A busca do retorno é sempre por protocolo (já é `@unique`); estes dois
  /// índices servem à outra pergunta: o que este cliente está esperando.
  @@index([conversa, estado])
  @@index([estado, criadaEm])
  @@map("connect_pendencias")
}

// ─── PROSPECÇÃO (Jornada 3) ──────────────────────────────────────────────────
//
// A lista existente é o ativo mais valioso e o mais fácil de queimar. Estes três
// modelos existem para que abordar alguém seja um ato REGISTRADO, reversível e
// com dono — nunca um disparo anônimo em massa.
//
// A separação entre LOTE e ITEM é deliberada: o lote é a unidade de decisão do
// CEO ("libere estes 20"), o item é a unidade de responsabilidade ("este número
// foi abordado por quem, quando, e o que aconteceu").

enum SituacaoDoLote {
  RASCUNHO // carregado, conferido, e ainda sem autorização para abordar
  LIBERADO // autorizado; os itens podem virar lead e ser abordados
  PAUSADO // travado no meio; nenhum item novo avança até alguém retomar
  ENCERRADO // acabou, por conclusão ou por decisão
}

enum SituacaoDoItem {
  PENDENTE // ainda não virou lead
  VIROU_LEAD // gerou (ou encontrou) um SiteLead, com proveniência preservada
  DUPLICADO // já existia na base; não cria segunda carteira
  RECUSADO // não entra: opt-out anterior, telefone inválido, fora de critério
}

/// O interruptor da prospecção, no banco e não no ambiente.
///
/// A chave `FOOCCI_SDR_SEND_ENABLED` desliga TODO envio, inclusive a resposta a
/// quem escreveu para a gente. Pausar a prospecção é outra decisão: parar de
/// procurar estranhos sem calar o atendimento de quem já está falando conosco.
/// Uma chave só para as duas coisas obrigaria a escolher entre ficar mudo com
/// cliente e continuar abordando gente nova.
model ProspeccaoConfig {
  id String @id @default("singleton")

  /// Falso por padrão: prospecção nasce desligada, e ligar é um ato explícito.
  outboundLigado Boolean @default(false)

  /// Teto por dia para a operação inteira. Zero significa "nada sai".
  limiteDiario Int @default(0)

  /// Intervalo mínimo entre duas abordagens ao MESMO lead.
  horasEntreAbordagens Int @default(72)

  pausadoEm  DateTime?
  pausadoPor String?
  motivo     String?

  /// A conta do WhatsApp (WABA) da Sala Comercial, aprendida do webhook.
  ///
  /// ⚠️ Guardada JUNTO com o número a que ela pertence, e nunca sozinha: um
  /// WABA sem o número que o originou não prova nada, e trocar o número de
  /// vendas sem trocar o WABA faria a casa consultar a conta errada — inclusive
  /// a de um restaurante. As duas colunas andam em par, ou nenhuma vale.
  salaWabaId          String?
  salaWabaPhoneNumber String?
  salaWabaVistoEm     DateTime?

  /// A última vez que a rodada automática das 9h rodou.
  ///
  /// Reserva atômica contra dois agendadores (GitHub cron + agendador interno).
  /// Quem conseguir escrever aqui primeiro neste dia é quem roda.
  ultimaRodadaAutomaticaEm DateTime?

  /// Quem disparou a última rodada automática (agendador, cron).
  ultimaRodadaAutomaticaPor String?

  atualizadoEm  DateTime @updatedAt
  atualizadoPor String?

  @@map("prospeccao_config")
}

/// Um lote de prospecção: a unidade que o CEO libera, pausa e acompanha.
model LoteDeProspeccao {
  id   String @id @default(cuid())
  nome String

  /// De ONDE esta lista veio, em texto de quem carregou. Proveniência sem isto
  /// é só um monte de telefone: no dia da dúvida, é esta frase que responde
  /// "por que temos o contato desta pessoa?".
  proveniencia String

  situacao SituacaoDoLote @default(RASCUNHO)

  /// A importação que originou este lote.
  ///
  /// ⭐ É o campo que transforma "16 lotes de 500" em UMA lista de 8.000 aos
  /// olhos de quem operou. O fracionamento em 500 continua existindo porque é um
  /// limite técnico de conferência; ele deixou de ser uma decisão de negócio
  /// repetida dezesseis vezes.
  importacaoId String?
  importacao   ImportacaoDeLeads? @relation(fields: [importacaoId], references: [id], onDelete: SetNull)

  /// ⚠️ COLUNA APOSENTADA EM 10/09/2026 — mantida, e sem efeito no caminho normal.
  ///
  /// Era o teto de saída POR LOTE, aplicado em `montarFilaDeProspeccao` por cima
  /// do teto global. Com a base contínua ele virou um segundo teto invisível:
  /// uma base unificada de 8.000 contatos, importada em 16 partes com 20 cada,
  /// entregaria 320 por dia — e a tela mostraria o teto global de 2.000 ao lado,
  /// sem ninguém entender por que a fila parava.
  ///
  /// A ordem do Diretor Geral é explícita: se a coluna precisar ficar por
  /// compatibilidade, *"ela não pode reduzir silenciosamente a fila unificada"*.
  /// Ela não reduz mais nada — a seleção não a lê. Não foi apagada porque
  /// apagar coluna é migração destrutiva, e o histórico de quem importou com
  /// que teto continua valendo como registro.
  limiteDiario Int @default(20)

  criadoPor         String?
  criadoEm          DateTime  @default(now())
  liberadoEm        DateTime?
  /// ⚠️ RÓTULO DE TELA, no formato `Nome (userId)`. NÃO é um id.
  /// Ele é renderizado como "Liberado por …" no painel, e foi entregue por
  /// engano a `LeadMensagem.autorUserId` — que tem chave estrangeira para
  /// `internal_users`. Resultado, em produção, 08/09/2026: a primeira rodada
  /// real derrubou com `Foreign key constraint violated`. Para responsabilizar
  /// alguém, use `liberadoPorUserId`.
  ///
  /// ⚠️ Este comentário dizia `users`, e eu o escrevi sem conferir. O erro não
  /// ficou no comentário: a migração seguinte casou o id contra `users` porque
  /// foi isto que ela leu, e não casou nada. Afirmação de manual sem medição
  /// não fica parada — ela é obedecida.
  liberadoPor       String?
  /// Quem autorizou, como ID de verdade. É este que vai para `autorUserId` da
  /// mensagem — a promessa de que "toda mensagem que sai em nome da empresa tem
  /// um responsável" só se cumpre com um id que o banco reconheça.
  liberadoPorUserId String?
  pausadoEm         DateTime?
  pausadoPor        String?
  encerradoEm       DateTime?

  itens ItemDeProspeccao[]

  @@index([situacao, criadoEm])
  @@map("lotes_de_prospeccao")
}

/// Uma linha da lista. Vira lead uma única vez, e guarda por que não virou.
model ItemDeProspeccao {
  id     String           @id @default(cuid())
  loteId String
  lote   LoteDeProspeccao @relation(fields: [loteId], references: [id], onDelete: Cascade)

  nome     String?
  whatsapp String

  /// Só dígitos, no mesmo formato do `SiteLead.whatsappDigits` — é por este
  /// campo que a duplicidade é detectada antes de criar carteira nova.
  whatsappDigits String

  empresa String?
  cidade  String?
  estado  String?
  tipo    String?

  // ── ⭐ AMPLIAÇÃO DA BASE FRIA, 11/09/2026 ──────────────────────────────────
  //
  // A prospecção B2B consultiva não se qualifica só com nome, telefone e
  // cidade. Estes catorze campos são o que faltava para o contato frio virar
  // uma FICHA, não uma linha — e são todos aditivos: nenhuma coluna anterior
  // mudou de nome, tipo ou significado. Reaproveitam-se `nome` (responsável),
  // `empresa` (restaurante) e `tipo` (tipo de restaurante) já existentes.
  /// E-mail do contato, quando a planilha traz.
  email              String?
  /// Cargo ou função de quem responde — "responsável" nem sempre é o dono.
  cargo              String?
  /// Um segundo telefone (fixo, ou outro celular), separado do WhatsApp
  /// principal — que continua sendo `whatsapp`/`whatsappDigits`.
  telefoneSecundario String?
  bairro             String?
  endereco           String?
  cep                String?
  cnpj               String?
  instagram          String?
  site               String?
  /// O link do Google Maps do estabelecimento — não o texto do endereço.
  googleMapsUrl      String?
  /// Quantas casas/unidades a empresa tem. Mesmo conceito de
  /// `LeadQualificacao.unidades`; migra para lá quando o contato vira lead.
  numeroDeUnidades   Int?
  /// Onde ele já vende hoje (iFood, Rappi, WhatsApp, salão…). Mesmo conceito
  /// de `LeadQualificacao.canaisAtuais`; migra para lá quando vira lead.
  canaisAtuais       String[] @default([])
  /// Texto livre de quem importou ou enriqueceu. Migra para
  /// `LeadQualificacao.observacoes` quando o contato vira lead.
  observacoes        String?  @db.Text
  /// Etiquetas livres, do mesmo tipo de `SiteLead.tags` — migra para lá.
  tags               String[] @default([])

  situacao SituacaoDoItem @default(PENDENTE)

  /// Preenchido quando o item vira (ou encontra) um lead.
  leadId String?

  motivo String?

  criadoEm     DateTime  @default(now())
  processadoEm DateTime?

  /// O mesmo telefone não entra duas vezes no mesmo lote.
  @@unique([loteId, whatsappDigits])
  @@index([situacao])
  @@index([whatsappDigits])
  @@map("itens_de_prospeccao")
}

/// Em que pé está o processamento de uma importação.
enum SituacaoDaImportacao {
  PROCESSANDO // as partes ainda estão entrando
  CONCLUIDA // todas as partes entraram
  FALHOU // parou no meio, e `erroTecnico` diz por quê
  CANCELADA // alguém desfez; os lotes vão junto
}

/// ⭐ UMA IMPORTAÇÃO — o arquivo inteiro, e a resposta a "por que temos isto?".
///
/// ── O QUE ELA RESPONDE, E O QUE NÃO EXISTIA ────────────────────────────────
///
/// Antes de 10/09/2026 a casa sabia que um lead veio de `LISTA_PROSPECCAO` e
/// sabia a `proveniencia` escrita à mão no lote. Não sabia de QUAL arquivo, com
/// que nome, com quantas linhas, quantas recusadas e por quê, nem quem
/// exatamente subiu — `criadoPor` era texto livre.
///
/// No dia em que alguém perguntar "de onde vocês tiraram o meu telefone?", a
/// resposta precisa caber numa frase e ter lastro. É este registro.
///
/// ⚠️ **`criadoPor` continua existindo e continua sendo texto.** Não foi
/// substituído: rótulo antigo apagado é histórico apagado. O que entrou ao lado
/// dele é `criadoPorUserId`, um id que o banco reconhece — a mesma lição que
/// derrubou a primeira rodada real em 08/09, quando um rótulo de tela foi
/// entregue a uma coluna com chave estrangeira.
model ImportacaoDeLeads {
  id String @id @default(cuid())

  /// O nome do arquivo como ele estava na máquina de quem subiu.
  arquivoNome  String
  arquivoTipo  String?
  /// Impressão digital do conteúdo. É ela que reconhece a MESMA planilha subindo
  /// de novo com outro nome — o caso que mais gera contato duplicado.
  arquivoHash  String?
  arquivoBytes Int?

  linhasTotais        Int @default(0)
  linhasAceitas       Int @default(0)
  novos               Int @default(0)
  duplicadosNoArquivo Int @default(0)
  duplicadosEmOutras  Int @default(0)
  jaEramLeads         Int @default(0)
  telefonesInvalidos  Int @default(0)
  linhasRecusadas     Int @default(0)

  /// Por motivo, quantas. `{"Telefone com formato improvável": 12}`.
  motivosDeRecusa Json?

  /// Por que a empresa possui estes contatos. É a base legal declarada.
  proveniencia    String
  /// Quem ou o que obteve a lista (busca no Google, feira, indicação, parceiro).
  canalDeObtencao String?

  /// Rótulo de tela de quem subiu. Texto, e legado — ver o aviso do modelo.
  criadoPor       String?
  /// O id de verdade. É por ele que se responsabiliza alguém.
  criadoPorUserId String?
  criadoPorNome   String?

  /// Qual leitura de colunas foi usada. Muda quando o parser muda, e é o que
  /// explica duas importações do mesmo arquivo darem números diferentes.
  versaoDoMapeamento String @default("v1")

  situacao    SituacaoDaImportacao @default(PROCESSANDO)
  erroTecnico String?

  iniciadaEm  DateTime  @default(now())
  concluidaEm DateTime?

  canceladaEm          DateTime?
  canceladaPor         String?
  canceladaPorUserId   String?
  motivoDoCancelamento String?

  lotes LoteDeProspeccao[]

  @@index([situacao, iniciadaEm])
  @@index([arquivoHash])
  @@map("importacoes_de_leads")
}

/// Um modelo aprovado da Meta **da Sala Comercial** — sincronizado, não digitado.
///
/// ── POR QUE NÃO É `MetaMessageTemplate` ────────────────────────────────────
///
/// `MetaMessageTemplate` tem `restaurantId` com cascade para `Restaurant`. Pôr
/// o modelo da Foocci lá exigiria inventar um restaurante-fantasma para a
/// própria Foocci — e a ordem é explícita: *"nunca misturar contatos, conversas,
/// templates, números ou campanhas de tenants diferentes"*. Tabela separada AQUI
/// é o isolamento, não a duplicação.
///
/// ── O QUE ELE ACABA ────────────────────────────────────────────────────────
///
/// `FOOCCI_SDR_MODELO_VARIAVEIS`: uma variável de ambiente onde uma pessoa
/// digitava, à mão, quantos `{{n}}` o modelo aprovado tem. A Meta sabe esse
/// número e responde por API. Pedir a um humano que copie um dado que a API
/// entrega é criar uma segunda verdade que só diverge.
model ModeloDeVendas {
  id String @id @default(cuid())

  /// O `phone_number_id` da Sala a que este modelo pertence. Guardado junto com
  /// o WABA pelo mesmo motivo de `ProspeccaoConfig`: um sem o outro não prova de
  /// qual conta o modelo veio.
  phoneNumberId String
  wabaId        String

  nome      String
  idioma    String
  /// MARKETING, UTILITY, AUTHENTICATION — como a Meta classifica.
  categoria String?
  /// APPROVED, PENDING, REJECTED, DISABLED, PAUSED.
  situacao  String

  /// ⭐ Quantos `{{n}}` o corpo tem, contado do que a Meta devolveu.
  variaveis Int @default(0)

  metaTemplateId String?
  motivoDaRecusa String?
  /// O corpo aprovado, para a tela mostrar o que o lead vai receber.
  corpo          String?

  sincronizadoEm DateTime @default(now())

  @@unique([phoneNumberId, nome, idioma])
  @@index([situacao])
  @@map("modelos_de_vendas")
}
